---

<section class="ponte" aria-labelledby="ponte-titulo">
  <div class="limite">
    <h2 id="ponte-titulo" class="so-leitor">As ferramentas que você vai usar</h2>
    <p class="so-leitor">No lugar de CapCut, Premiere e After Effects:</p>
    <ul class="ponte__antigas" role="list" aria-hidden="true">
      {antigas.map((a, i) => (
        <li class="antiga" style={`--atraso:${0.2 + i * 0.15}s`}>
          <svg class="antiga__logo" viewBox={a.vb} aria-hidden="true" focusable="false" set:html={a.svg} />
          <span class="antiga__nome">{a.nome}</span>
        </li>
      ))}
    </ul>
    <span class="ponte__seta" aria-hidden="true"></span>
    <ul class="ponte__lista" role="list">
      {
        ferramentas.map((f, i) => (
          <>
            <li class="ia" style={`--marca:${f.cor}; --atraso:${i * -1.3}s`}>
              <span class="ia__icone">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={f.path} />
                </svg>
              </span>
              <span class="ia__nome">{f.nome}</span>
            </li>
          </>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ponte {
    padding-block: clamp(20px, 3vw, 32px);
  }

  /* As antigas: pequenas, apagadas, riscadas. O risco passa na chegada. */
  .ponte__antigas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e-8) var(--e-12);
  }

  .antiga {
    display: inline-flex;
    align-items: center;
    gap: var(--e-8);
    padding: 8px 16px 8px 10px;
    border-radius: var(--raio-pilula);
    box-shadow: inset 0 0 0 1px var(--linha);
    color: var(--apoio);
    font-size: var(--t-corpo-sm);
    opacity: 0.5;
    filter: grayscale(1);
  }

  .antiga__logo {
    width: 32px;
    height: 32px;
    flex: none;
    color: var(--tinta-suave);
  }

  .antiga__nome {
    position: relative;
  }

  .antiga__nome::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    top: 52%;
    height: 1.5px;
    background: var(--tinta-suave);
    transform-origin: left;
  }

  /* A passagem: um fio que desce das antigas e acende nas novas. */
  .ponte__seta {
    display: block;
    width: 1px;
    height: 28px;
    margin: var(--e-8) auto var(--e-12);
    background: linear-gradient(to bottom, transparent, var(--menta));
  }

  .ponte__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--e-16) var(--e-24);
  }

  .ia {
    display: inline-flex;
    align-items: center;
    gap: var(--e-12);
    padding: 10px 18px 10px 10px;
    border-radius: var(--raio-pilula);
    background: var(--superficie);
    box-shadow: inset 0 0 0 1px var(--linha);
    transition:
      box-shadow var(--micro) var(--curva),
      transform var(--micro) var(--curva);
  }

  .ia:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--marca) 55%, transparent),
      0 10px 30px -14px color-mix(in srgb, var(--marca) 60%, transparent);
  }

  .ia__icone {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--raio-pilula);
    background: color-mix(in srgb, var(--marca) 14%, transparent);
  }

  .ia__icone svg {
    width: 20px;
    height: 20px;
    fill: var(--marca);
  }

  .ia__nome {
    font-weight: var(--peso-medio);
    color: var(--tinta);
    white-space: nowrap;
  }

  /* As três flutuam devagar, fora de compasso, como peças na mesa. */
  @media (prefers-reduced-motion: no-preference) {
    .ia {
      animation: flutua 4s ease-in-out infinite;
      animation-delay: var(--atraso);
    }
    .ia__icone svg {
      animation: gira-leve 8s ease-in-out infinite;
      animation-delay: var(--atraso);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .antiga__nome::after {
      animation: risca 0.6s var(--curva) both;
      animation-delay: var(--atraso);
    }
  }

  @keyframes risca {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes flutua {
    50% {
      translate: 0 -8px;
    }
  }

  @keyframes gira-leve {
    25% {
      rotate: -8deg;
    }
    75% {
      rotate: 8deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ia:hover {
      transform: none;
    }
  }
</style>
