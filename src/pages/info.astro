---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Ferramentas from '../components/Ferramentas.astro';
import Player from '../components/Player.astro';
import BotaoAssinar from '../components/BotaoAssinar.astro';
import { modulos, demo } from '../data/hub.js';

const titulo = 'VKOSHUB | Crie e edite vídeos como um profissional com IA';
const descricao =
  'O VKOSHUB ensina você a usar o Claude pra editar reels, montar vídeo longo pro YouTube, criar anúncio em motion e animar em 3D no Blender. Plano anual no preço fundador. Garantia de 7 dias.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'VKOSHUB',
  description: descricao,
  brand: { '@type': 'Brand', name: 'OJESSEGOMES' },
  offers: {
    '@type': 'Offer',
    price: '97.00',
    priceCurrency: 'BRL',
    url: new URL('/assinar', Astro.site).href,
  },
};


const faq = [
  {
    p: 'Preciso saber editar vídeo?',
    r: 'Não. Os módulos partem do zero e o Claude faz a parte técnica. Você aprende a dar a instrução certa e a revisar o resultado.',
  },
  {
    p: 'Preciso saber Blender?',
    r: 'Não. O módulo 4 foi pensado pra quem nunca abriu o programa. O Claude escreve o que o Blender precisa e você dirige a cena.',
  },
  {
    p: 'Funciona no celular?',
    r: 'As aulas abrem no celular. A edição com Claude, o motion e o Blender pedem computador.',
  },
  {
    p: 'Como recebo o acesso?',
    r: 'Depois do pagamento na Cakto, o acesso às aulas é liberado na própria Cakto, no email que você usou na compra.',
  },
  {
    p: 'O que entra de novo durante o meu ano?',
    r: 'O Hub é atualizado constantemente com aulas, recursos, modelos, projetos e métodos. O que entrar durante o seu período de acesso fica disponível pra você.',
  },
  {
    p: 'As ferramentas em construção estão incluídas?',
    r: 'Elas ainda estão sendo construídas. Quando ficarem prontas, entram no Hub sem custo pra quem é membro fundador. Dá pra acompanhar a construção no Instagram.',
  },
  {
    p: 'E se eu não gostar?',
    r: 'Você tem 7 dias de garantia. Pediu dentro do prazo, recebe o dinheiro de volta.',
  },
];
---

{/* Cópia da página principal. Fica fora do Google pra não competir com a home. */}
<Base titulo={titulo} descricao={descricao} privada>
  <Cabecalho />

  <main id="conteudo">
    {/* 01. Hero */}
    <section class="hero" aria-labelledby="hero-titulo">
      <div class="hero__luz" aria-hidden="true"></div>
      <div class="limite">
        <div class="hero__corpo">
          <div class="hero__texto">
            <h1 id="hero-titulo" class="hero__titulo">
              Crie e edite vídeos como um profissional <span class="hero__sozinho">com IA.<svg class="hero__risco" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 16 C 50 6, 120 4, 196 12" /></svg></span>
            </h1>
            <p class="hero__sub">
              Use o Claude &amp; ChatGPT pra editar reels, montar vídeos para o YouTube, criar anúncio
              em motion e animar em 3D no Blender. Aulas, prompts e skills prontos pra aplicar hoje,
              num hub que atualiza semanalmente.
            </p>
          </div>

          {demo.mp4 && (
            <div class="demo" data-carrossel>
              {[
                { src: demo.mp4, poster: demo.poster },
                { src: '/estilos/motion-marcai.mp4', poster: '/estilos/motion-marcai.webp' },
                { src: '/estilos/3d-02.mp4', poster: '/estilos/3d-02.webp' },
              ].map((v, i) => (
                <video
                  class="demo__item"
                  data-pos={i}
                  src={v.src}
                  poster={v.poster}
                  muted
                  loop
                  playsinline
                  preload={i === 0 ? 'auto' : 'metadata'}
                  autoplay={i === 0}
                  aria-hidden="true"
                ></video>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    {/* Ponte: as ferramentas que a pessoa vai usar. */}
    <Ferramentas />

    {/* 04. Os 5 módulos */}
    <section class="secao modulos" id="modulos" aria-labelledby="modulos-titulo">
      <div class="limite">
        <h2 id="modulos-titulo" class="modulos__titulo reveal">
          Cinco tipos de vídeo que colocam o seu negócio <span class="destaque">na frente de mais gente.</span>
        </h2>

        <div class="trilhas reveal">
          <span class="rotulo">Edição com IA</span>
          <span class="trilhas__mais" aria-hidden="true">+</span>
          <span class="so-leitor">e</span>
          <span class="rotulo">Criação com IA</span>
        </div>

        <div class="estilos">
          {modulos.filter((m) => m.exemplos.length > 0).map((m) => (
            <article class="estilo" aria-labelledby={`estilo-${m.n}`}>
              <header class="estilo__cabeca reveal">
                <p class="estilo__trilha mono">{m.trilha}</p>
                <h3 id={`estilo-${m.n}`} class="estilo__nome">
                  {m.estilo}
                  {m.breve && <span class="estilo__breve mono">Em breve</span>}
                </h3>
                <p class="estilo__texto">{m.texto}</p>
              </header>
              {/* Os deitados em cima, ocupando a largura; os em pé numa fileira embaixo. */}
              <div class="estilo__galeria reveal" role="group" aria-label={`Exemplos de ${m.estilo}`}>
                {[m.exemplos.filter((e) => e.deitado), m.exemplos.filter((e) => !e.deitado)].map((fila, f) =>
                  fila.length > 0 && (
                    <ul class:list={['fila', f === 0 ? 'fila--deitada' : 'fila--em-pe']} role="list">
                      {fila.map((e) => (
                        <li class:list={['exemplo', e.deitado ? 'exemplo--deitado' : 'exemplo--em-pe']}>
                          <Player src={e.src} poster={e.poster} rotulo={`${m.estilo}, exemplo ${m.exemplos.indexOf(e) + 1}`} preload="none" />
                        </li>
                      ))}
                    </ul>
                  )
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* 06. Em construção */}
    <section class="secao obra" aria-labelledby="obra-titulo">
      <div class="obra__planta" aria-hidden="true"></div>
      <div class="limite">
        <h2 id="obra-titulo" class="obra__titulo reveal">
          Sendo preparado para entrar no <span class="destaque">VKOSHUB</span>:
        </h2>
        <p class="obra__sub reveal">
          Quando ficarem prontos, entram no Hub <strong>sem custo</strong> para os
          <strong>membros fundadores</strong>.
        </p>

        <ul class="obra__lista" role="list">
          <li class="ferramenta reveal">
            <div class="ferramenta__palco" aria-hidden="true">
              <div class="tela tela--print">
                <div class="tela__barra"><i></i><i></i><i></i><span class="mono">máquina de conteúdo</span></div>
                <img src="/obra/maquina.webp" alt="" width="790" height="430" loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="ferramenta__corpo">
              <div class="status">
                <span class="status__ponto"></span>
                <span class="status__texto mono">em construção</span>
                <span class="status__trilho"><i></i></span>
              </div>
              <h3 class="ferramenta__nome">Máquina de conteúdo<span class="so-leitor">:</span></h3>
              <p class="ferramenta__texto">um editor de IA que gera cortes e timelines editáveis com o Claude.</p>
            </div>
          </li>

          <li class="ferramenta reveal" style="--atraso:0.1s">
            <div class="ferramenta__palco" aria-hidden="true">
              <div class="tela tela--3d">
                <div class="tela__barra"><i></i><i></i><i></i><span class="mono">cena.blend</span></div>
                <div class="blender">
                  <div class="blender__vista">
                    <svg class="montagem" viewBox="0 0 160 130" focusable="false">
                      <ellipse class="montagem__chao" cx="80" cy="112" rx="58" ry="12" />
                      <g class="montagem__plano">
                        <path d="M80 18 L115 38 L80 58 L45 38 Z M45 38 L45 78 L80 98 L115 78 L115 38 M80 58 L80 98" />
                      </g>
                      <path class="montagem__aresta" style="--i:0" d="M45 78 L80 98" />
                      <path class="montagem__aresta" style="--i:1" d="M80 98 L115 78" />
                      <path class="montagem__aresta" style="--i:2" d="M45 38 L45 78" />
                      <path class="montagem__aresta" style="--i:3" d="M80 58 L80 98" />
                      <path class="montagem__aresta" style="--i:4" d="M115 38 L115 78" />
                      <path class="montagem__aresta" style="--i:5" d="M45 38 L80 58" />
                      <path class="montagem__aresta" style="--i:6" d="M80 58 L115 38" />
                      <path class="montagem__aresta" style="--i:7" d="M45 38 L80 18" />
                      <path class="montagem__aresta" style="--i:8" d="M80 18 L115 38" />
                      <circle class="montagem__no montagem__no--vivo" cx="115" cy="38" r="3.5" />
                    </svg>
                    <span class="blender__fala mono">cena 2: a câmera gira em volta</span>
                  </div>
                  <ol class="roteiro">
                    <li><span class="roteiro__quadro"></span><span class="mono">1 · entra</span></li>
                    <li class="roteiro__viva"><span class="roteiro__quadro"></span><span class="mono">2 · gira</span></li>
                    <li><span class="roteiro__quadro"></span><span class="mono">3 · close</span></li>
                    <li><span class="roteiro__quadro"></span><span class="mono">4 · logo</span></li>
                  </ol>
                </div>
              </div>
            </div>
            <div class="ferramenta__corpo">
              <div class="status">
                <span class="status__ponto"></span>
                <span class="status__texto mono">em construção</span>
                <span class="status__trilho"><i></i></span>
              </div>
              <h3 class="ferramenta__nome">Produção 3D no Blender<span class="so-leitor">:</span></h3>
              <p class="ferramenta__texto">uma ferramenta pra produzir 3D no Blender com Claude e Codex.</p>
            </div>
          </li>

          <li class="ferramenta reveal" style="--atraso:0.2s">
            <div class="ferramenta__palco" aria-hidden="true">
              <div class="ganho">
                <div class="ganho__card">
                  <span class="ganho__selo">Recebido</span>
                  <span class="ganho__de">GOOGLE LLC</span>
                  <span class="ganho__valor">USD 194,37</span>
                </div>
                <div class="ganho__prox">
                  <span class="ganho__rotulo">Próximo pagamento</span>
                  <span class="ganho__valor ganho__valor--sm">US$ 91,55</span>
                  <span class="ganho__trilho"><i></i></span>
                  <span class="ganho__rotulo">Pagamento mínimo: US$ 100,00</span>
                </div>
              </div>
            </div>
            <div class="ferramenta__corpo">
              <div class="status">
                <span class="status__ponto"></span>
                <span class="status__texto mono">em construção</span>
                <span class="status__trilho"><i></i></span>
              </div>
              <h3 class="ferramenta__nome">Como monetizar e automatizar a produção de conteúdo<span class="so-leitor">:</span></h3>
              <p class="ferramenta__texto">ganhar com o que você produz, monetizando nas plataformas e vendendo vídeo pra outros negócios, com a produção rodando no automático.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    {/* 08. A oferta + 09. Garantia: a cena do preço, num card só */}
    <section class="secao oferta" id="oferta" aria-labelledby="oferta-titulo">
      <div class="limite">
        <article class="palco reveal reveal--escala">
          <header class="palco__cabeca">
            <p class="palco__selo mono">preço fundador</p>
            <p class="palco__marca" aria-hidden="true"><img class="palco__logo" src="/logo.png" alt="" width="64" height="64" /><span>VKOS<span class="palco__hub">HUB</span></span></p>
            <h2 id="oferta-titulo" class="so-leitor">Plano anual no preço fundador: R$97.</h2>
          </header>

          <div class="palco__pacote">
            <ul class="pacote" role="list">
              {modulos.map((m) => (
                <li>
                  {m.titulo}
                  {m.breve && <span class="selo-pacote selo-pacote--breve">Em breve</span>}
                </li>
              ))}
              <li>
                <span>
                  <strong class="pacote__fundador">Bônus de fundador:</strong> prompts e skills, mais os modelos,
                  projetos e métodos que entrarem no Hub
                </span>
                <span class="selo-pacote selo-pacote--preco">
                  <s>R$47</s>
                  <span class="so-leitor">, de graça pra quem entra agora</span>
                </span>
              </li>
            </ul>
          </div>

          <div class="palco__valor-bloco">
            <p class="palco__porque">
              O VKOSHUB está apenas no início e por isso o preço é promocional. Conforme o Hub ganha módulos,
              recursos e ferramentas, o valor do plano anual sobe.
            </p>

            <p class="palco__numero">
              <span class="palco__moeda" aria-hidden="true">R$</span><span class="palco__valor" aria-hidden="true">97</span><span class="palco__lado"><span class="palco__centavos" aria-hidden="true">,00</span><span class="palco__mes">menos de<br />R$11 por mês</span></span>
            </p>

            <div class="palco__cta">
              <BotaoAssinar grande />
              <p class="cta__nota">Ferramentas de IA contratadas à parte.</p>
            </div>
          </div>

          <footer class="garantia">
            <svg class="garantia__selo" viewBox="0 0 160 160" aria-hidden="true" focusable="false">
              <defs>
                <path id="garantia-volta" d="M80 80 m -60 0 a 60 60 0 1 1 120 0 a 60 60 0 1 1 -120 0" />
              </defs>
              <circle cx="80" cy="80" r="76" class="garantia__borda" />
              <g class="garantia__giro">
                <text class="garantia__volta">
                  <textPath href="#garantia-volta" textLength="372" lengthAdjust="spacing">7 dias de garantia • 7 dias de garantia •</textPath>
                </text>
              </g>
              <circle cx="80" cy="80" r="46" class="garantia__disco" />
              <text x="80" y="92" text-anchor="middle" class="garantia__n">7</text>
              <text x="80" y="110" text-anchor="middle" class="garantia__d">DIAS</text>
            </svg>
            <div>
              <h3 id="garantia-titulo" class="garantia__titulo">7 dias pra testar. Se não te servir, seu dinheiro de volta.</h3>
            </div>
          </footer>
        </article>
      </div>
    </section>

    {/* 10. Perguntas frequentes */}
    <section class="secao faq" id="perguntas" aria-labelledby="faq-titulo">
      <div class="limite faq__grade">
        <h2 id="faq-titulo" class="faq__titulo reveal">Perguntas frequentes</h2>
        <div class="faq__lista reveal">
          {
            faq.map((item) => (
              <details class="faq__item">
                <summary>
                  <span>{item.p}</span>
                  <span class="faq__sinal" aria-hidden="true" />
                </summary>
                <p>{item.r}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Rodape />
</Base>

<script>
  // O leque da hero: troca de vídeo a cada 10 s. Para enquanto o mouse está em
  // cima, e fica parado de vez pra quem pede menos movimento.
  const leque = document.querySelector<HTMLElement>('[data-carrossel]');
  if (leque) {
    const videos = [...leque.querySelectorAll<HTMLVideoElement>('video')];
    const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let parado = false;

    if (reduz) {
      videos.forEach((v) => v.pause());
    } else {
      leque.addEventListener('mouseenter', () => (parado = true));
      leque.addEventListener('mouseleave', () => (parado = false));
      setInterval(() => {
        if (parado || document.hidden) return;
        videos.forEach((v) => {
          const pos = (Number(v.dataset.pos) + videos.length - 1) % videos.length;
          v.dataset.pos = String(pos);
          if (pos === 0) {
            v.currentTime = 0;
            void v.play();
          } else {
            v.pause();
          }
        });
      }, 10000);
    }
  }
</script>

<style>
  /* A menta como ênfase de palavra: cor sólida, nunca gradiente no texto.
     Cada título de decisão ganha UMA frase acesa, a que a pessoa leva. */
  .destaque {
    color: var(--menta);
  }

  /* ---------- 01. Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(40px, 8vw, 96px);
    padding-bottom: var(--gap-secao);
    overflow: hidden;
  }

  /* A luz do topo: duas manchas de menta atrás do título e do vídeo.
     É o que tira a página do preto chapado sem trazer cor nova. */
  .hero__luz {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(40% 55% at 76% 42%, var(--menta-brilho), transparent 70%),
      radial-gradient(30% 34% at 12% 30%, var(--menta-veu), transparent 72%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__luz {
      animation: respira 9s ease-in-out infinite alternate;
    }
  }

  @keyframes respira {
    from {
      opacity: 0.75;
      transform: translate3d(0, 0, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(-2%, 2%, 0);
    }
  }

  .hero__titulo {
    font-size: clamp(2.25rem, 4.4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    max-width: 21ch;
    text-wrap: balance;
  }

  /* No celular o título manda: maior e no meio da tela. */
  @media (max-width: 760px) {
    .hero__titulo {
      font-size: clamp(2.5rem, 11.5vw, 3.5rem);
      margin-inline: auto;
      text-align: center;
    }
  }

  /* "Sozinho." com o risco de caneta embaixo, desenhado na chegada. */
  .hero__sozinho {
    position: relative;
    display: inline-block;
    color: var(--menta);
    white-space: nowrap;
  }

  .hero__risco {
    position: absolute;
    left: -2%;
    bottom: -0.2em;
    width: 104%;
    height: 0.28em;
    overflow: visible;
  }

  .hero__risco path {
    fill: none;
    stroke: var(--menta);
    stroke-width: 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 220;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__risco path {
      animation: risca 1.1s 0.5s var(--curva) both;
    }
  }

  @keyframes risca {
    from {
      stroke-dashoffset: 220;
    }
  }

  .hero__corpo {
    display: grid;
    gap: var(--e-64);
    align-items: center;
  }

  @media (min-width: 1000px) {
    .hero__corpo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--e-48);
    }
  }

  .hero__sub {
    margin-top: var(--e-40);
    font-size: var(--t-corpo-lg);
    line-height: 1.65;
    color: var(--tinta-suave);
    max-width: 46ch;
  }

  /* ---------- Demonstração ---------- */
  /* O vídeo fica do mesmo tamanho. Atrás dele, dois quadros em leque,
     como uma pilha de reels: dá volume e movimento sem crescer a peça. */
  .demo {
    position: relative;
    justify-self: center;
    /* Nunca mais alto que 52% da tela: o vídeo acompanha o título, não engole a hero.
       A medida mora aqui pra os quadros de trás terem exatamente o tamanho dele. */
    width: min(100%, 240px, calc(52svh * 9 / 16));
  }

  /* Três vídeos de verdade em leque. A cada 10 segundos o da direita vem pra
     frente e começa a tocar; o que estava na frente pausa e vai pra trás. */
  .demo {
    aspect-ratio: 9 / 16;
  }

  .demo__item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--raio-card);
    background: var(--carvao);
    box-shadow:
      0 0 0 1px var(--linha-forte),
      0 20px 40px -20px rgba(0, 0, 0, 0.9);
    transition:
      transform 0.7s var(--curva),
      filter 0.7s var(--curva),
      box-shadow 0.7s var(--curva);
  }

  .demo__item[data-pos='0'] {
    z-index: 3;
    box-shadow:
      0 0 0 1px var(--menta-linha),
      0 30px 70px -30px color-mix(in srgb, var(--menta) 45%, transparent),
      0 20px 40px -20px rgba(0, 0, 0, 0.9);
  }

  .demo__item[data-pos='1'] {
    z-index: 2;
    transform: rotate(8deg) translate(30%, 4%) scale(0.86);
    filter: brightness(0.5) saturate(0.9);
  }

  .demo__item[data-pos='2'] {
    z-index: 1;
    transform: rotate(-8deg) translate(-30%, 5%) scale(0.86);
    filter: brightness(0.5) saturate(0.9);
  }

  /* ---------- 04. Módulos ---------- */
  .modulos__titulo {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.03em;
    max-width: 32ch;
    margin-inline: auto;
    text-align: center;
    margin-bottom: var(--e-20);
  }

  /* As duas trilhas, lado a lado, logo abaixo do título. */
  .trilhas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--e-12);
    margin: 0 auto clamp(32px, 5vw, 56px);
  }

  .trilhas .rotulo {
    padding: 6px 14px;
    border-radius: var(--raio-pilula);
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: var(--t-corpo-sm);
  }

  .trilhas__mais {
    color: var(--menta);
    font-family: var(--fonte-mono);
    font-size: var(--t-corpo);
  }

  /* ---------- os estilos de vídeo, um bloco por estilo ---------- */
  .estilos {
    display: grid;
  }

  .estilo {
    display: grid;
    gap: var(--e-24);
    padding-block: clamp(40px, 6vw, 72px);
    border-top: 1px solid var(--linha);
  }

  .estilo:first-child {
    border-top: 0;
    padding-top: var(--e-24);
  }

  @media (min-width: 960px) {
    .estilo {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(32px, 5vw, 64px);
      align-items: start;
    }

    /* O texto acompanha a rolagem enquanto os vídeos passam. */
    .estilo__cabeca {
      position: sticky;
      top: calc(var(--altura-barra) + var(--e-32));
    }
  }

  .estilo__cabeca {
    display: grid;
    gap: var(--e-12);
    align-content: start;
  }

  .estilo__trilha {
    margin: 0;
    font-size: var(--t-legenda);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--menta);
  }

  .estilo__nome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-8) var(--e-12);
    font-size: var(--t-titulo-lg);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--tinta);
  }

  .estilo__breve {
    padding: 3px 10px;
    border-radius: var(--raio-pilula);
    box-shadow: inset 0 0 0 1px var(--linha-forte);
    color: var(--apoio);
    font-size: var(--t-legenda);
    font-weight: var(--peso-normal);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .estilo__texto {
    max-width: 42ch;
    color: var(--tinta-suave);
  }

  /* A galeria: os vídeos na proporção real deles. Os deitados em cima;
     os em pé numa fileira embaixo, que desliza pro lado quando não cabe. */
  .estilo__galeria {
    --altura: clamp(300px, 30vw, 400px);
    display: grid;
    gap: var(--e-16);
    min-width: 0;
  }

  .fila {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--e-16);
  }

  .fila--deitada {
    flex-direction: column;
  }

  .fila--em-pe {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .fila--em-pe::-webkit-scrollbar {
    display: none;
  }

  .exemplo {
    flex: none;
    scroll-snap-align: start;
    overflow: hidden;
    border-radius: var(--raio-card-sm);
    background: var(--carvao);
    box-shadow: var(--anel);
  }

  .exemplo--em-pe {
    height: var(--altura);
    aspect-ratio: 9 / 16;
  }

  .exemplo--deitado {
    width: min(100%, calc(var(--altura) * 16 / 9));
    aspect-ratio: 16 / 9;
  }

  /* No celular o deitado ocupa a largura e a fileira em pé sangra até a borda. */
  @media (max-width: 959px) {
    .fila--em-pe {
      margin-inline: calc(-1 * clamp(16px, 5vw, 40px));
      padding-inline: clamp(16px, 5vw, 40px);
      scroll-padding-inline: clamp(16px, 5vw, 40px);
      padding-bottom: var(--e-8);
    }

    .exemplo--em-pe {
      height: auto;
      width: min(64vw, 280px);
    }

    .exemplo--deitado {
      width: 100%;
    }
  }

  /* ---------- 06. Em construção: a bancada ---------- */
  /* Bastidor elegante: uma planta quadriculada em menta bem fraca atrás,
     que some nas bordas, e dois cards de ferramenta com o desenho delas
     montando ao vivo. O indicador é honesto: diz que está andando, nunca
     quanto falta. Sem número, sem data, sem faixa zebrada. */
  .obra {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .obra__planta {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(var(--menta-veu) 1px, transparent 1px),
      linear-gradient(90deg, var(--menta-veu) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(60% 70% at 50% 55%, #000 30%, transparent 80%);
    mask-image: radial-gradient(60% 70% at 50% 55%, #000 30%, transparent 80%);
  }

  /* Mesmo teto e mesmo eixo dos títulos de módulos e do "Além disso". */
  .obra__titulo {
    max-width: 32ch;
    margin-inline: auto;
    margin-bottom: var(--e-16);
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.03em;
    text-align: center;
  }

  .obra__sub {
    max-width: 46ch;
    margin: 0 auto clamp(28px, 5vw, 48px);
    text-align: center;
    color: var(--tinta-suave);
  }

  .obra__sub strong {
    color: var(--menta);
    font-weight: var(--peso-medio);
  }

  .obra__lista {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1160px;
    display: grid;
    gap: var(--e-16);
  }

  /* Os três cards sempre do mesmo tamanho: a linha mais alta manda em todas. */
  .obra__lista {
    grid-auto-rows: 1fr;
  }

  @media (min-width: 1000px) {
    .obra__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--e-24);
    }
  }



  /* ---------- o card da ferramenta ---------- */
  .ferramenta {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: calc(var(--raio-card) + 4px);
    background: var(--carvao);
    box-shadow:
      0 0 0 1px var(--linha),
      0 30px 60px -40px rgba(0, 0, 0, 1);
    overflow: hidden;
    transition:
      transform var(--transicao) var(--curva),
      box-shadow var(--transicao) var(--curva);
  }

  .ferramenta:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px var(--menta-linha),
      0 30px 60px -32px color-mix(in srgb, var(--menta) 45%, transparent);
  }

  /* O palco do desenho: a mesma planta, mais nítida, com luz por baixo. */
  .ferramenta__palco {
    position: relative;
    display: grid;
    place-items: center;
    height: 230px;
    padding: var(--e-20);
    background:
      radial-gradient(70% 80% at 50% 110%, var(--menta-brilho), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--menta) 9%, transparent) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, color-mix(in srgb, var(--menta) 9%, transparent) 1px, transparent 1px) 0 0 / 20px 20px,
      #0d0d0d;
    border-bottom: 1px dashed var(--menta-linha);
  }

  .ferramenta__corpo {
    display: grid;
    align-content: start;
    gap: var(--e-12);
    padding: var(--e-24) clamp(20px, 3vw, 28px) clamp(24px, 3vw, 32px);
  }

  .ferramenta__nome {
    font-size: var(--t-titulo-sm);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--tinta);
  }

  .ferramenta__texto {
    color: var(--tinta-suave);
  }

  /* O texto vem da copy começando em minúscula (era a continuação de
     "Nome:"). A maiúscula é só de exibição; a frase não muda. */
  .ferramenta__texto::first-letter {
    text-transform: uppercase;
  }

  /* ---------- o indicador honesto ---------- */
  .status {
    display: flex;
    align-items: center;
    gap: var(--e-8);
    min-width: 0;
  }

  .status__ponto {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: var(--raio-pilula);
    background: var(--menta-solida);
    box-shadow: 0 0 0 3px var(--menta-veu);
  }

  .status__texto {
    flex-shrink: 0;
    font-size: var(--t-legenda);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--menta);
  }

  /* Um trilho sem fim: o trecho aceso vai e volta, sem porcentagem. */
  .status__trilho {
    position: relative;
    flex: 1;
    max-width: 120px;
    height: 3px;
    margin-left: var(--e-4);
    border-radius: var(--raio-pilula);
    background: var(--lavagem);
    overflow: hidden;
  }

  .status__trilho i {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 36%;
    border-radius: inherit;
    background: var(--menta);
  }

  /* ---------- as prévias: um pedaço da tela de cada ferramenta ---------- */
  .tela {
    display: grid;
    grid-template-rows: auto 1fr;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    background: #121212;
    box-shadow: 0 0 0 1px rgba(240, 238, 230, 0.12), 0 18px 40px -20px #000;
    overflow: hidden;
  }

  .tela__barra {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 7px 10px;
    border-bottom: 1px solid rgba(240, 238, 230, 0.08);
  }

  .tela__barra i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #333;
  }

  .tela__barra span {
    margin-left: 6px;
    font-size: 10px;
    color: var(--apoio);
  }

  /* print de verdade da ferramenta, alinhado por baixo, onde está a linha do tempo */
  .tela--print img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: left bottom;
  }

  /* blender: a cena aberta em cima e o roteiro, cena por cena, embaixo */
  .blender {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 0;
  }

  .blender__vista {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 4px;
    background:
      linear-gradient(rgba(240, 238, 230, 0.05) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, rgba(240, 238, 230, 0.05) 1px, transparent 1px) 0 0 / 16px 16px,
      #181818;
  }

  .blender__vista .montagem {
    width: auto;
    height: 100%;
    max-height: 100px;
  }

  .blender__fala {
    position: absolute;
    left: 8px;
    bottom: 6px;
    padding: 3px 7px;
    border-radius: 4px;
    background: var(--menta-tinge);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: 9px;
  }

  .roteiro {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5px;
    margin: 0;
    padding: 6px 8px 8px;
    list-style: none;
    border-top: 1px solid rgba(240, 238, 230, 0.08);
  }

  .roteiro li {
    display: grid;
    gap: 3px;
    font-size: 9px;
    color: var(--apoio);
  }

  .roteiro__quadro {
    height: 22px;
    border-radius: 3px;
    background: #222;
    box-shadow: inset 0 0 0 1px rgba(240, 238, 230, 0.12);
  }

  .roteiro__viva {
    color: var(--menta) !important;
  }

  .roteiro__viva .roteiro__quadro {
    background: var(--menta-tinge);
    box-shadow: inset 0 0 0 1.5px var(--menta);
  }

  /* ganho */
  .ganho {
    display: grid;
    gap: 8px;
    width: min(100%, 270px);
  }

  .ganho__card,
  .ganho__prox {
    display: grid;
    justify-items: start;
    gap: 4px;
    padding: 10px 12px;
    border-radius: 10px;
    background: #141414;
    box-shadow: 0 0 0 1px rgba(240, 238, 230, 0.12);
    text-align: left;
  }

  .ganho__selo {
    padding: 1px 7px;
    border-radius: 4px;
    background: #3fa45b;
    color: #fff;
    font-size: 11px;
    font-weight: var(--peso-medio);
  }

  .ganho__de {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--tinta-suave);
  }

  .ganho__valor {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--tinta);
  }

  .ganho__valor--sm {
    font-size: 1rem;
  }

  .ganho__rotulo {
    font-size: 10px;
    color: var(--apoio);
  }

  .ganho__trilho {
    width: 100%;
    height: 6px;
    border-radius: var(--raio-pilula);
    background: #2a2a2a;
    overflow: hidden;
  }

  .ganho__trilho i {
    display: block;
    width: 91.5%;
    height: 100%;
    border-radius: inherit;
    background: var(--menta-solida);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ganho__trilho i {
      animation: enche 4s var(--curva) infinite;
    }
  }

  @keyframes enche {
    0% {
      transform: scaleX(0.6);
    }
    40%,
    100% {
      transform: scaleX(1);
    }
  }

  /* ---------- desenho: montagem 3D ---------- */
  .montagem {
    width: min(100%, 190px);
    height: auto;
    overflow: visible;
  }

  .montagem__chao {
    fill: none;
    stroke: rgba(240, 238, 230, 0.18);
    stroke-dasharray: 3 4;
  }

  /* O plano: o cubo inteiro em tracejado fraco, pra se ver o que falta. */
  .montagem__plano path,
  .montagem__oculta {
    fill: none;
    stroke: rgba(240, 238, 230, 0.2);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  .montagem__aresta {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 60;
    stroke-dashoffset: 0;
  }

  .montagem__no {
    fill: var(--carvao);
    stroke: var(--menta);
    stroke-width: 1.5;
  }

  .montagem__no--vivo {
    fill: var(--menta-solida);
    stroke: none;
  }

  /* ---------- movimento: só pra quem aceita ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .status__ponto {
      animation: pisca 1.8s ease-in-out infinite;
    }

    .status__trilho i {
      animation: vai-e-volta 2.4s var(--curva) infinite alternate;
    }

    /* As arestas se desenham uma depois da outra, seguram, e recomeçam. */
    .montagem__aresta {
      animation: monta 7s var(--curva) infinite;
      animation-delay: calc(var(--i) * 0.28s);
    }

    .montagem__no--vivo {
      animation: pisca 1.2s ease-in-out infinite;
    }
  }

  @keyframes pisca {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes vai-e-volta {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(280%);
    }
  }

  @keyframes monta {
    0% {
      stroke-dashoffset: 60;
      opacity: 1;
    }
    18%,
    80% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    92%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  /* ---------- 08 + 09. A oferta: um card só ---------- */
  /* Tudo que decide a compra num objeto: o que vem, por que custa isso,
     o número, o botão e a garantia no rodapé. Escuro como a página, com a
     menta acesa na borda; o ponto mais claro da cena é o botão. */
  .oferta {
    position: relative;
    isolation: isolate;
  }

  .oferta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(40% 50% at 50% 45%, var(--menta-brilho), transparent 72%);
    pointer-events: none;
  }

  .palco {
    position: relative;
    max-width: 780px;
    margin-inline: auto;
    border-radius: calc(var(--raio-card) + 12px);
    background:
      radial-gradient(90% 40% at 50% 0%, color-mix(in srgb, var(--menta) 12%, transparent), transparent 70%),
      linear-gradient(180deg, #121212, var(--carvao));
    box-shadow:
      0 0 0 1px var(--menta-linha),
      0 0 0 6px var(--menta-veu),
      0 50px 120px -50px color-mix(in srgb, var(--menta) 55%, transparent);
    text-align: center;
    overflow: hidden;
  }

  /* Uma linha de luz no topo da borda: o card parece aceso por cima. */
  .palco::before {
    content: '';
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--menta), transparent);
  }

  .palco__cabeca,
  .palco__pacote,
  .palco__valor-bloco {
    padding-inline: clamp(20px, 6vw, 64px);
  }

  .palco__cabeca {
    display: grid;
    justify-items: center;
    gap: var(--e-16);
    padding-top: clamp(32px, 6vw, 56px);
  }

  .palco__selo {
    margin: 0;
    padding: 6px 14px;
    border-radius: var(--raio-pilula);
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: var(--t-legenda);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .palco__marca {
    display: inline-flex;
    align-items: center;
    gap: 0.22em;
    margin: var(--e-4) 0 0;
    font-size: clamp(2.75rem, 9vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--tinta);
  }

  .palco__logo {
    width: 0.92em;
    height: 0.92em;
    filter: drop-shadow(0 0 18px var(--menta-linha));
  }

  .palco__hub {
    color: var(--menta);
  }

  .palco__titulo {
    max-width: 40ch;
    font-size: var(--t-corpo-lg);
    letter-spacing: -0.01em;
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  /* ---------- o pacote ---------- */
  .palco__pacote {
    margin-top: clamp(32px, 5vw, 48px);
  }

  .palco__rotulo {
    margin: 0 auto var(--e-20);
    font-size: var(--t-legenda);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--apoio);
  }

  .pacote {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 560px;
    margin-inline: auto;
    text-align: left;
  }


  /* Selos à direita da linha: "Em breve" e o valor cortado do bônus. */
  .selo-pacote {
    flex: none;
    margin-left: auto;
    padding: 2px 10px;
    border-radius: var(--raio-pilula);
    font-family: var(--fonte-mono);
    font-size: var(--t-legenda);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .selo-pacote--breve {
    color: var(--apoio);
    box-shadow: inset 0 0 0 1px var(--linha-forte);
    text-transform: uppercase;
  }

  .selo-pacote--preco {
    color: var(--apoio);
    font-size: var(--t-corpo-sm);
  }

  .selo-pacote--preco s {
    text-decoration-color: var(--menta);
    text-decoration-thickness: 2px;
  }

  .pacote__fundador {
    color: var(--menta);
    font-weight: 600;
  }

  .pacote li {
    gap: var(--e-12);
    position: relative;
    padding: var(--e-12) 0 var(--e-12) 40px;
    border-bottom: 1px solid var(--linha);
    color: var(--tinta);
    font-size: var(--t-corpo-sm);
    line-height: 1.45;
    display: flex;
    align-items: center;
    min-height: 52px;
  }


  /* Disco menta com visto escuro. */
  .pacote li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-radius: var(--raio-pilula);
    background: var(--menta-solida);
    box-shadow: 0 0 12px var(--menta-linha);
  }

  .pacote li::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 50%;
    width: 9px;
    height: 5px;
    margin-top: -4px;
    border-left: 2px solid var(--sobre-menta);
    border-bottom: 2px solid var(--sobre-menta);
    transform: rotate(-45deg);
  }

  /* ---------- o valor ---------- */
  .palco__valor-bloco {
    display: grid;
    justify-items: center;
    margin-top: clamp(32px, 5vw, 48px);
    padding-top: clamp(32px, 5vw, 48px);
    padding-bottom: clamp(32px, 5vw, 48px);
    border-top: 1px solid var(--linha);
  }

  .palco__porque {
    max-width: 54ch;
    font-size: var(--t-corpo-sm);
    color: var(--apoio);
  }

  .palco__porque strong {
    color: var(--menta);
    font-weight: var(--peso-medio);
  }

  .palco__numero {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin: var(--e-24) 0 0;
    /* No celular o número cresce com a tela: é o ponto alto do card. */
    font-size: clamp(6rem, 28vw, 9rem);
    font-weight: var(--peso-medio);
    line-height: 0.9;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--tinta);
  }

  .palco__moeda,
  .palco__centavos {
    font-size: 0.3em;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-top: 0.22em;
  }

  .palco__moeda {
    margin-right: 0.1em;
    color: var(--tinta-suave);
  }

  .palco__moeda,
  .palco__centavos {
    font-weight: 700;
  }

  .palco__centavos {
    margin-left: 0.06em;
    color: var(--menta);
  }

