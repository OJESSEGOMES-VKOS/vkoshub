<script>
  // O título troca a cada 3 s: "grava/edita" vira "pensa/cria" e volta.
  // Pra quem pede menos movimento, fica parado na primeira frase.
  const troca = document.querySelector<HTMLElement>('[data-troca]');
  if (troca && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => {
      if (!document.hidden) troca.classList.toggle('trocado');
    }, 3000);
  }
</script>

<script>
  // O leque do topo (o mesmo da página atual): seis vídeos, o da frente toca e a
  // cada 10 s o da direita vem pra frente. Clicar num vídeo do lado traz ele pra
  // frente. Para com o mouse em cima e fica parado pra quem pede menos movimento.
  const leque = document.querySelector<HTMLElement>('[data-carrossel]');
  if (leque) {
    const videos = [...leque.querySelectorAll<HTMLVideoElement>('video')];
    const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let parado = false;

    const avancar = (passos: number) => {
      videos.forEach((v) => {
        const pos = (Number(v.dataset.pos) + videos.length - (passos % videos.length)) % videos.length;
        v.dataset.pos = String(pos);
        if (pos === 0 && !reduz) {
          v.currentTime = 0;
          void v.play();
        } else {
          v.pause();
        }
      });
    };

    if (reduz) {
      videos.forEach((v) => v.pause());
    } else {
      leque.addEventListener('mouseenter', () => (parado = true));
      leque.addEventListener('mouseleave', () => (parado = false));
      setInterval(() => {
        if (parado || document.hidden) return;
        avancar(1);
      }, 10000);
    }

    videos.forEach((v) => {
      v.addEventListener('click', () => {
        const pos = Number(v.dataset.pos);
        if (pos > 0) avancar(pos);
      });
    });
  }
</script>

<script>
  // A conversa: troca sozinha a cada 6 s enquanto está na tela, para de vez quando
  // a pessoa escolhe um pedido, e nem começa pra quem pede menos movimento.
  const raiz = document.querySelector<HTMLElement>('[data-conversa]');
  if (raiz) {
    const botoes = [...raiz.querySelectorAll<HTMLButtonElement>('[data-item]')];
    const video = raiz.querySelector<HTMLVideoElement>('[data-saida]')!;
    const nome = raiz.querySelector<HTMLElement>('[data-saida-nome]')!;
    const texto = raiz.querySelector<HTMLElement>('[data-pedido-texto]')!;
    const fonte = video.querySelector('source')!;
    const pedidos: string[] = JSON.parse(raiz.dataset.pedidos || '[]');
    const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let atual = 0;
    let modelo = botoes[0].dataset.nome!;
    let parado = reduz;
    let visivel = false;

    // Monta a frase sem innerHTML: texto + nome em negrito.
    const escreve = (antes: string, destaque: string, depois: string) => {
      const forte = document.createElement('strong');
      forte.textContent = destaque;
      texto.replaceChildren(antes, forte, depois);
    };

    const mostrar = (i: number) => {
      atual = i;
      const b = botoes[i];
      const estilo = b.hasAttribute('data-estilo');
      const rotulo = b.dataset.nome!;
      if (!estilo) modelo = rotulo;
      botoes.forEach((x, k) => x.setAttribute('aria-pressed', String(k === i)));
      fonte.src = b.dataset.src!;
      video.poster = b.dataset.poster!;
      video.setAttribute('aria-label', `${estilo ? 'Cena no estilo' : 'Vídeo editado no modelo'} ${rotulo}`);
      nome.textContent = `${estilo ? 'estilo' : 'modelo'} ${rotulo}`;
      video.load();
      if (visivel && !reduz) void video.play().catch(() => {});
      texto.classList.add('is-trocando');
      setTimeout(() => {
        if (estilo) escreve(`Edita no modelo ${modelo} e, na frase 2, usa o estilo `, rotulo, '');
        else escreve('Edita esse vídeo no modelo ', rotulo, ` e ${pedidos[i % pedidos.length]}`);
        texto.classList.remove('is-trocando');
      }, 250);
    };

    botoes.forEach((b, i) =>
      b.addEventListener('click', () => {
        parado = true;
        mostrar(i);
      }),
    );

    new IntersectionObserver(([e]) => {
      visivel = e.isIntersecting;
      if (visivel && !reduz) void video.play().catch(() => {});
      else video.pause();
    }).observe(raiz);

    setInterval(() => {
      if (parado || !visivel || document.hidden) return;
      mostrar((atual + 1) % botoes.length);
    }, 6000);
  }
</script>

<script>
  // As abas dos tipos de vídeo. Sem JavaScript, os painéis aparecem um embaixo do outro.
  document.querySelectorAll<HTMLElement>('[data-tipos]').forEach((raiz) => {
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = [...raiz.querySelectorAll<HTMLElement>('[data-painel]')];
    const abrir = (n: number, foco = false) => {
      abas.forEach((aba, i) => {
        aba.setAttribute('aria-selected', i === n ? 'true' : 'false');
        aba.tabIndex = i === n ? 0 : -1;
        paineis[i].hidden = i !== n;
      });
      if (foco) abas[n].focus();
    };
    abas.forEach((aba, i) => {
      aba.addEventListener('click', () => abrir(i));
      aba.addEventListener('keydown', (ev) => {
        if (ev.key === 'ArrowRight') abrir((i + 1) % abas.length, true);
        if (ev.key === 'ArrowLeft') abrir((i - 1 + abas.length) % abas.length, true);
      });
    });
    raiz.classList.add('com-abas');
    abrir(0);
  });
</script>

<script>
  // As prateleiras: cada vídeo carrega na primeira vez que aparece, toca enquanto
  // está na tela e para quando sai. Pra quem pede menos movimento, fica só a capa.
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const olho = new IntersectionObserver(
    (entradas) =>
      entradas.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (reduz) return;
          if (!v.src) v.src = v.dataset.src!;
          void v.play().catch(() => {});
        } else {
          v.pause();
        }
      }),
    { threshold: 0.25 },
  );
  document.querySelectorAll<HTMLVideoElement>('[data-vitrine]').forEach((v) => olho.observe(v));
</script>
