  .traducao__par {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--e-12);
    padding: var(--e-12) var(--e-16);
    /* O par fica sobre o card, então precisa de um degrau a mais que ele. */
    background: var(--lavagem);
    border-radius: var(--raio-card-sm);
  }

  .traducao__fala {
    color: var(--tinta);
  }

  .traducao__seta {
    font-size: var(--t-legenda);
    color: var(--apoio);
  }

  /* A menta de ênfase, que é quem escreve dado vivo nos dois temas. */
  .traducao__cmd {
    color: var(--menta-fundo);
    font-size: var(--t-corpo-sm);
  }

  /* No celular o par empilha sempre igual: a fala em cima, o comando
     embaixo. Deixar a quebra por conta do navegador fazia cada item
     quebrar num ponto diferente, e a lista perdia o ritmo. */
  @media (max-width: 560px) {
    .traducao__par {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--e-4) var(--e-8);
    }

    .traducao__fala {
      grid-column: 1 / -1;
    }
  }

  .sozinho {
    list-style: none;
    margin: var(--e-16) 0 0;
    padding: 0;
    display: grid;
    gap: var(--e-12);
    max-width: 64ch;
  }

  .sozinho__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e-12);
    align-items: start;
    color: var(--tinta-suave);
    line-height: var(--altura-corpo);
  }

  .sozinho__marca {
    width: 7px;
    height: 7px;
    margin-top: 0.55em;
    border-radius: var(--raio-pilula);
    background: var(--menta-fundo);
  }

  .autonomia__fecho {
    max-width: 62ch;
    margin-top: var(--e-32);
    padding-top: var(--e-24);
    border-top: 1px solid var(--linha);
    font-size: var(--t-corpo-lg);
    color: var(--tinta);
    text-wrap: pretty;
  }

  .mono {
    font-family: var(--fonte-mono);
    letter-spacing: -0.01em;
  }
</style>
