---
/**
 * A página do VKOS.
 *
 * Projeto com `estado: 'ativo'` tem página própria, escrita à mão, porque ele
 * já roda e tem o que contar. O `[slug].astro` cuida só dos que ainda estão em
 * produção, por isso ele filtra os ativos.
 *
 * Todo dado desta página sai do CLAUDE.md, das skills em .claude/skills/ e do
 * CONEXOES.md do próprio VKOS. Nada aqui é estimativa.
 */
import Base from '../../layouts/Base.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import Rodape from '../../components/Rodape.astro';
import CerebroIA from '../../components/CerebroIA.astro';
import { playbooks } from '../../data/playbooks.js';

const projeto = playbooks.find((p) => p.slug === 'vkos');

/* A versão do sistema. Ela sai do CHANGELOG.md da raiz do VKOS, e é o
   número que a página inteira usa: o selo da abertura, o texto do "O que
   é" e o fecho. Subiu de versão lá? Muda aqui, num lugar só. */
const versao = '4.1';

/* "VKOS | OJESSEGOMES" eram dois nomes e nenhuma informação. Ninguém
   busca por VKOS, que ainda não existe na cabeça de ninguém: busca pelo
   que ele faz. */
const titulo = 'VKOS, o sistema que opera o negócio por comando | VKOSHUB';

// Os três passos do ciclo. É assim que uma peça nasce aqui dentro.
const ciclo = [
  {
    n: '01',
    nome: 'O Cérebro',
    texto:
      'Um arquivo guarda a identidade do negócio: o que vende, pra quem, a dor do cliente, a voz, as provas. Todo comando lê ele antes de gerar qualquer coisa. É por isso que o resultado sai com a cara do negócio em vez da cara de IA.',
  },
  {
    n: '02',
    nome: 'O comando',
    texto:
      'Você digita /carrossel, /site ou /anuncio. Cada comando é um procedimento escrito, com o passo a passo daquela tarefa. Não é o modelo improvisando, é ele seguindo um método que já foi testado.',
  },
  {
    n: '03',
    nome: 'A prova',
    texto:
      'Antes de dizer pronto, ele abre no navegador o que acabou de construir e confere. Página que não abre, formulário que não envia e texto com cara de IA voltam pra bancada.',
  },
];

// Os comandos, agrupados como vivem no sistema. Um por pasta em .claude/skills/.
const grupos = [
  {
    nome: 'Núcleo',
    comandos: [
      { cmd: '/instalar', o: 'monta o Cérebro do negócio. É o primeiro comando, uma vez só.' },
      { cmd: '/cerebro', o: 'ver ou atualizar a identidade do negócio.' },
      { cmd: '/vkos', o: 'o mapa: o que dá pra fazer e por onde começar.' },
      { cmd: '/atualizar', o: 'varre o sistema e reconcilia o contexto com a realidade.' },
      { cmd: '/evoluir', o: 'audita o que já foi feito e aponta o próximo passo de maior impacto.' },
      { cmd: '/cerebro-fable', o: 'o protocolo de raciocínio pra tarefa grande.' },
      {
        cmd: '/orquestrador',
        o: 'recebe o pedido grande e bagunçado, quebra em frentes e entrega o trabalho feito.',
      },
    ],
  },
  {
    nome: 'Descoberta',
    comandos: [
      { cmd: '/ikigai', o: 'pra quem chegou sem saber o que vender nem pra quem. Destrava a direção.' },
      { cmd: '/posicionamento', o: 'acha o ângulo único e defensável do negócio.' },
    ],
  },
  {
    nome: 'Identidade visual',
    comandos: [{ cmd: '/estilo', o: 'define o visual próprio do negócio e grava no design-guide.' }],
  },
  {
    nome: 'Conteúdo',
    comandos: [
      { cmd: '/semana', o: 'de uma ideia a uma semana inteira de conteúdo. É o motor.' },
      { cmd: '/ideias', o: 'pauta a partir dos pilares do negócio.' },
      { cmd: '/carrossel', o: 'carrossel de texto e renderiza as imagens prontas pra postar.' },
      { cmd: '/stories', o: 'sequência de stories com as imagens verticais prontas.' },
      { cmd: '/legenda', o: 'legenda com chamada pra ação.' },
      { cmd: '/titulo-gancho', o: 'títulos e ganchos pra testar.' },
    ],
  },
  {
    nome: 'Perfil',
    comandos: [
      { cmd: '/bio', o: 'bio que diz o que é e leva pra ação.' },
      { cmd: '/destaques', o: 'organização e capas dos destaques.' },
      { cmd: '/perfil', o: 'diagnóstico e estratégia do feed.' },
    ],
  },
  {
    nome: 'Site e páginas',
    comandos: [
      { cmd: '/site', o: 'texto das seções do site.' },
      { cmd: '/landing', o: 'página de captura pra uma oferta.' },
      { cmd: '/blog', o: 'artigo de blog otimizado pra busca.' },
    ],
  },
  {
    nome: 'Google e local',
    comandos: [
      { cmd: '/google', o: 'otimiza o Perfil da Empresa no Google.' },
      { cmd: '/avaliacoes', o: 'responde avaliação, boa e ruim.' },
      { cmd: '/seo-local', o: 'ser achado por quem procura o serviço na cidade.' },
    ],
  },
  {
    nome: 'Anúncios e funil',
    comandos: [
      { cmd: '/anuncio', o: 'texto de anúncio pro Google e pra Meta.' },
      { cmd: '/criativo', o: 'ideia e roteiro do criativo do anúncio.' },
      { cmd: '/funil', o: 'monta o funil de aquisição ponta a ponta.' },
    ],
  },
  {
    nome: 'Construção',
    comandos: [
      { cmd: '/projeto', o: 'constrói projeto livre, do app à automação.' },
      { cmd: '/revisar-design', o: 'audita uma peça visual pronta e aplica as correções aprovadas.' },
      { cmd: '/refinar', o: 'melhoria pontual: tipografia, cor, layout, motion, clareza.' },
      { cmd: '/enxuto', o: 'a postura de código mínimo. Deleção antes de adição.' },
      { cmd: '/enxuto-revisao', o: 'revisa o projeto atrás de over-engineering.' },
      {
        cmd: '/seguranca',
        o: 'audita código, acesso, banco e dado pessoal antes de qualquer coisa ir pro ar.',
      },
      {
        cmd: '/seguranca-profunda',
        o: 'a camada acima, pra projeto com backend, pagamento ou dado pessoal em escala.',
      },
      {
        cmd: '/guerrilha',
        o: 'carrega uma operação de prospecção inteira: o CRM dos leads, os dossiês de mercado e os scripts.',
      },
    ],
  },
  {
    nome: 'Escrita',
    comandos: [
      { cmd: '/humanizer', o: 'tira a cara de IA de qualquer texto e preserva a voz. É o polimento final.' },
    ],
  },
];

const totalComandos = grupos.reduce((soma, g) => soma + g.comandos.length, 0);

/* A descrição vem depois da lista de propósito: o número de comandos dela
   sai da contagem, não da memória de quem escreveu. */
const descricao = `VKOS ${versao}, o sistema de IA que constrói e opera o VKOSHUB: ${totalComandos} comandos, um Cérebro que guarda a identidade do negócio e a regra de conferir com prova antes de entregar.`;

/* O que a pessoa fala e o comando que o sistema aciona sozinho. Cada par
   sai do gatilho declarado na própria skill, no campo que diz quando ela
   entra. Nada aqui é exemplo inventado. */
const traducoes = [
  { fala: '"preciso de conteúdo pra semana"', cmd: '/semana' },
  { fala: '"meu perfil tá fraco"', cmd: '/perfil' },
  { fala: '"recebi uma avaliação ruim"', cmd: '/avaliacoes' },
  { fala: '"não sei o que vender"', cmd: '/ikigai' },
];

// O que roda sem ninguém pedir. São regras do sistema, não gentileza dele.
const sozinho = [
  'Lê o Cérebro antes de gerar qualquer coisa, pra a peça sair com a cara do negócio.',
  'Passa o humanizer em todo texto público antes de entregar, pra nada sair com cara de IA.',
  'Abre no navegador e confere o que construiu antes de dizer que está pronto.',
  'Em tarefa grande, roda o protocolo de raciocínio antes de encostar a mão.',
];

// As regras da casa. Elas valem pra toda peça que sai, sem exceção.
const regras = [
  {
    titulo: 'Lê o Cérebro antes de opinar',
    texto:
      'Nenhuma peça nasce sem passar pela identidade do negócio. Se o Cérebro estiver vazio, o sistema para e manda montar ele primeiro.',
  },
  {
    titulo: 'Nunca inventa dado do negócio',
    texto:
      'Faltou um preço, um endereço, um depoimento? Ele pergunta. Preencher com suposição é o erro que estraga a confiança mais rápido.',
  },
  {
    titulo: 'Entrega completa, sem lacuna',
    texto:
      'Nada de "aqui você coloca X" nem seção rascunhada. O que depende de você sai listado fora da peça, no recado final, nunca dentro dela.',
  },
  {
    titulo: 'Confere com prova antes de dizer pronto',
    texto:
      'Ele abre a página, mede o contraste, testa o caminho principal. Se não deu pra testar alguma coisa, ele diz qual e por quê em vez de supor.',
  },
  {
    titulo: 'Todo texto público passa pelo humanizer',
    texto:
      'Legenda, copy de site, anúncio, email. O polimento final tira vocabulário inflado, pontuação picada e bajulação, e preserva a voz do Cérebro.',
  },
  {
    titulo: 'Segurança e LGPD nascem junto',
    texto:
      'Nada de senha dentro do arquivo que vai pro ar. O que fazer com nome e telefone de gente real é decidido antes da primeira linha, não depois. E publicar só com a sua aprovação.',
  },
  {
    titulo: 'Fala com quem não é técnico',
    texto:
      'Termo técnico no recado final é ruído, não competência. O dono quer saber que aparece no Google, que o contato chega e que abre rápido no celular.',
  },
];

/**
 * O que já saiu do VKOS.
 *
 * Cada capa é uma foto real do site no ar, tirada em 04/08/2026 em 1280x720 e
 * salva em WebP. Site muda com o tempo, então a captura envelhece: quando um
 * deles for redesenhado, tire a foto de novo e troque o arquivo.
 *
 * A descrição diz o que a peça É, nunca o resultado que ela deu. O Cérebro
 * proíbe usar case de cliente e número de faturamento como prova, e o que
 * aparece aqui é o trabalho funcionando, que é a prova que vale nesta marca.
 */
const obras = [
  {
    nome: 'VKOSHUB',
    oque: 'A plataforma de entrega desta marca. É onde você está agora, e ela nasceu inteira aqui dentro.',
    capa: '/obras/vkoshub.webp',
    capaAlt: 'A listagem de projetos do VKOSHUB, em tema escuro, com os cards claros lado a lado',
    links: [{ texto: 'Você está aqui', href: '/ojessegomes', externo: false }],
  },
  {
    nome: 'VirtuoKingdom',
    oque: 'O site da frente de serviços, que instala sistema de IA dentro do negócio do cliente.',
    capa: '/obras/virtuokingdom.webp',
    capaAlt: 'A abertura do site da VirtuoKingdom, com o título sobre sistemas de IA em fundo escuro',
    links: [{ texto: 'virtuokingdom.com.br', href: 'https://virtuokingdom.com.br', externo: true }],
  },
  {
    nome: 'Parraga Media',
    oque: 'A página de uma agência de tráfego que trabalha com e-commerce de moda feminina.',
    capa: '/obras/parraga.webp',
    capaAlt: 'A abertura do site da Parraga Media, com o título grande e a foto do fundador à direita',
    links: [{ texto: 'vitorparraga.netlify.app', href: 'https://vitorparraga.netlify.app', externo: true }],
  },
  {
    nome: 'Gabriel Braga',
    oque: 'O site de um guitarrista que vende preset, curso e mentoria, com uma página de bio separada pra levar do perfil pros três caminhos.',
    capa: '/obras/gabrielbraga.webp',
    capaAlt: 'A abertura do site do Gabriel Braga, com ele tocando guitarra no estúdio ao fundo',
    links: [
      { texto: 'gabrielbraga.netlify.app', href: 'https://gabrielbraga.netlify.app/', externo: true },
      { texto: '/bio', href: 'https://gabrielbraga.netlify.app/bio', externo: true },
    ],
  },
];

// As duas conexões que vêm ligadas, descritas no CONEXOES.md.
const conexoes = [
  {
    nome: 'O navegador',
    texto:
      'Deixa o VKOS abrir de verdade o que ele acabou de construir, olhar na tela do celular e na do computador, e conferir antes de entregar. É a diferença entre "deve estar bom" e "abri e vi funcionando".',
  },
  {
    nome: 'A consulta de manuais',
    texto:
      'Busca o manual de hoje da ferramenta que ele está usando num projeto, em vez de confiar no que ele aprendeu meses atrás. Documentação atual vale mais que memória.',
  },
];
---

<Base titulo={titulo} descricao={descricao}>
  <Cabecalho projeto="vkos" />

  <main id="conteudo">
    {/* A abertura é uma faixa da superfície, o mesmo cinza dos painéis da
        página. Ela separa a abertura do resto sem inverter o tema: a
        página é escura de ponta a ponta. */}
    <section class="heroi">
      <div class="limite">
        <a class="voltar mono reveal" href="/ojessegomes">
          <span aria-hidden="true">←</span> Todos os projetos
        </a>

        {/* Texto e capa lado a lado a partir de 900px. Empilhados, a capa
            16:9 na largura toda sozinha passava de 600px de altura e a
            abertura não cabia numa tela só. */}
        <div class="heroi__grade">
        <div class="heroi__texto">
        <div class="heroi__topo reveal" style="--atraso: 40ms">
          <span class="tag mono">{projeto.categoria}</span>
          {/* A versão fica no mesmo trilho da categoria e do estado, com a
              menta que a página já usa pra dado vivo. Não é selo colado: é
              mais um campo da ficha, e sai da mesma constante do resto. */}
          <span class="tag tag--versao mono">v{versao}</span>
          <span class="estado mono">
            <span class="estado__ponto" aria-hidden="true"></span>Ativo
          </span>
        </div>

        <h1 class="reveal" style="--atraso: 80ms">VKOS</h1>

        <p class="heroi__resumo reveal" style="--atraso: 120ms">
          O sistema que constrói e opera o VKOSHUB. Cada projeto, cada página e cada peça daqui
          nasce dentro dele.
        </p>

        <p class="mono heroi__meta reveal" style="--atraso: 160ms">
          {/* O mesmo selo que o card mostra na lista, e não o `tempo`. O
              card dizia "Atualização contínua" e a página dizia "Em
              operação": dois nomes pro mesmo estado, e quem chega pelo card
              acha que abriu outra coisa. Sai dos dados, então muda num
              lugar só. */}
          {projeto.formato} · {projeto.selo ?? projeto.tempo}
        </p>
        </div>

        {/* Não é screenshot nem foto: é o que o VKOS é, um cérebro que roda
            por comando. Metade órgão (os sulcos), metade circuito (as trilhas
            e os pads), desenhado com os mesmos tokens do resto do Hub e
            preenchendo a capa inteira. */}
        <div class="capa reveal" style="--atraso: 200ms">
          <span class="capa__vazia" aria-hidden="true">
            <CerebroIA fundo={false} circuito={false} contraste />
            <span class="capa__selo mono">
              <span class="capa__ponto"></span>
              VKOSHUB
            </span>
          </span>
        </div>
        </div>
      </div>
    </section>

    <section class="secao">
      <div class="limite">
        <div class="painel reveal">
        <h2>O que é</h2>
        <div class="prosa">
          <p>
            VKOS é a sigla de VirtuoKingdom Operational System. Na prática, é o lugar onde eu
            opero o negócio inteiro por comando: conteúdo, perfil, site, Google, anúncio e
            projeto.
          </p>
          <p>
            Ele não é um chat com prompt salvo. É um sistema com memória e regra, onde toda peça
            lê a mesma fonte de verdade antes de existir.
          </p>
          <p>
            Este Hub que você tá lendo agora foi construído inteiro dentro dele, da primeira cor
            até a página que você abriu.
          </p>
          <p>
            A versão de hoje é a <strong>{versao}</strong>. São {totalComandos} comandos, a
            auditoria de segurança dentro do caminho de publicação e uma camada de estratégia
            que ele lê antes de escrever: pra onde o negócio vai e o que faz uma página vender.
          </p>
        </div>
        </div>
      </div>
    </section>

    <section class="secao">
      <div class="limite">
        <h2 class="reveal">Como funciona</h2>
        <p class="secao__intro reveal" style="--atraso: 40ms">
          Três passos, sempre na mesma ordem. É a ordem que faz a diferença.
        </p>
        <ol class="ciclo">
          {
            ciclo.map((p, i) => (
              <li class="ciclo__item reveal" style={`--atraso: ${80 + i * 60}ms`}>
                <span class="mono ciclo__n">{p.n}</span>
                <h3 class="ciclo__nome">{p.nome}</h3>
                <p class="ciclo__texto">{p.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="secao">
      <div class="limite">
        <div class="autonomia reveal">
          <div class="autonomia__ilha">
            <p class="mono rotulo">Antes da lista</p>
            <h2>Você não precisa decorar nada disso</h2>
            <p class="autonomia__texto">
              A lista aqui embaixo é o repertório do sistema, não uma tabela pra você guardar.
              Na prática você escreve o que precisa, do jeito que falaria comigo, e ele
              reconhece qual comando cobre aquilo e segue o passo a passo daquele comando.
            </p>

            <ul class="traducao">
              {
                traducoes.map((t) => (
                  <li class="traducao__par">
                    <span class="traducao__fala">{t.fala}</span>
                    <span class="traducao__seta mono" aria-hidden="true">
                      vira
                    </span>
                    <code class="traducao__cmd mono">{t.cmd}</code>
                  </li>
                ))
              }
            </ul>

            <p class="autonomia__texto">E tem o que ele faz sem ninguém pedir:</p>
            <ul class="sozinho">
              {
                sozinho.map((s) => (
                  <li class="sozinho__item">
                    <span class="sozinho__marca" aria-hidden="true" />
                    {s}
                  </li>
                ))
              }
            </ul>

            <p class="autonomia__fecho">
              O comando existe pra garantir o método, não pra você memorizar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="secao">
      <div class="limite">
        <div class="painel reveal">
        <h2>Os comandos</h2>
        <p class="secao__intro">
          São {totalComandos} hoje, em {grupos.length} frentes. Cada um carrega o passo a passo
          da tarefa, não um atalho de prompt. Ver a lista ajuda a saber o que dá pra pedir.
        </p>
        <div class="grupos">
          {
            grupos.map((g) => (
              <section class="grupo">
                <h3 class="mono grupo__nome">{g.nome}</h3>
                <ul class="grupo__lista">
                  {g.comandos.map((c) => (
                    <li class="comando">
                      <code class="comando__cmd mono">{c.cmd}</code>
                      <span class="comando__o">{c.o}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
        </div>
      </div>
    </section>

    <section class="secao">
      <div class="limite">
        <div class="painel reveal">
        <h2>As regras que ele não quebra</h2>
        <p class="secao__intro">
          Sistema sem regra é chat. O que separa um do outro é o que ele se recusa a fazer.
        </p>
        <ul class="regras">
          {
            regras.map((r) => (
              <li class="regra">
                <h3 class="regra__titulo">{r.titulo}</h3>
                <p class="regra__texto">{r.texto}</p>
              </li>
            ))
          }
        </ul>
        </div>
      </div>
    </section>

    <section class="secao">
      <div class="limite">
        <h2 class="reveal">Projetos criados pelo VKOS</h2>
        <p class="secao__intro reveal" style="--atraso: 40ms">
          Site no ar, feito com os comandos daqui. Cada capa é uma foto da página de verdade,
          e o endereço embaixo abre ela.
        </p>
        <ul class="obras">
          {
            obras.map((o, i) => (
              <li class="obra reveal" style={`--atraso: ${(i % 2) * 60}ms`}>
                <img
                  class="obra__capa"
                  src={o.capa}
                  alt={o.capaAlt}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
                <div class="obra__corpo">
                  <h3 class="obra__nome">{o.nome}</h3>
                  <p class="obra__oque">{o.oque}</p>
                  <p class="obra__links mono">
                    {o.links.map((l) =>
                      l.externo ? (
                        <a
                          class="obra__link"
                          href={l.href}
                          target="_blank"
                          rel="noopener"
                          aria-label={`Abrir ${l.href.replace('https://', '')} em nova aba`}
                        >
                          {l.texto}
                          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                            <path
                              d="M7 17 17 7M9 7h8v8"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </a>
                      ) : (
                        <span class="obra__aqui">
                          <span class="obra__ponto" aria-hidden="true" />
                          {l.texto}
                        </span>
                      )
                    )}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="secao">
      <div class="limite">
        <h2 class="reveal">Onde as coisas ficam</h2>
        <p class="secao__intro reveal" style="--atraso: 40ms">
          Pasta com nome de gente, não de programador. Cada uma tem um arquivo explicando o que
          vai nela.
        </p>
        <div class="terminal reveal" style="--atraso: 80ms">
          <div class="terminal__topo" aria-hidden="true">
            <span class="terminal__ponto" style="background:#ff5f57"></span>
            <span class="terminal__ponto" style="background:#febc2e"></span>
            <span class="terminal__ponto" style="background:#28c840"></span>
          </div>
          {/* A coluna da esquerda tem 16 caracteres, que é o tamanho da maior
