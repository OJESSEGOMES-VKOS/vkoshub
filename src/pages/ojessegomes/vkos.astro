  /* ---------- o bloco da autonomia ---------- */
  /* Ele usa o mesmo painel das outras seções. Foi daqui que a camada
     saiu, e agora ela vale pra página inteira. */
  .autonomia__ilha {
    background: var(--superficie);
    border-radius: var(--raio-card);
    box-shadow: var(--sombra-card-alta);
    padding: clamp(28px, 5vw, 64px);
