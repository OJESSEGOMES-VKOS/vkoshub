  }

  .ciclo__nome {
    margin-top: var(--e-12);
    font-size: var(--t-titulo-sm);
    letter-spacing: -0.02em;
  }

  .ciclo__texto {
    margin-top: var(--e-12);
    color: var(--apoio);
    font-size: var(--t-corpo-sm);
    line-height: var(--altura-corpo);
  }

  /* ---------- comandos ---------- */
  .grupos {
    margin-top: var(--e-40);
    display: grid;
    gap: var(--e-32) var(--e-24);
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    align-items: start;
  }

  .grupo__nome {
    font-size: var(--t-legenda);
    color: var(--apoio);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-bottom: var(--e-8);
