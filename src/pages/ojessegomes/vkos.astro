          </div>
        </div>
      </div>
    </section>
  </main>

  <Rodape />
</Base>

<style>
  .limite {
    width: 100%;
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 40px);
  }

  /* ---------- heroi ---------- */
  /* O mesmo cinza dos painéis da página, aqui em faixa de ponta a ponta.
     Sem o pontilhado, de propósito: a textura do site é fixa e fica ATRÁS
     da página, e o fundo opaco da faixa já a tapa. A abertura é superfície
     limpa, e a única textura aqui é a da capa do cérebro. */
  .heroi {
    position: relative;
    padding-block: clamp(40px, 8vw, 72px) clamp(48px, 8vw, 88px);
    background: var(--superficie);
    color: var(--tinta);
  }

  .voltar {
    display: inline-flex;
    align-items: center;
    gap: var(--e-8);
    min-height: 44px;
    color: var(--apoio);
    font-size: var(--t-corpo-sm);
    text-decoration: none;
    transition: color var(--micro) var(--curva);
  }

  .voltar:hover {
    color: var(--tinta);
  }

  .heroi__grade {
    display: grid;
    gap: var(--e-40);
    align-items: center;
  }

  /* A partir daqui cabe a coluna dupla sem espremer nem o título nem a
     capa. Abaixo disso a capa ficaria estreita demais pro cérebro ler. */
  @media (min-width: 900px) {
    .heroi__grade {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--e-48);
    }

    .capa {
      margin-top: 0;
    }
  }

  .heroi__topo {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--e-12);
    margin-top: var(--e-32);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    color: var(--apoio);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-pilula);
    padding: 2px var(--e-8);
    font-size: var(--t-legenda);
  }

  /* A versão é dado vivo, então ela leva a menta, do mesmo jeito que o
     comando na lista. A borda acompanha, pra ela não flutuar solta ao
     lado da categoria. */
  .tag--versao {
    color: var(--menta-fundo);
    border-color: color-mix(in srgb, var(--menta) 40%, var(--linha-forte));
  }

  /* O selo colorido é só pra "Novo". Status usa o ponto de menta com texto. */
  .estado {
    display: inline-flex;
    align-items: center;
    gap: var(--e-8);
    font-size: var(--t-corpo-sm);
    color: var(--apoio);
  }

  .estado__ponto {
    width: 8px;
    height: 8px;
    border-radius: var(--raio-pilula);
    background: var(--menta);
    flex-shrink: 0;
  }

  h1 {
    margin-top: var(--e-16);
  }

  .heroi__resumo {
    max-width: 56ch;
    margin-top: var(--e-24);
    font-size: var(--t-corpo-lg);
    color: var(--apoio);
  }

  .heroi__meta {
    margin-top: var(--e-16);
    font-size: var(--t-legenda);
    color: var(--apoio);
  }

  /* ---------- capa ---------- */
  .capa {
    margin-top: var(--e-40);
    border-radius: var(--raio-card);
    overflow: hidden;
    box-shadow: var(--sombra-card);
  }

  /* O teto em svh é o que garante a abertura numa tela só. Em janela
     baixa a capa encolhe em altura, e o cérebro corta pelas bordas em vez
     de espremer, porque o SVG é desenhado em `slice`. */
  .capa__vazia {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 42svh;
    background: var(--carvao);
    overflow: hidden;
  }

  /* Notebook tem tela larga e baixa, e é onde a abertura estourava. Aqui
     o respiro e a tipografia cedem juntos pra ela caber inteira. */
  @media (min-width: 900px) and (max-height: 800px) {
    .heroi {
      padding-block: var(--e-24) var(--e-40);
    }

    .heroi__grade {
      gap: var(--e-32);
    }

    .heroi h1 {
      font-size: var(--t-titulo-lg);
    }

    .heroi__resumo {
      margin-top: var(--e-16);
      font-size: var(--t-corpo);
    }

    .heroi__topo {
      margin-top: var(--e-16);
    }
  }

  .capa__selo {
    position: absolute;
    left: var(--e-20);
    bottom: var(--e-16);
    display: inline-flex;
    align-items: center;
    gap: var(--e-8);
    font-size: var(--t-legenda);
    color: var(--sobre-painel);
  }

  .capa__ponto {
    width: 7px;
    height: 7px;
    border-radius: var(--raio-pilula);
    background: var(--menta);
  }

  /* ---------- seções ---------- */
  .secao {
    padding-block: clamp(48px, 8vw, 88px);
  }

  /* O painel: a camada que segura uma seção inteira.
     Seção que é só texto solto sobre o pontilhado do fundo lê como
     rascunho, não como página. Quem já tem grade de card (o ciclo, as
     obras, as conexões) fica de fora: a camada dela são os próprios
     cards, e painel dentro de painel só empilha borda sem função. */
  .painel {
    background: var(--superficie);
    border-radius: var(--raio-card);
    box-shadow: var(--sombra-card-alta);
    padding: clamp(28px, 5vw, 64px);
  }

  .secao h2 {
    font-size: var(--t-titulo);
    letter-spacing: -0.02em;
  }

  .secao__intro {
    max-width: 62ch;
    margin-top: var(--e-16);
    color: var(--apoio);
  }

  .prosa {
    max-width: 62ch;
    margin-top: var(--e-24);
    display: grid;
    gap: var(--e-16);
  }

  .prosa p {
    color: var(--apoio);
    font-size: var(--t-corpo-lg);
  }

  /* ---------- ciclo ---------- */
  .ciclo {
    list-style: none;
    margin: var(--e-40) 0 0;
    padding: 0;
    display: grid;
    gap: var(--e-24);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .ciclo__item {
    padding: var(--e-32) var(--e-24);
    background: var(--superficie);
    border-radius: var(--raio-card);
    box-shadow: var(--anel);
