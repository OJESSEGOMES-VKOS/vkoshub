  .obra__oque {
    color: var(--apoio);
    font-size: var(--t-corpo-sm);
    line-height: var(--altura-corpo);
  }

  .obra__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4) var(--e-16);
    margin-top: auto;
    padding-top: var(--e-12);
  }

  .obra__link {
    display: inline-flex;
    align-items: center;
    gap: var(--e-8);
    min-height: 44px;
    color: var(--menta-fundo);
    font-size: var(--t-corpo-sm);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--menta) 40%, transparent);
