    gap: 2px;
  }

  /* O comando é o dado vivo da página, então é ele que leva a menta.
     No escuro ela dá 11.74:1 contra a página, então aqui ela escreve. */
  .comando__cmd {
    color: var(--menta);
    font-size: var(--t-corpo-sm);
  }

  .comando__o {
    color: var(--apoio);
    font-size: var(--t-corpo-sm);
    line-height: var(--altura-corpo);
  }

  /* ---------- regras ---------- */
  .regras {
    list-style: none;
    margin: var(--e-40) 0 0;
    padding: 0;
    display: grid;
    gap: var(--e-24);
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .regra {
    padding-top: var(--e-20);
    border-top: 1px solid var(--linha);
  }

  .regra__titulo {
    font-size: var(--t-corpo-lg);
    letter-spacing: -0.01em;
  }

  .regra__texto {
    margin-top: var(--e-8);
    color: var(--apoio);
    font-size: var(--t-corpo-sm);
    line-height: var(--altura-corpo);
  }

  /* ---------- obras ---------- */
  /* Duas colunas no desktop em vez de três ou quatro. A capa é a foto de um
     site inteiro, então ela precisa de largura pra o texto dentro dela ainda
     dar pra ler. Card estreito aqui viraria borrão colorido. */
  .obras {
    list-style: none;
    margin: var(--e-40) 0 0;
    padding: 0;
    display: grid;
    gap: var(--e-32) var(--e-24);
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .obras {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .obra {
    display: flex;
    flex-direction: column;
    background: var(--superficie);
    border-radius: var(--raio-card);
    box-shadow: var(--anel);
    overflow: hidden;
  }

  .obra__capa {
    display: block;
    width: 100%;
    /* height:auto é obrigatório: com width e height fixos no atributo, que
       evitam o pulo do layout, o aspect-ratio sozinho é ignorado. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    background: var(--carvao);
    border-bottom: 1px solid var(--linha);
