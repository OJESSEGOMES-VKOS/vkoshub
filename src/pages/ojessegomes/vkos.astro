    font-size: var(--t-legenda);
    color: var(--apoio);
  }

  .autonomia__texto {
    max-width: 62ch;
    margin-top: var(--e-20);
    color: var(--apoio);
    line-height: var(--altura-corpo);
    text-wrap: pretty;
  }

  /* A tradução: o que a pessoa fala, e o comando que sobe sozinho. */
  .traducao {
    list-style: none;
    margin: var(--e-32) 0 0;
    padding: 0;
    display: grid;
    gap: var(--e-12);
