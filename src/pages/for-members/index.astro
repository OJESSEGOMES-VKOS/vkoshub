---
// A área de membros, v1 beta (MVP, 2026-11-13). Ainda sem login: é uma página
// privada (fora do Google e do mapa do site) que junta, num lugar só, o que o
// membro já tem. A barra de cima mora em src/components/MembrosTopo.astro.
import Base from '../../layouts/Base.astro';
import MembrosTopo from '../../components/MembrosTopo.astro';
import '../../styles/vidro-home.css';
import '../../styles/membros.css';

const atalhos = [
  {
    nome: 'Bem-vindo',
    texto: 'A instalação passo a passo no Windows ou no Mac. Comece por aqui.',
    href: '/bem-vindo',
  },
  {
    nome: 'Biblioteca de estilos',
    texto: 'Todos os modelos de edição e estilos de cena, com o vídeo de cada um.',
    href: '/biblioteca-estilos',
  },
  {
    nome: 'DIY',
    texto: 'Playbooks passo a passo pra você criar junto com o Claude.',
    href: '/for-members/diy',
  },
  {
    nome: 'Free skills',
    texto: 'Skills gratuitas pro Claude, com o passo a passo pra instalar.',
    href: '/free-skills',
  },
];
---

<Base titulo="Área de membros | VKOSHUB" descricao="A área de membros do VKOSHUB." privada>
  <div class="vidro-fundo" aria-hidden="true"><i></i><i></i><i></i></div>
  <MembrosTopo />

  <main id="conteudo" class="membros">
    <section class="limite abre">
      <p class="beta">Beta</p>
      <h1>Área de <span class="destaque">membros</span></h1>
      <p class="abre__sub">Tudo o que você tem no VKOSHUB, num lugar só. Ela vai crescer com o Hub.</p>
    </section>

    <section class="limite" aria-label="Atalhos">
      <ul class="grade" role="list">
        {atalhos.map((a) => (
          <li>
            {a.breve ? (
              <a class="atalho atalho--breve" aria-disabled="true">
                <span class="atalho__nome">{a.nome} <small>em breve</small></span>
                <span class="atalho__texto">{a.texto}</span>
              </a>
            ) : (
              <a class="atalho" href={a.href} data-umami-event="membros-atalho" data-umami-event-item={a.nome}>
                <span class="atalho__nome">{a.nome}</span>
                <span class="atalho__texto">{a.texto}</span>
                <span class="atalho__seta" aria-hidden="true">&rarr;</span>
              </a>
            )}
          </li>
        ))}
      </ul>

      <a
        class="comunidade"
        href="https://chat.whatsapp.com/FHbZNGlJgCL3dGtdGswpRL"
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="comunidade"
        data-umami-event-local="membros"
      >
        <span class="comunidade__icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z" /></svg>
        </span>
        <span class="comunidade__texto">
          <strong>Comunidade no WhatsApp</strong>
          <span>Dúvidas, novidades do Hub e quem usa junto.</span>
        </span>
        <span class="comunidade__seta" aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </main>
</Base>

