  const copiar = async (b: HTMLButtonElement) => {
    const pre = document.getElementById(b.dataset.copiarDe || '');
    const rotulo = b.querySelector('[data-rotulo]') as HTMLElement;
    const antes = rotulo.textContent;
    try {
      await navigator.clipboard.writeText(pre?.textContent ?? '');
      rotulo.textContent = 'Copiado!';
      b.classList.add('ok');
    } catch {
      (pre?.closest('details') as HTMLDetailsElement | null)?.setAttribute('open', '');
      rotulo.textContent = 'Selecione e copie';
    }
    setTimeout(() => {
      rotulo.textContent = antes;
      b.classList.remove('ok');
    }, 1800);
  };
  document.querySelectorAll<HTMLButtonElement>('[data-copiar-de]').forEach((b) => b.addEventListener('click', () => copiar(b)));

  // "Marcar como feito": fica salvo só neste navegador. Sem acesso ao
  // armazenamento, funciona até fechar a página.
  const CHAVE = 'diy-animacoes-feitos';
  let feitos: number[] = [];
  try {
    feitos = JSON.parse(localStorage.getItem(CHAVE) || '[]');
  } catch {
    feitos = [];
  }
  const total = 6;

  // O mapa do topo e o endereço com # abrem o passo escolhido.
  const abrirPasso = (id: string) => {
    const d = document.getElementById(id);
    if (d instanceof HTMLDetailsElement) d.open = true;
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-mapa]').forEach((a) => a.addEventListener('click', () => abrirPasso(a.hash.slice(1))));
  if (location.hash) abrirPasso(location.hash.slice(1));
  addEventListener("hashchange", () => abrirPasso(location.hash.slice(1)));

  const desenhar = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-feito]').forEach((b) => {
      const sim = feitos.includes(Number(b.dataset.feito));
      b.setAttribute('aria-pressed', String(sim));
      (b.querySelector('span') as HTMLElement).textContent = sim ? 'Feito' : 'Marcar como feito';
    });
    document.querySelectorAll<HTMLElement>('[data-mapa]').forEach((a) => a.classList.toggle('feito', feitos.includes(Number(a.dataset.mapa))));
    const n = feitos.length;
    (document.querySelector('[data-progresso]') as HTMLElement).textContent = String(n);
    (document.querySelector('[data-progresso-barra]') as HTMLElement).style.width = `${(n / total) * 100}%`;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-feito]').forEach((b) =>
    b.addEventListener('click', () => {
      const n = Number(b.dataset.feito);
      feitos = feitos.includes(n) ? feitos.filter((x) => x !== n) : [...feitos, n];
      try {
        localStorage.setItem(CHAVE, JSON.stringify(feitos));
      } catch {
        /* sem armazenamento: segue só nesta visita */
      }
      desenhar();
      // Marcou como feito: abre o próximo passo e leva a pessoa até ele.
      if (feitos.includes(n) && n < total) {
        abrirPasso(`passo-${n + 1}`);
        document.getElementById(`passo-${n + 1}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }),
  );
  desenhar();

  // As abas do passo 6 (2D ou 3D). Sem JavaScript os dois pedidos ficam à vista.
  document.querySelectorAll<HTMLElement>('[data-formatos]').forEach((raiz) => {
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = [...raiz.querySelectorAll<HTMLElement>('[data-painel]')];
    const abrir = (n: number, foco = false) => {
      abas.forEach((a, i) => {
        a.setAttribute('aria-selected', String(i === n));
        a.tabIndex = i === n ? 0 : -1;
        paineis[i].hidden = i !== n;
      });
      if (foco) abas[n].focus();
    };
    abas.forEach((a, i) => {
      a.addEventListener('click', () => abrir(i));
      a.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') abrir((i + 1) % abas.length, true);
        if (e.key === 'ArrowLeft') abrir((i - 1 + abas.length) % abas.length, true);
      });
    });
    raiz.classList.add('com-abas');
    abrir(0);
  });
</script>
