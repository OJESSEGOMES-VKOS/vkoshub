---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Antigas from '../components/Antigas.astro';
import ClaudeFlutuante from '../components/ClaudeFlutuante.astro';
import Player from '../components/Player.astro';
import BotaoAssinar from '../components/BotaoAssinar.astro';
import FluxoModelos from '../components/FluxoModelos.astro';
import '../styles/vidro-home.css';
import Vitrine from '../components/Vitrine.astro';
import { modulos, demo } from '../data/hub.js';

// Os tipos de vídeo que já têm exemplo pra mostrar.
const tipos = modulos.filter((m) => m.exemplos.length > 0);

const titulo = 'VKOSHUB | Os sistemas de IA que criam e editam os seus vídeos';
const descricao =
  'Sistemas prontos pro Claude editar reels, montar vídeo pro YouTube e criar anúncio em motion.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'VKOSHUB',
  description: descricao,
  brand: { '@type': 'Brand', name: 'OJESSEGOMES' },
  offers: {
    '@type': 'Offer',
    name: 'Acesso vitalício (preço fundador)',
    price: '47.00',
    priceCurrency: 'BRL',
    url: new URL('/assinar', Astro.site).href,
  },
};


const faq = [
  {
    p: 'Preciso saber editar vídeo?',
    r: 'Não. As aulas partem do zero e o Claude faz a parte técnica. Você aprende a dar a instrução certa e a revisar o resultado.',
  },
  {
    p: 'Funciona no celular?',
    r: 'As aulas abrem no celular. A edição com Claude e o motion pedem computador.',
  },
  {
    p: 'Como recebo o acesso?',
    r: 'Depois do pagamento na Hubla, o acesso às aulas é liberado na própria Hubla, no email que você usou na compra.',
  },
  {
    p: 'Quanto custa e por quanto tempo vale?',
    r: 'R$47 de uma vez (de R$97), no preço de fundador. O acesso é vitalício, com todas as atualizações que o Hub receber.',
  },
  {
    p: 'O que entra de novo enquanto eu sou assinante?',
    r: 'O Hub é atualizado constantemente com aulas, recursos, modelos, projetos e métodos. O que entrar fica disponível pra você, já que o acesso é vitalício.',
  },
  {
    p: 'E se eu não gostar?',
    r: 'Você tem 7 dias de garantia. Pediu dentro do prazo, recebe o dinheiro de volta.',
  },
];
---

<Base titulo={titulo} descricao={descricao} schema={schema}>
  <div class="vidro-fundo" aria-hidden="true"><i></i><i></i><i></i></div>
  <Cabecalho checkout />

  <main id="conteudo">
    {/* 01. Hero */}
    <section class="hero" aria-labelledby="hero-titulo">
      <div class="hero__luz" aria-hidden="true"></div>
      <div class="limite">
        <div class="hero__corpo">
          <div class="hero__texto">
            <Antigas />
            <h1 id="hero-titulo" class="hero__titulo">
              Os sistemas de IA que criam e editam <span class="hero__sozinho">os seus vídeos.<svg class="hero__risco" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 16 C 50 6, 120 4, 196 12" /></svg></span>
            </h1>
            <p class="hero__sub">
              Sistemas prontos pro Claude editar reels, montar vídeo pro YouTube e
              criar anúncio em motion.
            </p>
            <p class="hero__so">
              <span><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M1 2.3l5.7-.8v5.6H1zM7.5 1.4L15 .3v6.8H7.5zM1 8h5.7v5.6L1 12.8zM7.5 8H15v6.8l-7.5-1.1z" fill="currentColor" /></svg> Windows</span>
              <span><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M11 .5c.1 1-.3 2-.9 2.6-.6.7-1.5 1.2-2.4 1.1-.1-1 .4-2 .9-2.6.6-.6 1.6-1.1 2.4-1.1zM13.9 11.6c-.4.9-.6 1.3-1.1 2.1-.7 1.1-1.8 2.4-3 2.4-1.1 0-1.4-.7-2.9-.7s-1.8.7-2.9.7c-1.3 0-2.2-1.2-2.9-2.3C-.9 10.7-.9 6.6 1.6 5c.9-.6 2-1 3.1-1 1.2 0 1.9.7 2.9.7.9 0 1.5-.7 2.9-.7 1 0 2.1.6 2.8 1.5-2.5 1.4-2.1 5 .6 6.1z" fill="currentColor" /></svg> Mac</span>
              <em>Funciona nos dois</em>
            </p>
          </div>

          {demo.mp4 && (
            <div class="demo" data-carrossel>
              <ClaudeFlutuante />
              {[
                // Modelos e estilos de cena intercalados. Os estilos são 4:5 no
                // original: aqui vão na versão 9:16 de public/guia/cenas-916/.
                { src: '/guia/modelos/minidocumentario.mp4', poster: '/guia/modelos/minidocumentario.jpg' },
                { src: '/guia/cenas-916/cena41.mp4', poster: '/guia/cenas-916/cena41.webp' },
                { src: '/guia/modelos/especialista.mp4', poster: '/guia/modelos/especialista.jpg' },
                { src: '/guia/cenas-916/cena42.mp4', poster: '/guia/cenas-916/cena42.webp' },
                { src: '/guia/modelos/pagina-de-livro.mp4', poster: '/guia/modelos/pagina-de-livro.jpg' },
                { src: '/guia/cenas-916/cena18.mp4', poster: '/guia/cenas-916/cena18.webp' },
              ].map((v, i) => (
                <video
                  class="demo__item"
                  data-pos={i}
                  poster={v.poster}
                  muted
                  loop
                  playsinline
                  preload={i === 0 ? 'auto' : 'metadata'}
                  autoplay={i === 0}
                  aria-hidden="true"
                >
                  <source src={v.src} type="video/mp4" />
                </video>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    {/* 04. Os sistemas, um por tipo de vídeo, com o que já saiu deles */}
    <section class="secao modulos" id="modulos" aria-labelledby="modulos-titulo">
      <div class="limite">
        <div class="trilhas reveal">
          <span class="rotulo">Edição com IA</span>
          <span class="trilhas__mais" aria-hidden="true">+</span>
          <span class="so-leitor">e</span>
          <span class="rotulo">Criação com IA</span>
        </div>
        <h2 id="modulos-titulo" class="modulos__titulo reveal">
          Crie todo tipo de vídeo <span class="destaque">usando apenas 1 sistema.</span>
        </h2>

        {/* Um palco só: as abas trocam o tipo de vídeo, os exemplos ficam numa fileira. */}
        <div class="palco-v reveal" data-tipos>
          <div class="tipos" role="tablist" aria-label="Tipos de vídeo">
            {tipos.map((m, i) => (
              <button
                class="tipo"
                type="button"
                role="tab"
                id={`tipo-${m.n}`}
                aria-controls={`painel-${m.n}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-umami-event="tipo-video"
                data-umami-event-tipo={m.estilo}
              >
                {m.estilo}
              </button>
            ))}
          </div>

          {tipos.map((m) => (
            <div
              class="painel"
              role="tabpanel"
              id={`painel-${m.n}`}
              aria-labelledby={`tipo-${m.n}`}
              data-painel
              style={`--soma:${m.exemplos.reduce((t, e) => t + (e.deitado ? 16 / 9 : 9 / 16), 0).toFixed(4)};--n:${m.exemplos.length}`}
            >
              <h3 class="painel__nome">{m.estilo}</h3>
              <p class="painel__texto">{m.texto}</p>
              <ul class="galeria" role="list">
                {m.exemplos.map((e, i) => (
                  <li class:list={['exemplo', e.deitado ? 'exemplo--deitado' : 'exemplo--em-pe']}>
                    <Player src={e.src} poster={e.poster} rotulo={`${m.estilo}, exemplo ${i + 1}`} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 04a. A vitrine: a mesma fala editada com e sem rosto */}
    <Vitrine />

    {/* 04b. O fluxo: manda o vídeo, escolhe o modelo, o Claude edita */}
    <FluxoModelos />

    {/* 08. A oferta + 09. Garantia: a cena do preço, num card só */}
    <section class="secao oferta" id="oferta" aria-labelledby="oferta-titulo">
      <div class="limite">
        <article class="palco reveal reveal--escala">
          <header class="palco__cabeca">
            <p class="palco__selo mono">Founders</p>
            <p class="palco__marca" aria-hidden="true"><img class="palco__logo" src="/logo.png" alt="" width="64" height="64" /><span>VKOS<span class="palco__hub">HUB</span></span></p>
            <h2 id="oferta-titulo" class="so-leitor">Acesso vitalício ao VKOSHUB no preço fundador: de R$97 por R$47.</h2>
          </header>

          <div class="palco__pacote">
            <p class="pacote__grupo mono">O que você leva</p>
            <ul class="pacote" role="list">
              <li>O sistema que o Claude usa para criar e editar os seus vídeos.</li>
              <li>+19 modelos de edição, mais atualizações recorrentes</li>
              <li>+46 estilos de cena pra usar no meio de qualquer vídeo</li>
              <li>Agente Orquestrador de Conteúdo: pesquisa, direção e roteirização</li>
            </ul>

            <p class="pacote__grupo mono">Aulas</p>
            <ul class="pacote" role="list">
              <li>Como usar o sistema em reels, vídeos pro YouTube e anúncios em motion</li>
              <li>Como criar os seus próprios modelos, pra você e para os seus clientes</li>
            </ul>
          </div>

          <div class="palco__valor-bloco">
            <p class="palco__de" aria-hidden="true">de <s>R$97</s> por</p>
            <p class="palco__numero">
              <span class="palco__moeda" aria-hidden="true">R$</span><span class="palco__valor" aria-hidden="true">47</span><span class="palco__lado"><span class="palco__centavos" aria-hidden="true">,00</span></span>
            </p>
            <p class="palco__vitalicio mono">Acesso vitalício</p>

            <div class="palco__cta">
              <BotaoAssinar grande checkout local="oferta" />
              <p class="cta__nota">Ferramentas de IA contratadas à parte.</p>
            </div>
          </div>

          <footer class="garantia">
            <svg class="garantia__selo" viewBox="0 0 160 160" aria-hidden="true" focusable="false">
              <defs>
                <path id="garantia-volta" d="M80 80 m -60 0 a 60 60 0 1 1 120 0 a 60 60 0 1 1 -120 0" />
              </defs>
              <circle cx="80" cy="80" r="76" class="garantia__borda" />
              <g class="garantia__giro">
                <text class="garantia__volta">
                  <textPath href="#garantia-volta" textLength="372" lengthAdjust="spacing">7 dias de garantia • 7 dias de garantia •</textPath>
                </text>
              </g>
              <circle cx="80" cy="80" r="46" class="garantia__disco" />
              <text x="80" y="92" text-anchor="middle" class="garantia__n">7</text>
              <text x="80" y="110" text-anchor="middle" class="garantia__d">DIAS</text>
            </svg>
            <div>
              <h3 id="garantia-titulo" class="garantia__titulo">7 dias pra testar. Se não te servir, seu dinheiro de volta.</h3>
            </div>
          </footer>
        </article>
      </div>
    </section>

    {/* 10. Perguntas frequentes */}
    <section class="secao faq" id="perguntas" aria-labelledby="faq-titulo">
      <div class="limite faq__grade">
        <h2 id="faq-titulo" class="faq__titulo reveal">Perguntas frequentes</h2>
        <div class="faq__lista reveal">
          {
            faq.map((item) => (
              <details class="faq__item">
                <summary data-umami-event="faq" data-umami-event-pergunta={item.p}>
                  <span>{item.p}</span>
                  <span class="faq__sinal" aria-hidden="true" />
                </summary>
                <p>{item.r}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Rodape />
</Base>

<script>
  // As abas do palco de vídeos. Sem JavaScript, os quatro painéis aparecem um embaixo do outro.
  document.querySelectorAll<HTMLElement>('[data-tipos]').forEach((raiz) => {
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = [...raiz.querySelectorAll<HTMLElement>('[data-painel]')];
    const abrir = (n: number, foco = false) => {
      abas.forEach((aba, i) => {
        aba.setAttribute('aria-selected', i === n ? 'true' : 'false');
        aba.tabIndex = i === n ? 0 : -1;
        paineis[i].hidden = i !== n;
      });
      if (foco) abas[n].focus();
    };
    abas.forEach((aba, i) => {
      aba.addEventListener('click', () => abrir(i));
      aba.addEventListener('keydown', (ev) => {
        if (ev.key === 'ArrowRight') abrir((i + 1) % abas.length, true);
        if (ev.key === 'ArrowLeft') abrir((i - 1 + abas.length) % abas.length, true);
      });
    });
    raiz.classList.add('com-abas');
    abrir(0);
  });
</script>

<script>
  // O leque da hero: seis vídeos, o da frente toca e a cada 10 s o da direita
  // vem pra frente. Clicar num vídeo do lado traz ele pra frente. Para enquanto o
  // mouse está em cima, e fica parado de vez pra quem pede menos movimento.
  const leque = document.querySelector<HTMLElement>('[data-carrossel]');
  if (leque) {
    const videos = [...leque.querySelectorAll<HTMLVideoElement>('video')];
    const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let parado = false;

    const avancar = (passos: number) => {
      videos.forEach((v) => {
        const pos = (Number(v.dataset.pos) + videos.length - (passos % videos.length)) % videos.length;
        v.dataset.pos = String(pos);
        if (pos === 0 && !reduz) {
          v.currentTime = 0;
          void v.play();
        } else {
          v.pause();
        }
      });
    };

    if (reduz) {
      videos.forEach((v) => v.pause());
    } else {
      leque.addEventListener('mouseenter', () => (parado = true));
      leque.addEventListener('mouseleave', () => (parado = false));
      setInterval(() => {
        if (parado || document.hidden) return;
        avancar(1);
      }, 10000);
    }

    videos.forEach((v) => {
      v.addEventListener('click', () => {
        const pos = Number(v.dataset.pos);
        if (pos > 0) avancar(pos);
      });
    });
  }
</script>

<style>
  /* A menta como ênfase de palavra: cor sólida, nunca gradiente no texto.
     Cada título de decisão ganha UMA frase acesa, a que a pessoa leva. */
  .destaque {
    color: var(--menta);
  }

  /* ---------- 01. Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(40px, 8vw, 96px);
    padding-bottom: var(--gap-secao);
    overflow: hidden;
  }

  /* A luz do topo: duas manchas de menta atrás do título e do vídeo.
     É o que tira a página do preto chapado sem trazer cor nova. */
  .hero__luz {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(46% 38% at 50% 16%, var(--menta-veu), transparent 72%),
      radial-gradient(34% 34% at 50% 72%, var(--menta-brilho), transparent 70%);
    /* A luz some aos poucos no pé da seção, em vez de ser cortada na borda. */
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 96%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 96%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__luz {
      animation: respira 9s ease-in-out infinite alternate;
    }
  }

  @keyframes respira {
    from {
      opacity: 0.75;
      transform: translate3d(0, 0, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(-2%, 2%, 0);
    }
  }

  /* O título em 700, apertado: é a frase com mais força da página. */
  .hero__titulo {
    font-size: clamp(2.5rem, 5.6vw, 5.25rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 22ch;
    margin-inline: auto;
    text-wrap: balance;
    /* Sombra curta e colada nas letras: solta o título do que passa atrás. */
    text-shadow: 0 2px 20px rgba(0, 0, 0, 1), 0 2px 20px rgba(0, 0, 0, 1);
  }

  /* No celular o título manda: maior. */
  @media (max-width: 760px) {
    .hero__titulo {
      font-size: clamp(2.5rem, 11.5vw, 3.5rem);
      letter-spacing: -0.04em;
    }
  }

  /* "Sozinho." com o risco de caneta embaixo, desenhado na chegada. */
  .hero__sozinho {
    position: relative;
    display: inline-block;
    color: var(--menta);
    white-space: nowrap;
  }

  .hero__risco {
    position: absolute;
    left: -2%;
    bottom: -0.2em;
    width: 104%;
    height: 0.28em;
    overflow: visible;
  }

  .hero__risco path {
    fill: none;
    stroke: var(--menta);
    stroke-width: 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* O risco é revelado da esquerda pra direita, como caneta passando.
     Funciona com frase de qualquer tamanho, sem traço partido. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__risco {
      animation: risca 1.1s 0.5s var(--curva) both;
    }
  }

  @keyframes risca {
    from {
      clip-path: inset(-50% 100% -50% 0);
    }
    to {
      clip-path: inset(-50% 0 -50% 0);
    }
  }

  .hero__corpo {
    display: grid;
    justify-items: center;
    gap: clamp(48px, 6vw, 72px);
  }

  .hero__texto {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero__sub {
    margin: var(--e-32) auto 0;
    font-size: var(--t-corpo-lg);
    line-height: 1.65;
    color: var(--tinta-suave);
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* ---------- Demonstração ---------- */
  /* O vídeo fica do mesmo tamanho. Atrás dele, dois quadros em leque,
     como uma pilha de reels: dá volume e movimento sem crescer a peça. */
  .demo {
    position: relative;
    justify-self: center;
    /* Nunca mais alto que 52% da tela: o vídeo acompanha o título, não engole a hero.
       A medida mora aqui pra os quadros de trás terem exatamente o tamanho dele. */
    width: min(100%, 240px, calc(52svh * 9 / 16));
  }

  /* Seis vídeos de verdade em leque (cinco à vista): o da frente toca, dois de cada lado fazem
     volume. A cada 10 segundos o da direita vem pra frente; o que estava na
     frente pausa e vai pra trás, do lado esquerdo. Posições: 0 frente, 1 e 2
     à direita (perto e longe), 3 e 4 à esquerda (longe e perto). */
  .demo {
    aspect-ratio: 9 / 16;
  }

  .demo__item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--raio-card);
    background: var(--carvao);
    box-shadow:
      0 0 0 1px var(--linha-forte),
      0 20px 40px -20px rgba(0, 0, 0, 0.9);
    transition:
      transform 0.8s var(--curva),
      filter 0.8s var(--curva),
      opacity 0.8s var(--curva),
      box-shadow 0.8s var(--curva);
  }

  .demo__item:not([data-pos='0']) {
    cursor: pointer;
  }

  .demo__item[data-pos='0'] {
    z-index: 5;
    box-shadow:
      0 0 0 1px var(--menta-linha),
      0 30px 70px -30px color-mix(in srgb, var(--menta) 45%, transparent),
      0 20px 40px -20px rgba(0, 0, 0, 0.9);
  }

  .demo__item[data-pos='1'] {
    z-index: 4;
    transform: rotate(7deg) translate(34%, 3%) scale(0.88);
    filter: brightness(0.55) saturate(0.9);
  }

  .demo__item[data-pos='5'] {
    z-index: 4;
    transform: rotate(-7deg) translate(-34%, 3%) scale(0.88);
    filter: brightness(0.55) saturate(0.9);
  }

  .demo__item[data-pos='2'] {
    z-index: 3;
    transform: rotate(13deg) translate(62%, 9%) scale(0.76);
    filter: brightness(0.38) saturate(0.85);
  }

  .demo__item[data-pos='4'] {
    z-index: 3;
    transform: rotate(-13deg) translate(-62%, 9%) scale(0.76);
    filter: brightness(0.38) saturate(0.85);
  }

  /* Com seis vídeos, o sexto espera escondido atrás do da frente. */
  .demo__item[data-pos='3'] {
    z-index: 1;
    opacity: 0;
    transform: scale(0.7);
    pointer-events: none;
  }

  .demo__item:not([data-pos='0']):hover {
    filter: brightness(0.75) saturate(1);
  }

  /* No desktop o leque abre mais: os vídeos dos lados se afastam do central e
     os de fora quase saem do quadro, com menos sobreposição. */
  @media (min-width: 900px) {
    .demo__item[data-pos='1'] {
      transform: rotate(6deg) translate(58%, 3%) scale(0.9);
    }

    .demo__item[data-pos='5'] {
      transform: rotate(-6deg) translate(-58%, 3%) scale(0.9);
    }

    .demo__item[data-pos='2'] {
      transform: rotate(11deg) translate(116%, 8%) scale(0.8);
    }

    .demo__item[data-pos='4'] {
      transform: rotate(-11deg) translate(-116%, 8%) scale(0.8);
    }
  }

  /* No celular o leque inteiro cabe na tela: o vídeo da frente encolhe e os quatro
     dos lados ficam mais juntos. Os cinco aparecem completos, sem cortar na borda. */
  @media (max-width: 560px) {
    .demo {
      width: min(34vw, 150px);
    }

    .demo__item[data-pos='1'] {
      transform: rotate(6deg) translate(46%, 3%) scale(0.9);
    }

    .demo__item[data-pos='5'] {
      transform: rotate(-6deg) translate(-46%, 3%) scale(0.9);
    }

    .demo__item[data-pos='2'] {
      transform: rotate(11deg) translate(92%, 8%) scale(0.8);
    }

    .demo__item[data-pos='4'] {
      transform: rotate(-11deg) translate(-92%, 8%) scale(0.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo__item {
      transition: none;
    }
  }

  /* ---------- 04. Módulos ---------- */
  /* O pé mais curto: o fluxo de modelos logo abaixo continua esta seção. */
  /* O fundo da seção sobe um degrau (#101010) e some nas duas bordas num
     esmaecido longo, sem corte: a curva tem vários pontos pra não marcar faixa. */
  .modulos {
    --fundo: #101010;
    --fade: clamp(140px, 18vw, 260px);
    padding-bottom: clamp(24px, 4vw, 48px);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--fundo) 0%, transparent) 0,
      color-mix(in srgb, var(--fundo) 6%, transparent) calc(var(--fade) * 0.2),
      color-mix(in srgb, var(--fundo) 25%, transparent) calc(var(--fade) * 0.45),
      color-mix(in srgb, var(--fundo) 62%, transparent) calc(var(--fade) * 0.72),
      color-mix(in srgb, var(--fundo) 90%, transparent) calc(var(--fade) * 0.9),
      var(--fundo) var(--fade),
      var(--fundo) calc(100% - var(--fade)),
      color-mix(in srgb, var(--fundo) 90%, transparent) calc(100% - var(--fade) * 0.9),
      color-mix(in srgb, var(--fundo) 62%, transparent) calc(100% - var(--fade) * 0.72),
      color-mix(in srgb, var(--fundo) 25%, transparent) calc(100% - var(--fade) * 0.45),
      color-mix(in srgb, var(--fundo) 6%, transparent) calc(100% - var(--fade) * 0.2),
      color-mix(in srgb, var(--fundo) 0%, transparent) 100%
    );
  }

  .olho--centro {
    display: flex;
    width: fit-content;
    margin: 0 auto var(--e-16);
  }

  .modulos__titulo {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.03em;
    max-width: 32ch;
    margin-inline: auto;
    text-align: center;
    margin-bottom: var(--e-20);
  }

  /* As duas trilhas, lado a lado, logo abaixo do título. */
  .trilhas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--e-12);
    margin: 0 auto var(--e-20);
  }

  .trilhas .rotulo {
    padding: 6px 14px;
    border-radius: var(--raio-pilula);
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: var(--t-corpo-sm);
  }

  .trilhas__mais {
    color: var(--menta);
    font-family: var(--fonte-mono);
    font-size: var(--t-corpo);
  }

  /* ---------- o palco: um tipo de vídeo por vez ---------- */
  .palco-v {
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    margin-top: var(--e-32);
    padding: clamp(16px, 3vw, 40px);
    border-radius: clamp(24px, 3vw, 36px);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.015) 45%),
      rgba(14, 20, 18, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 30px 70px -36px rgba(0, 0, 0, 0.8);
  }

  /* As abas: um controle segmentado de vidro. */
  .tipos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    padding: 4px;
    border-radius: 22px;
    background: rgba(0, 0, 0, 0.35);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 760px) {
    .tipos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-radius: var(--raio-pilula);
    }
  }

  .tipo {
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: 18px;
    background: transparent;
    color: var(--tinta-suave);
    font: inherit;
    font-size: var(--t-corpo-sm);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background var(--micro) var(--curva),
      color var(--micro) var(--curva);
  }

  @media (min-width: 760px) {
    .tipo {
      border-radius: var(--raio-pilula);
    }
  }

  .tipo:hover {
    color: var(--tinta);
  }

  .tipo[aria-selected='true'] {
    background: var(--menta);
    color: #06140e;
  }

  .tipo:focus-visible {
    outline: 2px solid var(--menta);
    outline-offset: 2px;
  }

  /* Sem JavaScript as abas não trocam nada: somem, e cada painel mostra o próprio nome. */
  .palco-v:not(.com-abas) .tipos {
    display: none;
  }

  .painel {
    container-type: inline-size;
    display: grid;
    gap: clamp(16px, 2.4vw, 28px);
  }

  .painel[hidden] {
    display: none;
  }

  .painel__nome {
    margin: 0;
    font-size: var(--t-titulo-sm);
    letter-spacing: -0.03em;
    text-align: center;
  }

  .com-abas .painel__nome {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .painel__texto {
    margin: 0 auto;
    max-width: 52ch;
    color: var(--tinta-suave);
    text-align: center;
    text-wrap: balance;
  }

  /* A fileira: todos os vídeos na mesma altura, cada um na proporção real.
     A altura sai da largura do painel, pra fileira inteira sempre caber. */
  .galeria {
    --vao: var(--e-16);
    --altura: 340px;
    --altura: min(440px, calc((100cqw - (var(--n) - 1) * var(--vao)) / var(--soma)));
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: var(--vao);
  }

  .exemplo {
    flex: none;
    height: var(--altura);
    overflow: hidden;
    border-radius: var(--raio-card-sm);
    background: var(--carvao);
    box-shadow: var(--anel);
  }

  .exemplo--em-pe {
    aspect-ratio: 9 / 16;
  }

  .exemplo--deitado {
    aspect-ratio: 16 / 9;
  }

  /* No celular: os em pé lado a lado, o deitado na largura toda, embaixo. Nada rola pro lado. */
  @media (max-width: 759px) {
    .galeria {
      --vao: var(--e-12);
      flex-wrap: wrap;
    }

    .exemplo {
      height: auto;
    }

    .exemplo--em-pe {
      flex: 0 1 calc(50% - var(--vao) / 2);
    }

    .exemplo--deitado {
      flex: 1 1 100%;
      order: 2;
    }
  }

  /* ---------- 08 + 09. A oferta: um card só ---------- */
  /* Tudo que decide a compra num objeto: o que vem, por que custa isso,
     o número, o botão e a garantia no rodapé. Escuro como a página, com a
     menta acesa na borda; o ponto mais claro da cena é o botão. */
  .oferta {
    position: relative;
    isolation: isolate;
  }

  .oferta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(40% 50% at 50% 45%, var(--menta-brilho), transparent 72%);
    pointer-events: none;
  }

  .palco {
    position: relative;
    max-width: 780px;
    margin-inline: auto;
    border-radius: calc(var(--raio-card) + 12px);
    background:
      radial-gradient(90% 40% at 50% 0%, color-mix(in srgb, var(--menta) 12%, transparent), transparent 70%),
      linear-gradient(180deg, #121212, var(--carvao));
    box-shadow:
      0 0 0 1px var(--menta-linha),
      0 0 0 6px var(--menta-veu),
      0 50px 120px -50px color-mix(in srgb, var(--menta) 55%, transparent);
    text-align: center;
    overflow: hidden;
  }

  /* Uma linha de luz no topo da borda: o card parece aceso por cima. */
  .palco::before {
    content: '';
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--menta), transparent);
  }

  .palco__cabeca,
  .palco__pacote,
  .palco__valor-bloco {
    padding-inline: clamp(20px, 6vw, 64px);
  }

  .palco__cabeca {
    display: grid;
    justify-items: center;
    gap: var(--e-16);
    padding-top: clamp(32px, 6vw, 56px);
  }

  .palco__selo {
    margin: 0;
    padding: 6px 14px;
    border-radius: var(--raio-pilula);
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: var(--t-legenda);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .palco__marca {
    display: inline-flex;
    align-items: center;
    gap: 0.22em;
    margin: var(--e-4) 0 0;
    font-size: clamp(2.75rem, 9vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--tinta);
  }

  .palco__logo {
    width: 0.92em;
    height: 0.92em;
    filter: drop-shadow(0 0 18px var(--menta-linha));
  }

  .palco__hub {
    color: var(--menta);
  }

  .palco__titulo {
    max-width: 40ch;
    font-size: var(--t-corpo-lg);
    letter-spacing: -0.01em;
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  /* ---------- o pacote ---------- */
  .palco__pacote {
    margin-top: clamp(32px, 5vw, 48px);
  }

  .palco__rotulo {
    margin: 0 auto var(--e-20);
    font-size: var(--t-legenda);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--apoio);
  }

  .pacote {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 560px;
    margin-inline: auto;
    text-align: left;
  }


  /* O nome do grupo do pacote: Aulas, Projetos de IA, Bônus. */
  .pacote__grupo {
    max-width: 560px;
    margin: var(--e-32) auto var(--e-4);
    font-size: var(--t-legenda);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: left;
    color: var(--menta);
  }

  .pacote__grupo:first-child {
    margin-top: 0;
  }

  .pacote__fundador {
    color: var(--menta);
    font-weight: 600;
  }

  .pacote li {
    gap: var(--e-12);
    position: relative;
    padding: var(--e-12) 0 var(--e-12) 40px;
    border-bottom: 1px solid var(--linha);
    color: var(--tinta);
    font-size: var(--t-corpo-sm);
    line-height: 1.45;
    display: flex;
    align-items: center;
    min-height: 52px;
  }


  /* Disco menta com visto escuro. */
  .pacote li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-radius: var(--raio-pilula);
    background: var(--menta-solida);
    box-shadow: 0 0 12px var(--menta-linha);
  }

  .pacote li::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 50%;
    width: 9px;
    height: 5px;
    margin-top: -4px;
    border-left: 2px solid var(--sobre-menta);
    border-bottom: 2px solid var(--sobre-menta);
    transform: rotate(-45deg);
  }

  /* ---------- o valor ---------- */
  .palco__valor-bloco {
    display: grid;
    justify-items: center;
    margin-top: clamp(32px, 5vw, 48px);
    padding-top: clamp(32px, 5vw, 48px);
    padding-bottom: clamp(32px, 5vw, 48px);
    border-top: 1px solid var(--linha);
  }

  /* ---------- o preço (igual ao /info) ---------- */
  .palco__numero {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin: var(--e-24) 0 0;
    /* No celular o número cresce com a tela: é o ponto alto do card. */
    font-size: clamp(6rem, 28vw, 9rem);
    font-weight: var(--peso-medio);
    line-height: 0.9;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--tinta);
  }

  .palco__moeda,
  .palco__centavos {
    font-size: 0.3em;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-top: 0.22em;
  }

  .palco__moeda {
    margin-right: 0.1em;
    color: var(--tinta-suave);
  }

  .palco__moeda,
  .palco__centavos {
    font-weight: 700;
  }

  .palco__centavos {
    margin-left: 0.06em;
    color: var(--menta);
  }

  /* O 97 acende: brilho de menta por trás do número, nunca atrás de letra
     que precise ler (o número é desenho; o preço lido está no título). */
  .palco__valor {
    font-weight: 800;
    letter-spacing: -0.07em;
    text-shadow:
      0 0 40px color-mix(in srgb, var(--menta) 45%, transparent),
      0 0 120px color-mix(in srgb, var(--menta) 30%, transparent);
  }

  /* Centavos em cima, o "por mês" embaixo, os dois colados ao 97. */
  .palco__lado {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    justify-content: space-between;
    padding-bottom: 0.08em;
  }

  .palco__de {
    margin: 0 0 var(--e-8);
    color: var(--tinta-suave);
    font-size: var(--t-corpo-lg);
    font-weight: var(--peso-medio);
  }

  .palco__de s {
    text-decoration-thickness: 2px;
    text-decoration-color: color-mix(in srgb, var(--tinta) 70%, transparent);
  }

  .palco__vitalicio {
    display: inline-block;
    margin: var(--e-12) 0 0;
    padding: 6px 14px;
    border-radius: var(--raio-pilula);
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: var(--t-legenda);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .palco__cta {
    width: 100%;
    max-width: 520px;
    margin-top: var(--e-32);
  }

  .palco__cta :global(.btn) {
    width: 100%;
    min-height: 60px;
  }

  .palco .cta__nota {
    max-width: none;
  }

  /* ---------- os dois planos ---------- */
  .planos {
    display: grid;
    gap: var(--e-16);
    width: 100%;
    max-width: 340px;
    margin-top: var(--e-32);
  }

  /* No celular o anual, o recomendado, vem primeiro. */
  @media (max-width: 619px) {
    .planos {
      gap: var(--e-32);
    }

    .plano--destaque {
      order: -1;
    }
  }

  .plano {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--e-8);
    padding: 0;
  }

  /* A faixa sai do card e senta na borda de cima. */
  .plano__faixa {
    position: absolute;
    top: 0;
    left: 50%;
    margin: 0;
    padding: 4px 12px;
    border-radius: var(--raio-pilula);
    background: var(--menta-solida);
    color: var(--sobre-menta);
    font-size: var(--t-legenda);
    font-weight: var(--peso-medio);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .plano__nome {
    margin: 0;
    font-size: var(--t-legenda);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--apoio);
  }

  .plano--destaque .plano__nome {
    color: var(--menta);
  }

  .plano__preco {
    display: flex;
    align-items: baseline;
    gap: 2px;
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--tinta);
  }

  .plano__moeda {
    align-self: flex-start;
    margin: 0.18em 0.08em 0 0;
    font-size: 0.4em;
    letter-spacing: 0;
    color: var(--tinta-suave);
  }

  .plano__periodo {
    margin-left: 0.1em;
    font-size: 0.34em;
    font-weight: var(--peso-medio);
    letter-spacing: 0;
    color: var(--tinta-suave);
  }

  .plano__nota {
    margin: 0 0 var(--e-12);
    font-size: var(--t-corpo-sm);
    color: var(--apoio);
  }

  .plano :global(.btn) {
    width: 100%;
    min-height: 54px;
  }

  .planos__nota {
    max-width: none;
    margin-top: var(--e-16);
  }

  /* ---------- 09. A garantia, no rodapé do card ---------- */
  .garantia {
    display: grid;
    justify-items: center;
    gap: var(--e-20);
    padding: var(--e-20) clamp(20px, 6vw, 64px);
    border-top: 1px dashed var(--menta-linha);
    background: color-mix(in srgb, var(--menta) 5%, transparent);
    color: var(--tinta-suave);
    text-align: center;
  }

  @media (min-width: 700px) {
    .garantia {
      grid-template-columns: 96px minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      align-items: center;
      gap: var(--e-32);
      text-align: left;
    }
  }

  .garantia__selo {
    width: 92px;
    height: 92px;
    overflow: visible;
  }

  .garantia__borda {
    fill: var(--carvao);
    stroke: var(--menta);
    stroke-width: 1.5;
  }

  .garantia__volta {
    fill: var(--menta);
    font-family: var(--fonte-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .garantia__giro {
    transform-origin: 80px 80px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .garantia__giro {
      animation: gira 22s linear infinite;
    }
  }

  @keyframes gira {
    to {
      transform: rotate(360deg);
    }
  }

  .garantia__disco {
    fill: var(--menta-solida);
  }

  .garantia__n {
    fill: var(--sobre-menta);
    font-family: var(--fonte-display);
    font-size: 50px;
    font-weight: var(--peso-medio);
    letter-spacing: -0.04em;
  }

  .garantia__d {
    fill: var(--sobre-menta);
    font-family: var(--fonte-mono);
    font-size: 11px;
    font-weight: var(--peso-medio);
    letter-spacing: 0.12em;
  }

  .garantia__titulo {
    font-size: var(--t-titulo-sm);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--tinta);
    margin-bottom: var(--e-8);
  }

  /* ---------- 10. FAQ ---------- */
  .faq__grade {
    display: grid;
    gap: var(--e-32);
  }

  @media (min-width: 960px) {
    .faq__grade {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--e-64);
    }
  }

  .faq__titulo {
    font-size: var(--t-titulo);
    letter-spacing: -0.03em;
  }

  .faq__lista {
    display: grid;
    gap: var(--e-8);
  }

  .faq__item {
    border-radius: var(--raio-card);
    background: var(--superficie);
    box-shadow: var(--anel);
    transition:
      background var(--transicao) var(--curva),
      box-shadow var(--transicao) var(--curva);
  }

  .faq__item:hover {
    box-shadow: 0 0 0 1px var(--linha-forte);
  }

  .faq__item[open] {
    background: var(--menta-tinge);
    box-shadow: 0 0 0 1px var(--menta-linha);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-16);
    min-height: 64px;
    padding: var(--e-12) var(--e-20) var(--e-12) var(--e-24);
    border-radius: var(--raio-card);
    font-size: var(--t-corpo-lg);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__sinal {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--raio-pilula);
    box-shadow: inset 0 0 0 1px var(--linha-forte);
    transition:
      background var(--transicao) var(--curva),
      transform var(--transicao) var(--curva);
  }

  .faq__sinal::before,
  .faq__sinal::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--transicao) var(--curva);
  }

  .faq__sinal::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item summary:hover .faq__sinal {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__sinal {
    background: var(--menta-solida);
    color: var(--sobre-menta);
    box-shadow: none;
    transform: none;
  }

  .faq__item[open] .faq__sinal::after {
    transform: translate(-50%, -50%) rotate(0deg);
