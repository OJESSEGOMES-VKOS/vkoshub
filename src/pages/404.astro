---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
---

<Base titulo="Página não encontrada | VKOSHUB" descricao="Esta página não existe mais." privada>
  <Cabecalho />

  <main id="conteudo">
    <section class="secao">
      <div class="limite caixa">
        <p class="rotulo mono">404</p>
        <h1>Esta página não existe mais.</h1>
        <p class="caixa__texto">O VKOSHUB mudou. Tudo o que importa agora está na página inicial.</p>
        <a class="btn btn--cheio" href="/">Ir para o início</a>
      </div>
    </section>
  </main>

  <Rodape />
</Base>

<script>
  // Rota que não existe: avisa a Umami (evento "rota-inexistente", com o
  // endereço tentado e de onde a pessoa veio) e manda pra home. Espera a Umami
  // no máximo 0,8 s; sem ela (localhost, bloqueio, "não rastrear"), vai direto.
  type Umami = { track: (nome: string, dados: Record<string, string>) => Promise<unknown> };
  const rota = location.pathname + location.search;
  const inicio = performance.now();

  const ir = () => location.replace('/');

  const tenta = () => {
    const umami = (window as unknown as { umami?: Umami }).umami;
    if (umami) {
      Promise.race([
        umami.track('rota-inexistente', { rota, origem: document.referrer || 'direto' }),
        new Promise((r) => setTimeout(r, 400)),
      ]).finally(ir);
    } else if (performance.now() - inicio < 800) {
      setTimeout(tenta, 50);
    } else {
      ir();
    }
  };
  tenta();
</script>

<style>
  .caixa {
    display: grid;
    gap: var(--e-16);
    justify-items: start;
    max-width: 720px;
  }

  h1 {
    font-size: var(--t-display);
    letter-spacing: -0.04em;
  }

  .caixa__texto {
    color: var(--apoio);
  }
</style>
