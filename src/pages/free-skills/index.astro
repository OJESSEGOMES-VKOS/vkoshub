---
// A vitrine das Free Skills: skills gratuitas e abertas pro Claude, de qualquer
// assunto, cada uma com a sua página. Os cartões saem de src/data/skills.js.
// Serve também de porta de entrada pelo Google pro VKOSHUB: por isso o texto
// responde as buscas de quem procura skill pro Claude (o que é, como instalar).
import Base from '../../layouts/Base.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import Rodape from '../../components/Rodape.astro';
import '../../styles/vidro-home.css';
import { skills } from '../../data/skills.js';

const titulo = 'Skills gratuitas pro Claude Code: lista e como instalar | VKOSHUB';
const descricao =
  'Biblioteca de skills gratuitas e de código aberto pro Claude e o Claude Code. Cada uma com o que faz, como instalar e o crédito de quem criou.';

const duvidas = [
  {
    p: 'O que é uma skill do Claude?',
    r: 'É uma pasta com instruções, num arquivo chamado SKILL.md, que o Claude lê pra aprender a fazer uma tarefa do jeito certo. Você instala uma vez e ele passa a usar sozinho quando o pedido combina com ela.',
  },
  {
    p: 'As skills daqui são gratuitas?',
    r: 'Sim. Cada skill listada aqui é de código aberto, com a licença de uso e o crédito de quem criou na página dela. A gente só testa e indica.',
  },
  {
    p: 'Como instalo uma skill no Claude Code?',
    r: 'Em geral você copia a pasta da skill pra ~/.claude/skills/ (pra valer em todos os projetos) ou pra .claude/skills/ dentro de um projeto. Cada página daqui traz o passo a passo certo daquela skill, com o pedido pronto pra colar no Claude.',
  },
  {
    p: 'É seguro instalar uma skill?',
    r: 'Uma skill é um conjunto de instruções e, às vezes, de programas que o Claude pode rodar. Por isso só instale de fonte que você confia e dê uma olhada no que ela faz antes. Aqui a gente lê o repositório oficial e deixa o link pra você conferir.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Skills gratuitas pro Claude Code',
      description: descricao,
      url: new URL('/free-skills', Astro.site).href,
      inLanguage: 'pt-BR',
      isPartOf: { '@type': 'WebSite', name: 'VKOSHUB', url: Astro.site!.origin },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: skills.map((x, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: x.nome,
          url: new URL(`/free-skills/${x.slug}`, Astro.site).href,
        })),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: duvidas.map((d) => ({
        '@type': 'Question',
        name: d.p,
        acceptedAnswer: { '@type': 'Answer', text: d.r },
      })),
    },
  ],
};
---

<Base titulo={titulo} descricao={descricao} schema={schema}>
  <Cabecalho />
  <div class="vidro-fundo" aria-hidden="true"><i></i><i></i><i></i></div>

  <main id="conteudo">
    <section class="topo-fs">
      <div class="limite topo-fs__corpo">
        <h1 class="topo-fs__titulo">Skills gratuitas pro seu Claude, <span class="destaque">sem enrolação.</span></h1>
        <p class="topo-fs__sub">
          Uma biblioteca de skills gratuitas e abertas pro Claude e o Claude Code. Cada uma com o que faz, como instalar
          e o crédito de quem criou.
        </p>
      </div>
    </section>

    <section class="lista" aria-label="Skills disponíveis">
      <div class="limite">
        <ul class="grade" role="list">
          {skills.map((s) => (
            <li>
              <a
                class="skill"
                href={`/free-skills/${s.slug}`}
                data-umami-event="free-skill"
                data-umami-event-skill={s.slug}
              >
                <span class="skill__topo">
                  <span class="skill__nome">{s.nome}</span>
                  <span class="skill__cat mono">{s.categoria}</span>
                </span>
                <span class="skill__frase">{s.frase}</span>
                <span class="skill__selos">
                  {s.selos.map((x) => <span class="skill__selo">{x}</span>)}
                </span>
                <span class="skill__pe">
                  <span class="skill__autor">
                    <img class="skill__foto" src={s.autorFoto} alt="" width="32" height="32" loading="lazy" decoding="async" />
                    <span>
                      <span class="skill__autor-nome">{s.autor}</span>
                      <span class="skill__autor-lic">licença {s.licenca}</span>
                    </span>
                  </span>
                  <span class="skill__ir">
                    Ver a skill
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="duvidas" aria-labelledby="duvidas-titulo">
      <div class="limite duvidas__corpo">
        <h2 id="duvidas-titulo" class="duvidas__titulo">Perguntas frequentes sobre skills</h2>
        <div class="duvidas__lista">
          {duvidas.map((d) => (
            <details class="duvida">
              <summary>
                <span>{d.p}</span>
                <span class="duvida__sinal" aria-hidden="true"></span>
              </summary>
              <p>{d.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Rodape />
</Base>

<style>
  .destaque {
    color: var(--menta);
  }

  .topo-fs {
    padding: clamp(48px, 7vw, 88px) 0 clamp(48px, 7vw, 80px);
  }

  .topo-fs__corpo {
    display: grid;
    justify-items: center;
    gap: var(--e-16);
    text-align: center;
  }

  .topo-fs__titulo {
    margin: 0;
    max-width: 20ch;
    font-size: var(--t-titulo-lg);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .topo-fs__sub {
    margin: 0;
    max-width: 56ch;
    color: var(--tinta-suave);
    font-size: var(--t-corpo-lg);
    text-wrap: pretty;
  }

  .lista {
    padding-bottom: var(--gap-secao);
  }

  .grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-16);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 400px));
    justify-content: center;
  }

  /* O cartão: uma placa de vidro, a mesma da vitrine da home. */
  .skill {
    display: grid;
    gap: var(--e-12);
    height: 100%;
    padding: var(--e-24);
    border-radius: 24px;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02) 45%),
      rgba(14, 20, 18, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 20px 50px -24px rgba(0, 0, 0, 0.7);
    color: var(--tinta);
    text-decoration: none;
    transition: transform var(--transicao) var(--curva);
  }

  .skill:hover {
    transform: translateY(-3px);
  }

  .skill:focus-visible {
    outline: 2px solid var(--menta);
    outline-offset: 4px;
  }

  .skill__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-12);
  }

  .skill__cat {
    flex: none;
    padding: 3px 10px;
    border-radius: var(--raio-pilula);
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: var(--t-legenda);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skill__nome {
    font-family: var(--fonte-display);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .skill__frase {
    color: var(--tinta-suave);
    line-height: 1.5;
  }

  .skill__selos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .skill__selo {
    padding: 3px 10px;
    border-radius: var(--raio-pilula);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    color: var(--tinta-suave);
    font-size: var(--t-legenda);
  }

  .skill__pe {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-8) var(--e-16);
    margin-top: var(--e-8);
    padding-top: var(--e-16);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: var(--t-corpo-sm);
  }

  .skill__autor {
    display: inline-flex;
    align-items: center;
    gap: var(--e-12);
    color: var(--apoio);
  }

  .skill__foto {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
  }

  .skill__autor-nome,
  .skill__autor-lic {
    display: block;
    line-height: 1.25;
  }

  .skill__autor-nome {
    color: var(--tinta);
    font-weight: 600;
  }

  .skill__autor-lic {
    font-size: var(--t-legenda);
  }

  .skill__ir {
    display: inline-flex;
    align-items: center;
    gap: var(--e-8);
    color: var(--menta);
    font-weight: 600;
  }

  .skill__ir svg {
    width: 16px;
    height: 16px;
  }

  .lista__nota {
    margin: var(--e-32) auto 0;
    color: var(--apoio);
    font-size: var(--t-corpo-sm);
    text-align: center;
  }

  /* ---------- perguntas frequentes ---------- */
  .duvidas {
    margin-top: clamp(64px, 10vw, 140px);
    padding-bottom: var(--gap-secao);
  }

  .duvidas__corpo {
    display: grid;
    gap: var(--e-24);
    max-width: calc(780px + 2 * clamp(16px, 5vw, 40px));
  }

  .duvidas__titulo {
    margin: 0;
    font-size: var(--t-subtitulo);
    letter-spacing: -0.03em;
    text-align: center;
  }

  .duvidas__lista {
    display: grid;
    gap: var(--e-8);
  }

  .duvida {
    border-radius: 20px;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02) 45%),
      rgba(14, 20, 18, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  .duvida summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-16);
    min-height: 56px;
    padding: var(--e-12) var(--e-24);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .duvida summary::-webkit-details-marker {
    display: none;
  }

  .duvida summary:focus-visible {
    outline: 2px solid var(--menta);
    outline-offset: 3px;
    border-radius: 20px;
  }

  .duvida__sinal {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .duvida__sinal::before,
  .duvida__sinal::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    border-radius: 2px;
    background: var(--menta);
    transition: transform var(--micro) var(--curva);
  }

  .duvida__sinal::after {
    transform: rotate(90deg);
  }

  .duvida[open] .duvida__sinal::after {
    transform: rotate(0deg);
  }

  .duvida p {
    margin: 0;
    padding: 0 var(--e-24) var(--e-20);
    color: var(--tinta-suave);
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill:hover {
      transform: none;
    }
  }
</style>
