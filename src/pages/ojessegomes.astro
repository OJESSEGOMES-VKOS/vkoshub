---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import CardPlaybook from '../components/CardPlaybook.astro';
import { playbooks } from '../data/playbooks.js';

/* Publicado é o que a pessoa consegue abrir. Projeto em desenvolvimento
   entra na lista com o selo, mas não conta aqui: dizer "2 publicados" com
   um deles fechado é o tipo de número que queima a confiança à toa. */
const total = playbooks.filter((p) => p.estado !== 'desenvolvimento').length;
/* O título antes era "OJESSEGOMES | VKOSHUB": duas marcas e nenhuma
   palavra do que a página tem. Quem procura não digita o nome de quem
   ainda não conhece, digita o que quer. */
const titulo = 'Soluções de IA prontas pra usar | VKOSHUB';
const descricao =
  'A lista das soluções de inteligência artificial do VKOSHUB: prontas, validadas em operação real, ou em construção. Nenhuma entra aqui sem antes rodar de verdade.';

const perfis = [
  {
    href: 'https://www.instagram.com/ojessegomes/',
    texto: 'Seguir no Instagram',
    cheio: true,
    icone: 'instagram',
  },
  {
    href: 'https://www.youtube.com/@ojessegomes',
    texto: 'Ver no YouTube',
    cheio: false,
    icone: 'youtube',
  },
];
---

<Base titulo={titulo} descricao={descricao}>
  <Cabecalho />

  <main id="conteudo">
    <section class="heroi">
      <div class="limite heroi__grade">
        <div class="heroi__coluna">
          <h1 class="reveal">
            Soluções de IA que já rodaram de verdade antes de chegar aqui.
          </h1>
          <div class="heroi__texto reveal" style="--atraso: 60ms">
            <p>
              Se o seu negócio já fatura e você sabe que precisa de IA mas não sabe por onde
              começar, escolha qualquer solução aqui embaixo.
            </p>
          </div>
        </div>

        <aside class="perfil reveal" style="--atraso: 120ms" aria-label="Perfil de Jessé Gomes">
          <p class="mono perfil__contagem">
            {total} {total === 1 ? 'criação publicada' : 'criações publicadas'}
          </p>
          <img
            class="perfil__avatar"
            src="/perfil/jesse.webp"
            alt="Jessé Gomes"
            width="84"
            height="84"
            loading="eager"
            decoding="async"
          />
          <p class="mono perfil__usuario">@ojessegomes</p>
          <div class="perfil__acoes">
            {
              perfis.map((p) => (
                <a
                  class={p.cheio ? 'btn btn--cheio' : 'btn btn--fantasma'}
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                >
                  {p.icone === 'instagram' ? (
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
                      <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" />
                      <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.8" />
                      <path d="M10.5 9.3v5.4l4.6-2.7z" fill="currentColor" />
                    </svg>
                  )}
                  {p.texto}
                </a>
              ))
            }
          </div>
        </aside>
      </div>
    </section>

    <section class="secao secao--lista">
      <div class="limite">
        <div class="lista__topo reveal">
          <h2>Criações</h2>
        </div>
        <ul class="grade">
          {
            playbooks.map((p, i) => (
              /* O atraso escalona só dentro da linha e volta a zero na
                 seguinte, senão o último card da lista longa demoraria
                 meio segundo pra aparecer depois de já estar na tela. */
              <li class="reveal" style={`--atraso: ${(i % 3) * 70}ms`}>
                <CardPlaybook
                  slug={p.slug}
                  titulo={p.titulo}
                  resumo={p.resumo}
                  categoria={p.categoria}
                  novo={p.novo}
                  capa={p.capa}
                  capaAlt={p.capaAlt}
                  arte={p.arte}
                  estado={p.estado}
                  selo={p.selo}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Rodape />
</Base>

<style>
  .limite {
    width: 100%;
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 40px);
  }

  /* ---------- heroi ---------- */
  /* O herói abre limpo. A textura de fundo é global e fica atrás de tudo,
     então aqui a cor da página cobre ela e some em desvanecimento no fim
     da seção. A grade pontilhada nasce junto com o conteúdo, não antes. */
  .heroi {
    padding-block: clamp(56px, 11vw, 128px) clamp(48px, 8vw, 88px);
    background: linear-gradient(to bottom, var(--pagina) 68%, transparent);
  }

  .heroi__grade {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--e-40);
  }

  .heroi h1 {
    max-width: 18ch;
  }

  .heroi__texto {
    margin-top: var(--e-32);
    display: grid;
    gap: var(--e-16);
  }

  .heroi__texto p {
    font-size: var(--t-corpo-lg);
    color: var(--apoio);
  }

  /* ---------- cartão de perfil ---------- */
  .perfil {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 240px;
    padding: var(--e-32) var(--e-20);
    background: var(--superficie);
    border-radius: var(--raio-card);
    box-shadow: var(--anel);
    text-align: center;
  }

  .perfil__contagem {
    font-size: var(--t-legenda);
    color: var(--apoio);
    margin-bottom: var(--e-16);
  }

  .perfil__avatar {
    display: block;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--anel);
  }

  .perfil__usuario {
    margin-top: var(--e-16);
    font-size: var(--t-corpo-sm);
    color: var(--apoio);
  }

  .perfil__acoes {
    display: flex;
    flex-direction: column;
    gap: var(--e-12);
    width: 100%;
    margin-top: var(--e-24);
  }

  .perfil__acoes .btn {
    width: 100%;
  }

  @media (max-width: 719px) {
    .heroi__grade {
      grid-template-columns: 1fr;
    }

    .perfil {
      width: 100%;
      max-width: 320px;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-8);
    min-height: 44px;
    padding: var(--e-12) var(--e-20);
    border-radius: var(--raio-pilula);
    font-size: var(--t-corpo-sm);
    font-weight: var(--peso-medio);
    text-decoration: none;
    transition:
      transform var(--micro) var(--curva),
      background var(--micro) var(--curva),
      box-shadow var(--micro) var(--curva);
  }

  .btn svg {
    flex-shrink: 0;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--cheio {
    background: var(--tinta);
    color: var(--sobre-tinta);
  }

  .btn--cheio:hover {
    background: var(--tinta-hover);
  }

  .btn--fantasma {
    background: transparent;
    color: var(--tinta);
    box-shadow: var(--anel);
  }

  .btn--fantasma:hover {
    background: var(--superficie);
  }

  /* ---------- lista ---------- */
  .lista__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-8) var(--e-24);
    margin-bottom: var(--e-32);
  }

  .secao--lista {
    position: relative;
    padding-block: var(--e-40) var(--gap-secao);
  }


  /* A listagem. auto-fill mantém a largura do card constante: com poucos
     playbooks eles não esticam, e com muitos a linha enche e quebra sozinha. */
  .grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    row-gap: var(--e-40);
    column-gap: var(--e-24);
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  /* O item da grade fica no tema da página, então é ele que carrega a
     elevação do card. No escuro isso vira um anel claro que devolve a
     silhueta inteira, inclusive a capa, que senão encosta no fundo e some. */
  .grade > li {
    display: flex;
    border-radius: var(--raio-card);
    box-shadow: var(--sombra-card);
  }
</style>
