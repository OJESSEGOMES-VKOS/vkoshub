---
// A página da Máquina de Conteúdo: o estúdio de vídeo com IA, em construção.
// Topo forte com o print do app, o que ela faz e quando chega.
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import BotaoAssinar from '../components/BotaoAssinar.astro';

const titulo = 'Máquina de Conteúdo | O estúdio de vídeo com IA do VKOSHUB';
const descricao =
  'Um estúdio de vídeo com IA. Você manda a gravação, o Claude sugere os cortes e você aprova, ajusta e exporta. Em construção.';

const passos = [
  {
    tela: '/maquina/inicio.webp', w: 1032, h: 290,
    titulo: 'Você escolhe o que fazer',
    texto: 'Cortar um vídeo seu ou do YouTube, criar um vídeo a partir de um tema ou abrir o estúdio vazio.',
    alt: 'Tela inicial da Máquina de Conteúdo com três opções: Criar Cortes, Criar Vídeo com IA e Abrir Estúdio de Edição.',
  },
  {
    tela: '/maquina/estudio.webp', w: 1440, h: 900,
    titulo: 'O Claude monta a edição',
    texto: 'Cenas, frases na tela, som, grão e transições entram na linha do tempo, cada um na sua camada.',
    alt: 'Estúdio da Máquina com um vídeo montado: a prévia de uma animação à direita e a linha do tempo com camadas de som, vinheta, grão, frases e cenas.',
  },
  {
    tela: '/maquina/ajuste.webp', w: 1440, h: 900,
    titulo: 'Você ajusta e exporta',
    texto: 'Clica em qualquer pedaço e muda o texto, o tempo, a posição ou o tamanho. Quando estiver do seu jeito, exporta.',
    alt: 'Estúdio da Máquina com uma frase selecionada e o painel ao lado mostrando tempo, texto, posição e tamanho dela.',
  },
];

// Ícones de traço simples, desenhados aqui pra não depender de nada de fora.
const recursos = [
  {
    titulo: 'Cortes sugeridos',
    texto: 'Manda um vídeo longo e o Claude aponta os melhores trechos, cada um com nota e gancho. Você aprova ou descarta um por um.',
    icone: 'M6 4a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm0 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM7.5 7.5 20 18M7.5 16.5 20 6',
  },
  {
    titulo: 'Legenda pela sua fala',
    texto: 'A fala vira texto com o tempo de cada palavra. A legenda entra no ritmo certo, sem você digitar nada.',
    icone: 'M4 6h16v10H8l-4 4V6ZM8 10h8M8 13h5',
  },
  {
    titulo: 'Estúdio com linha do tempo',
    texto: 'Cenas, frases, som e efeitos em camadas. Navalha pra cortar e atalho pra esconder, como num editor de verdade.',
    icone: 'M3 5h18M3 12h18M3 19h18M8 3v4M15 10v4M11 17v4',
  },
  {
    titulo: 'Vídeo a partir de um tema',
    texto: 'Você dá o assunto e ela escreve o roteiro, narra e monta a edição. Você revisa o que saiu.',
    icone: 'M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  },
  {
    titulo: "Remoção de marca d'água",
    texto: 'Marca a área e ela limpa, com prévia antes de aplicar.',
    icone: 'M4 4h16v16H4zM9 9l6 6M15 9l-6 6',
  },
  {
    titulo: 'Exportação do seu jeito',
    texto: 'Escolhe resolução, quadros por segundo e qualidade. Usa a placa de vídeo quando o computador tem uma.',
    icone: 'M12 4v11M7 10l5 5 5-5M5 20h14',
  },
];

const pecas = [
  { papel: 'O cérebro', nome: 'Claude Code', texto: 'Lê a transcrição, decide os cortes, escreve o roteiro e monta a edição.' },
  { papel: 'O ouvido', nome: 'Whisper', texto: 'Transforma a fala em texto e marca o tempo de cada palavra.' },
  { papel: 'As mãos', nome: 'ffmpeg e Remotion', texto: 'Cortam, juntam, animam e exportam o vídeo pronto.' },
];

const perguntas = [
  {
    p: 'Quanto custa a Máquina?',
    r: 'Pra quem entra no VKOSHUB como fundador, nada a mais. Ela entra no Hub quando ficar pronta, dentro do plano de R$97 por ano.',
  },
  {
    p: 'Já dá pra usar?',
    r: 'Ainda não pra todo mundo. Ela está em fase alfa: a gente usa nos nossos vídeos e vai testando e melhorando cada parte. As telas desta página são do app de verdade, com um projeto nosso aberto.',
  },
  {
    p: 'Preciso de computador?',
    r: 'Sim. As aulas do Hub abrem no celular, mas a edição na Máquina pede computador.',
  },
  {
    p: 'Preciso assinar o Claude?',
    r: 'Sim. A Máquina usa o Claude Code como cérebro, e a assinatura do Claude é contratada à parte.',
  },
];
---

<Base titulo={titulo} descricao={descricao}>
  <Cabecalho />

  <main id="conteudo">
    {/* 01. Topo */}
    <section class="topo" aria-labelledby="topo-titulo">
      <div class="topo__luz" aria-hidden="true"></div>
      <div class="limite">
        <div class="topo__texto">
          <p class="obra mono"><i aria-hidden="true"></i>Em construção</p>
          <h1 id="topo-titulo" class="topo__titulo">
            O estúdio de vídeo que tem <span class="destaque">o Claude como editor.</span>
          </h1>
          <p class="topo__sub">
            Você manda a gravação, o Claude sugere os cortes e você aprova, ajusta e exporta.
            Usa o Claude Code como cérebro.
          </p>
        </div>

        <figure class="vitrine">
          <div class="janela">
            <div class="janela__barra" aria-hidden="true">
              <i></i><i></i><i></i>
              <span class="janela__url mono">máquina de conteúdo · estúdio</span>
            </div>
            <img
              src="/maquina/estudio.webp"
              alt="Estúdio da Máquina de Conteúdo com um vídeo montado: a prévia à direita e a linha do tempo com as camadas embaixo."
              width="1440"
              height="900"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <div class="janela janela--extra" aria-hidden="true">
            <img src="/maquina/inicio.webp" alt="" width="1032" height="290" loading="lazy" decoding="async" />
          </div>
        </figure>
      </div>
    </section>

    {/* 02. Como funciona */}
    <section class="secao fluxo" aria-labelledby="fluxo-titulo">
      <div class="limite">
        <header class="cabeca reveal">
          <p class="olho">Como funciona</p>
          <h2 id="fluxo-titulo" class="cabeca__titulo">
            Da gravação bruta <span class="destaque">ao vídeo exportado.</span>
          </h2>
        </header>

        <ol class="passos" role="list">
          {passos.map((p, i) => (
            <li class:list={['passo', 'reveal', { 'passo--invertido': i % 2 === 1 }]}>
              <div class="passo__texto">
                <span class="passo__num mono" aria-hidden="true">{i + 1}</span>
                <h3 class="passo__titulo">{p.titulo}</h3>
                <p class="passo__desc">{p.texto}</p>
              </div>
              <div class="janela passo__tela">
                <img src={p.tela} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* 03. O que ela faz */}
    <section class="secao recursos" aria-labelledby="recursos-titulo">
      <div class="limite">
        <header class="cabeca reveal">
          <p class="olho">O que ela faz</p>
          <h2 id="recursos-titulo" class="cabeca__titulo">
            Um estúdio inteiro, <span class="destaque">com o Claude no comando.</span>
          </h2>
        </header>

        <ul class="recursos__grade" role="list">
          {recursos.map((r) => (
            <li class="recurso reveal">
              <span class="recurso__icone" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d={r.icone} /></svg>
              </span>
              <h3 class="recurso__titulo">{r.titulo}</h3>
              <p class="recurso__texto">{r.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* 04. Por dentro */}
    <section class="secao dentro" aria-labelledby="dentro-titulo">
      <div class="limite">
        <header class="cabeca reveal">
          <p class="olho">Por dentro</p>
          <h2 id="dentro-titulo" class="cabeca__titulo">
            Cada parte faz <span class="destaque">o que faz melhor.</span>
          </h2>
        </header>

        <ol class="pecas" role="list">
          {pecas.map((p) => (
            <li class="peca reveal">
              <p class="peca__papel mono">{p.papel}</p>
              <p class="peca__nome">{p.nome}</p>
              <p class="peca__texto">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* 05. Quando chega */}
    <section class="secao chegada" aria-labelledby="chegada-titulo">
      <div class="limite">
        <div class="chegada__card reveal reveal--escala">
          <p class="olho">Founders</p>
          <h2 id="chegada-titulo" class="cabeca__titulo">
            Quando ficar pronta, <span class="destaque">entra no Hub sem custo.</span>
          </h2>
          <p class="chegada__texto">
            A Máquina está sendo construída agora. Quem entra no VKOSHUB como membro fundador
            recebe ela sem pagar nada a mais.
          </p>
          <div class="chegada__cta">
            <BotaoAssinar grande />
            <p class="chegada__nota">R$97 por ano, no preço de fundador. 7 dias de garantia.</p>
          </div>
        </div>
      </div>
    </section>

    {/* 06. Perguntas */}
    <section class="secao faq" aria-labelledby="faq-titulo">
      <div class="limite faq__grade">
        <h2 id="faq-titulo" class="faq__titulo reveal">Perguntas sobre a Máquina</h2>
        <div class="faq__lista reveal">
          {perguntas.map((item) => (
            <details class="faq__item">
              <summary>
                <span>{item.p}</span>
                <span class="faq__sinal" aria-hidden="true" />
              </summary>
              <p>{item.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Rodape />
</Base>

<style>
  /* ---------- 01. Topo ---------- */
  .topo {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 9vw, 112px) 0 clamp(48px, 7vw, 96px);
    text-align: center;
  }

  .topo__luz {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 40% at 50% 8%, color-mix(in srgb, var(--menta) 16%, transparent), transparent 70%),
      radial-gradient(40% 30% at 50% 70%, color-mix(in srgb, var(--menta) 10%, transparent), transparent 70%);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }

  .topo .limite {
    position: relative;
  }

  .topo__texto {
    display: grid;
    justify-items: center;
    gap: var(--e-20);
  }

  .obra {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 14px;
    border-radius: var(--raio-pilula);
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: var(--t-legenda);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .obra i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--menta);
    box-shadow: 0 0 10px var(--menta);
  }

  @media (prefers-reduced-motion: no-preference) {
    .obra i {
      animation: pisca 1.6s ease-in-out infinite;
    }
  }

  @keyframes pisca {
    50% {
      opacity: 0.25;
    }
  }

  .topo__titulo {
    margin: 0;
    font-size: clamp(2.5rem, 5.6vw, 5.25rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 18ch;
    text-wrap: balance;
  }

  .topo__sub {
    margin: 0;
    max-width: 54ch;
    color: var(--tinta-suave);
    font-size: var(--t-corpo-lg);
    text-wrap: pretty;
  }

  .destaque {
    color: var(--menta);
  }

  /* O print do app numa janela, com a tela de início flutuando por cima. */
  .vitrine {
    position: relative;
    max-width: 1040px;
    margin: clamp(40px, 6vw, 72px) auto 0;
    padding-bottom: clamp(24px, 6vw, 64px);
  }

  .janela {
    overflow: hidden;
    border-radius: 14px;
    background: var(--superficie);
    box-shadow:
      inset 0 0 0 1px var(--linha-forte),
      0 40px 120px -40px color-mix(in srgb, var(--menta) 35%, transparent),
      0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .janela img {
    display: block;
    width: 100%;
    height: auto;
  }

  .janela__barra {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--linha);
  }

  .janela__barra i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--linha-forte);
  }

  .janela__url {
    margin-left: 10px;
    color: var(--apoio);
    font-size: 0.75rem;
  }

  .janela--extra {
    position: absolute;
    right: -3%;
    bottom: 0;
    width: 42%;
    border-radius: 12px;
  }

  @media (max-width: 640px) {
    .janela--extra {
      right: -2%;
      width: 56%;
    }
  }

  /* ---------- títulos das seções ---------- */
  .cabeca {
    display: grid;
    justify-items: center;
    gap: var(--e-16);
    margin-bottom: clamp(32px, 5vw, 56px);
    text-align: center;
  }

  .cabeca__titulo {
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* ---------- 02. Como funciona: três passos, tela e texto alternando ---------- */
  .passos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(48px, 8vw, 96px);
    position: relative;
  }

  .passo {
    display: grid;
    gap: var(--e-24);
    align-items: center;
  }

  @media (min-width: 900px) {
    .passo {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(32px, 5vw, 72px);
    }

    .passo--invertido {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .passo--invertido .passo__texto {
      order: 2;
    }
  }

  .passo__texto {
    display: grid;
    justify-items: start;
    gap: var(--e-12);
  }

  .passo__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
    font-size: var(--t-corpo);
  }

  .passo__titulo {
    margin: 0;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .passo__desc {
    margin: 0;
    max-width: 42ch;
    color: var(--tinta-suave);
    font-size: var(--t-corpo-lg);
  }

  .passo__tela {
    box-shadow:
      inset 0 0 0 1px var(--linha-forte),
      0 30px 80px -40px color-mix(in srgb, var(--menta) 30%, transparent),
      0 24px 50px -30px rgba(0, 0, 0, 0.9);
  }

  /* ---------- 03. O que ela faz: seis recursos em grade ---------- */
  .recursos__grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-16);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .recurso {
    display: grid;
    align-content: start;
    gap: var(--e-12);
    padding: var(--e-24);
    border-radius: var(--raio-card);
    background: var(--superficie);
    box-shadow: inset 0 0 0 1px var(--linha);
    transition: box-shadow var(--micro) var(--curva);
  }

  .recurso:hover {
    box-shadow: inset 0 0 0 1px var(--menta-linha);
  }

  .recurso__icone {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
  }

  .recurso__icone svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--menta);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .recurso__titulo {
    margin: var(--e-4, 4px) 0 0;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .recurso__texto {
    margin: 0;
    color: var(--tinta-suave);
  }

  /* ---------- 04. Por dentro: as três peças lado a lado ---------- */
  .pecas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-16);
  }

  @media (min-width: 860px) {
    .pecas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .peca {
    display: grid;
    gap: var(--e-8);
    padding: var(--e-32) var(--e-24);
    border-radius: var(--raio-card);
    text-align: center;
    background:
      radial-gradient(80% 70% at 50% 0%, color-mix(in srgb, var(--menta) 10%, transparent), transparent 70%),
      var(--superficie);
    box-shadow: inset 0 0 0 1px var(--linha-forte);
  }

  .peca__papel {
    margin: 0;
    color: var(--menta);
    font-size: var(--t-legenda);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .peca__nome {
    margin: 0;
    font-family: var(--fonte-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .peca__texto {
    margin: 0 auto;
    max-width: 30ch;
    color: var(--tinta-suave);
  }

  /* ---------- 06. Perguntas (o mesmo acordeão da página principal) ---------- */
  .faq__grade {
    display: grid;
    gap: var(--e-32);
  }

  @media (min-width: 960px) {
    .faq__grade {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--e-64);
    }
  }

  .faq__titulo {
    font-size: var(--t-titulo);
    letter-spacing: -0.03em;
  }

  .faq__lista {
    display: grid;
    gap: var(--e-8);
  }

  .faq__item {
    border-radius: var(--raio-card);
    background: var(--superficie);
    box-shadow: var(--anel);
    transition:
      background var(--transicao) var(--curva),
      box-shadow var(--transicao) var(--curva);
  }

  .faq__item:hover {
    box-shadow: 0 0 0 1px var(--linha-forte);
  }

  .faq__item[open] {
    background: var(--menta-tinge);
    box-shadow: 0 0 0 1px var(--menta-linha);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-16);
    min-height: 64px;
    padding: var(--e-12) var(--e-20) var(--e-12) var(--e-24);
    border-radius: var(--raio-card);
    font-size: var(--t-corpo-lg);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__sinal {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--raio-pilula);
    box-shadow: inset 0 0 0 1px var(--linha-forte);
    transition:
      background var(--transicao) var(--curva),
      transform var(--transicao) var(--curva);
  }

  .faq__sinal::before,
  .faq__sinal::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--transicao) var(--curva);
  }

  .faq__sinal::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item summary:hover .faq__sinal {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__sinal {
    background: var(--menta-solida);
    color: var(--sobre-menta);
    box-shadow: none;
    transform: none;
  }

  .faq__item[open] .faq__sinal::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__item p {
    padding: 0 var(--e-64) var(--e-24) var(--e-24);
    color: var(--tinta-suave);
  }

  @media (max-width: 600px) {
    .faq__item p {
      padding-right: var(--e-24);
    }
  }

  /* ---------- 05. Quando chega ---------- */
  .chegada__card {
    display: grid;
    justify-items: center;
    gap: var(--e-20);
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(36px, 6vw, 64px) clamp(20px, 5vw, 56px);
    border-radius: var(--raio-card);
    text-align: center;
    background:
      radial-gradient(70% 60% at 50% 0%, color-mix(in srgb, var(--menta) 14%, transparent), transparent 70%),
      var(--superficie);
    box-shadow:
      inset 0 0 0 1px var(--menta-linha),
