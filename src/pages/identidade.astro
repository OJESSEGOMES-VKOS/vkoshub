    font-size: var(--t-corpo-sm);
    cursor: pointer;
    transition: background var(--micro) var(--curva), color var(--micro) var(--curva);
  }

  .aba:hover {
    color: var(--tinta);
  }

  .aba--ativa {
    background: var(--tinta);
    color: var(--sobre-tinta);
  }

  .aba--ativa:hover {
    color: var(--sobre-tinta);
  }

  .checagem {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-8);
  }

  .checagem li {
    position: relative;
    padding-left: var(--e-24);
    font-size: var(--t-corpo-sm);
  }

  .checagem li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 10px;
    height: 6px;
    border-left: 1.5px solid var(--tinta);
    border-bottom: 1.5px solid var(--tinta);
    transform: rotate(-45deg);
  }

  .checagem--nao li::before {
    width: 10px;
    height: 10px;
    top: 0.4em;
    border: 0;
    background: linear-gradient(var(--linha-forte), var(--linha-forte));
    background-size: 100% 1.5px;
    background-repeat: no-repeat;
    background-position: center;
    transform: none;
  }

  .card-material {
    display: grid;
    gap: var(--e-8);
    justify-items: start;
    padding: var(--e-24);
    background: var(--papel);
    border-radius: var(--raio-card-sm);
    text-decoration: none;
    box-shadow: var(--anel);
    transition: transform var(--micro) var(--curva), box-shadow var(--micro) var(--curva);
