---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';

const secoes = [
  { href: '#cor', texto: 'Cor' },
  { href: '#tipografia', texto: 'Tipografia' },
  { href: '#espaco', texto: 'Espaço' },
  { href: '#forma', texto: 'Forma' },
  { href: '#componentes', texto: 'Componentes' },
  { href: '#movimento', texto: 'Movimento' },
  { href: '#voz', texto: 'Voz' },
];

const cores = [
  { token: '--pagina', hex: '#0A0A0A', papel: 'Fundo da página. O quase preto do Cérebro, que no escuro deixa de ser tinta e vira base.', contraste: 'recebe a tinta a 17.04:1', marca: true },
  { token: '--tinta', hex: '#F0EEE6', papel: 'Texto primário e botão cheio. O off-white de descanso virou a letra.', contraste: '17.04:1 sobre a página', marca: true },
  { token: '--menta', hex: '#7ED9B2', papel: 'Acento. Aqui ela carrega texto, não só marca. Racionada mesmo assim.', contraste: '11.74:1 sobre a página', marca: true },
];

const coresApoio = [
  { token: '--superficie', hex: '#171717', papel: 'Card e bloco. Um degrau acima da página.', contraste: 'recebe a tinta a 15.43:1' },
  { token: '--papel', hex: '#1C1C1C', papel: 'Superfície elevada: campo de formulário e card que flutua.', contraste: 'recebe a tinta a 14.67:1' },
  { token: '--lavagem', hex: '#2A2A2A', papel: 'Pílula e zona de destaque, que ficam em cima do card.', contraste: 'recebe a tinta a 12.36:1' },
  { token: '--carvao', hex: '#050505', papel: 'O painel mais fundo: terminal, capa de card e rodapé.', contraste: 'recebe o texto claro a 17.54:1' },
  { token: '--tinta-suave', hex: '#C9C6BC', papel: 'Título apagado e rótulo de seção.', contraste: '11.58:1 sobre a página' },
  { token: '--apoio', hex: '#A5A199', papel: 'Texto secundário e metadado, na página e no card.', contraste: '7.69:1 na página, 6.96:1 no card' },
  { token: '--linha', hex: '#2E2E2E', papel: 'Divisória fina e contorno. Decorativa, não carrega texto.', contraste: 'sem exigência, não é texto' },
  { token: '--linha-forte', hex: '#726E66', papel: 'Limite interativo: borda de campo, aba inativa.', contraste: '3.90:1, passa o piso de 3:1 de componente' },
  { token: '--menta-fundo', hex: '#93E2C2', papel: 'A menta de ênfase, pra link e dado vivo.', contraste: '13.10:1 sobre a página' },
  { token: '--sobre-tinta', hex: '#0A0A0A', papel: 'Texto DENTRO do botão cheio. Existe pra o tema poder inverter sem quebrar.', contraste: '17.04:1 dentro do botão' },
  { token: '--sobre-painel', hex: '#F0EEE6', papel: 'Texto sobre o painel fundo. Claro nos dois temas, porque o painel é escuro nos dois.', contraste: '17.54:1 sobre o carvão' },
];

const escala = [
  { nome: 'display', token: '--t-display', valor: 'clamp(2.75rem, 7vw, 4.5rem)', altura: '1.0', tracking: '-0.025em', amostra: 'Escala sem travar', voz: 'display' },
  { nome: 'titulo-lg', token: '--t-titulo-lg', valor: 'clamp(2.25rem, 5vw, 3.75rem)', altura: '1.1', tracking: '-0.02em', amostra: 'Constrói, mostra, ensina', voz: 'display' },
  { nome: 'titulo', token: '--t-titulo', valor: 'clamp(1.875rem, 4vw, 3rem)', altura: '1.1', tracking: '-0.02em', amostra: 'O que já roda lá fora', voz: 'display' },
  { nome: 'subtitulo', token: '--t-subtitulo', valor: 'clamp(1.5rem, 2.6vw, 1.875rem)', altura: '1.1', tracking: '-0.02em', amostra: 'Não falta ideia, falta sistema', voz: 'display' },
  { nome: 'titulo-sm', token: '--t-titulo-sm', valor: '1.5rem', altura: '1.1', tracking: '-0.02em', amostra: 'Um projeto por vez', voz: 'display' },
  { nome: 'corpo-lg', token: '--t-corpo-lg', valor: '1.125rem', altura: '1.6', tracking: 'normal', amostra: 'A linha de abertura que segura o olho antes do texto normal começar.', voz: 'ui' },
  { nome: 'corpo', token: '--t-corpo', valor: '1rem', altura: '1.6', tracking: 'normal', amostra: 'O tamanho padrão de leitura do Hub, usado em toda prosa corrida.', voz: 'ui' },
  { nome: 'corpo-sm', token: '--t-corpo-sm', valor: '0.875rem', altura: '1.6', tracking: 'normal', amostra: 'Texto de apoio, rótulo de campo e linha de checagem.', voz: 'ui' },
  { nome: 'legenda', token: '--t-legenda', valor: '0.75rem', altura: '1.6', tracking: 'normal', amostra: 'Metadado, data e rótulo técnico.', voz: 'mono' },
];

const espacos = [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 96, 144];

const superficies = [
  { nivel: '0', nome: 'Página', token: '--pagina', hex: '#0A0A0A', uso: 'Fundo de tudo. A base que o resto se apoia.' },
  { nivel: '1', nome: 'Superfície', token: '--superficie', hex: '#171717', uso: 'Card e bloco. A camada elevada dominante.' },
  { nivel: '2', nome: 'Papel', token: '--papel', hex: '#1C1C1C', uso: 'Campo de formulário e card que flutua. Mais um degrau acima.' },
  { nivel: '3', nome: 'Lavagem', token: '--lavagem', hex: '#2A2A2A', uso: 'Pílula e destaque, que ficam em cima do card.' },
  { nivel: '4', nome: 'Carvão', token: '--carvao', hex: '#050505', uso: 'Terminal, capa e rodapé. O único que desce em vez de subir.' },
];

const motions = [
  { nome: 'micro', token: '--micro', valor: '180ms', uso: 'Hover de botão, troca de aba, mudança de estado.' },
  { nome: 'transicao', token: '--transicao', valor: '260ms', uso: 'Abertura de painel, entrada de menu.' },
  { nome: 'reveal', token: '--reveal', valor: '620ms', uso: 'Seção entrando na rolagem. Uma vez só, sem repetir.' },
];

const titulo = 'Identidade visual e sistema de design | VKOSHUB';
const descricao =
  'O sistema de design do VKOSHUB: cor, tipografia, espaçamento, forma, componentes e movimento, com o contraste de cada par conferido.';
---

<Base titulo={titulo} descricao={descricao}>
  <Cabecalho />

  <main id="conteudo">
    <section class="secao secao--heroi">
      <div class="limite">
        <p class="sobrancelha">Sistema de identidade</p>
        <h1>A cara do VKOSHUB, decidida antes de virar gosto.</h1>
        <p class="heroi__texto">
          Isto não é um catálogo bonito. É o conjunto de decisões que todo pedaço do Hub obedece,
          com o número do contraste ao lado de cada cor. Quando uma tela nova nascer, ela sai daqui,
          não do reflexo de quem está construindo.
        </p>
        <div class="heroi__leitura">
          <p class="mono rotulo">Leitura de design</p>
          <p class="heroi__declaracao">
            Página de sistema de identidade para o operador do negócio, linguagem calma e de
            operador, direção Minimalista Editorial, estilo Laboratório creme em tema escuro. As
            cores vêm do Cérebro de @OJESSEGOMES e mandam mais que a cartela. O tema claro
            continua inteiro no tokens.css e volta trocando uma palavra no Base.astro.
          </p>
        </div>
        <p class="dica mono">Clique em qualquer valor para copiar.</p>

        <nav class="indice" aria-label="Seções do sistema">
          {secoes.map((s) => <a href={s.href}>{s.texto}</a>)}
        </nav>
      </div>
    </section>

    <section class="secao" id="cor">
      <div class="limite">
        <h2 class="reveal">Cor</h2>
        <p class="secao__intro reveal">
          Três cores são da marca e são as mesmas nos dois temas. O que gira é o papel de cada
          uma: no escuro o quase preto vira o fundo e o off-white vira a letra. O resto da lista
          existe só pra dar hierarquia sem sair da paleta, e a cor saturada continua racionada.
        </p>

        <div class="cores-marca reveal">
          {cores.map((c) => (
            <article class="cor-grande">
              <button
                type="button"
                class="cor-grande__amostra"
                style={`background:${c.hex}`}
                data-copiar={c.hex}
                aria-label={`Copiar ${c.hex}`}
              >
                <span class="mono cor-grande__hex">{c.hex}</span>
              </button>
              <p class="mono rotulo">{c.token}</p>
              <p class="cor-grande__papel">{c.papel}</p>
              <p class="cor-grande__contraste mono">{c.contraste}</p>
            </article>
          ))}
        </div>

        <h3 class="reveal sub">Os tons de apoio</h3>
        <ul class="cores-apoio reveal">
          {coresApoio.map((c) => (
            <li class="cor-linha">
              <button
                type="button"
                class="cor-linha__amostra"
                style={`background:${c.hex}`}
                data-copiar={c.hex}
                aria-label={`Copiar ${c.hex}`}
              ></button>
              <div class="cor-linha__texto">
                <p class="mono cor-linha__token">
                  {c.token} <span class="cor-linha__hex">{c.hex}</span>
                </p>
                <p class="cor-linha__papel">{c.papel}</p>
              </div>
              <p class="cor-linha__contraste mono">{c.contraste}</p>
            </li>
          ))}
        </ul>

        <div class="aviso reveal">
          <p class="mono rotulo">A regra da menta mudou com o tema</p>
          <p>
            No tema claro a menta dava 1.45:1 contra a página. Era linda e não lia, então ficava
            proibida como texto e só podia marcar. No escuro ela dá 11.74:1 e finalmente escreve.
            É a mesma cor do Cérebro fazendo um trabalho maior.
          </p>
          <p>
            O que não mudou é a ração. A menta continua em marcador, link, ponto de estado e dado
            vivo, nunca em bloco grande e nunca no botão. E quando ela é o fundo, o texto em cima
            dela é escuro, porque menta com letra clara não lê.
          </p>
          <div class="aviso__prova">
            <p class="prova prova--menta">Menta como texto, 11.74:1</p>
            <p class="prova prova--enfase">Menta de ênfase, 13.10:1</p>
            <p class="prova prova--cheia">Menta cheia com texto escuro</p>
          </div>
        </div>
      </div>
    </section>

    <section class="secao secao--tingida" id="tipografia">
      <div class="limite">
        <h2 class="reveal">Tipografia</h2>
        <p class="secao__intro reveal">
          Duas famílias e três vozes. O título não é negrito: ele é grande e contido. A autoridade
          vem do tamanho e do tracking apertado, nunca do peso. Esse é o gesto que separa este
          sistema do padrão de todo site de tecnologia.
        </p>

        <div class="vozes reveal">
          <article class="voz">
            <p class="mono rotulo">Voz editorial</p>
            <p class="voz__amostra" style="font-family:var(--fonte-display);font-size:2.5rem;letter-spacing:-0.025em;line-height:1">
              Geist
            </p>
            <p class="voz__uso">Título e display, peso 400. Nunca em caixa alta, nunca em negrito.</p>
          </article>
          <article class="voz">
            <p class="mono rotulo">Voz de interface</p>
            <p class="voz__amostra" style="font-family:var(--fonte-ui);font-size:2.5rem;line-height:1">
              Geist
            </p>
            <p class="voz__uso">Corpo, botão, rótulo e link. Peso 400 pro texto, 500 pra ênfase.</p>
          </article>
          <article class="voz">
            <p class="mono rotulo">Voz técnica</p>
            <p class="voz__amostra" style="font-family:var(--fonte-mono);font-size:2.5rem;line-height:1">
              Geist Mono
            </p>
            <p class="voz__uso">Terminal, token, metadado e dado numérico. Marca território técnico.</p>
          </article>
        </div>

        <h3 class="reveal sub">A escala</h3>
        <div class="escala reveal">
          {escala.map((e) => (
            <article class="escala__linha">
              <div class="escala__meta">
                <button type="button" class="ficha mono" data-copiar={e.token} aria-label={`Copiar ${e.token}`}>
                  {e.token}
                </button>
                <p class="mono escala__valor">{e.valor}</p>
                <p class="mono escala__detalhe">altura {e.altura} · tracking {e.tracking}</p>
              </div>
              <p
                class="escala__amostra"
                style={`font-size:var(${e.token});line-height:${e.altura};letter-spacing:${e.tracking === 'normal' ? 'normal' : e.tracking};font-family:${e.voz === 'mono' ? 'var(--fonte-mono)' : e.voz === 'display' ? 'var(--fonte-display)' : 'var(--fonte-ui)'}`}
              >
                {e.amostra}
              </p>
            </article>
          ))}
        </div>

        <h3 class="reveal sub">A prosa</h3>
        <div class="prosa reveal">
          <p>
            O texto corrido do Hub vive entre 65 e 75 caracteres por linha. Mais largo que isso, o
            olho perde o começo da linha seguinte. Mais estreito, a leitura vira degrau. A medida
            está travada num token, então nenhuma tela precisa decidir de novo.
          </p>
          <p>
            A ênfase se faz com <strong>peso 500</strong>, com <a href="#cor">link sublinhado</a> ou
            com <code>marcação técnica</code>. Nunca com cor solta no meio da frase, nunca com
            itálico decorativo, nunca com caixa alta pra gritar.
          </p>
        </div>
      </div>
    </section>

    <section class="secao" id="espaco">
      <div class="limite">
        <h2 class="reveal">Espaço</h2>
        <p class="secao__intro reveal">
          Base de 4 pixels. Todo respiro do Hub é um múltiplo dela, o que faz duas telas feitas em
          semanas diferentes terem o mesmo ritmo. Entre seções, a separação é generosa. Dentro
          delas, o agrupamento é apertado. Tudo com o mesmo gap vira papel de parede.
        </p>
        <ul class="espacos reveal">
          {espacos.map((v) => (
            <li class="espaco">
              <button type="button" class="ficha mono" data-copiar={`--e-${v}`} aria-label={`Copiar --e-${v}`}>
                --e-{v}
              </button>
              <span class="espaco__barra" style={`width:${v}px`} aria-hidden="true"></span>
              <span class="mono espaco__valor">{v}px</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="secao secao--tingida" id="forma">
      <div class="limite">
        <h2 class="reveal">Forma e superfície</h2>
        <p class="secao__intro reveal">
          O raio é binário: pílula ou card. Não existe arredondamento intermediário inventado no
          meio do caminho. A profundidade tem dois recursos e eles nunca se empilham: o tom da
          superfície separa camada em fundo liso, e uma sombra larga e rasa levanta o card quando
          o fundo tem textura.
        </p>

        <div class="formas reveal">
          <article class="forma">
            <div class="forma__amostra" style="border-radius:var(--raio-pilula)"></div>
            <button type="button" class="ficha mono" data-copiar="--raio-pilula">--raio-pilula</button>
            <p class="forma__uso">Botão, tag e aba. A forma de assinatura.</p>
          </article>
          <article class="forma">
            <div class="forma__amostra" style="border-radius:var(--raio-card)"></div>
            <button type="button" class="ficha mono" data-copiar="--raio-card">--raio-card</button>
            <p class="forma__uso">Card e painel grande. 16px.</p>
          </article>
          <article class="forma">
            <div class="forma__amostra" style="border-radius:var(--raio-media)"></div>
            <button type="button" class="ficha mono" data-copiar="--raio-media">--raio-media</button>
            <p class="forma__uso">Mídia e bloco de terminal. 12px.</p>
          </article>
          <article class="forma">
            <div class="forma__amostra" style="border-radius:var(--raio-card-sm)"></div>
            <button type="button" class="ficha mono" data-copiar="--raio-card-sm">--raio-card-sm</button>
            <p class="forma__uso">Card pequeno e item de lista. 8px.</p>
          </article>
          <article class="forma">
            <div class="forma__amostra" style="border-radius:var(--raio-campo)"></div>
            <button type="button" class="ficha mono" data-copiar="--raio-campo">--raio-campo</button>
            <p class="forma__uso">Campo de formulário. 6px.</p>
          </article>
        </div>

        <h3 class="reveal sub">A profundidade</h3>
        <div class="profundidades reveal">
          <article class="prof">
            <div class="prof__amostra prof__amostra--anel"></div>
            <button type="button" class="ficha mono" data-copiar="--anel">--anel</button>
            <p class="prof__uso">
              O anel de 1 pixel. O padrão pra separar em fundo liso, sem sugerir que a peça
              levantou.
            </p>
          </article>
          <article class="prof">
            <div class="prof__fundo" aria-hidden="true">
              <div class="prof__amostra prof__amostra--sombra"></div>
            </div>
            <button type="button" class="ficha mono" data-copiar="--sombra-card">--sombra-card</button>
            <p class="prof__uso">
              Uma sombra só, larga e rasa. Entra quando o card fica sobre a grade pontilhada, que
              é o caso da listagem de playbooks. Aqui o card também é mais claro que a página.
            </p>
          </article>
          <article class="prof">
            <div class="prof__amostra prof__amostra--tom"></div>
            <button type="button" class="ficha mono" data-copiar="--superficie">--superficie</button>
            <p class="prof__uso">
              O tom sozinho. Em fundo liso é o que agrupa, sem sombra e sem borda. É o que esta
              página usa em todo bloco.
            </p>
          </article>
        </div>

        <div class="aviso reveal">
          <p class="mono rotulo">A ilha clara</p>
          <p>
            O card de playbook roda no tema claro dentro da página escura. Não é paleta
            duplicada: o card leva <code>data-tema="claro"</code> e tudo dentro dele herda o tema
            inteiro, então texto, tag, borda e capa continuam com contraste conferido. É assim
            que se faz qualquer ilha de tema no Hub.
          </p>
          <p>
            A regra que vem junto: <strong>a elevação nunca mora dentro da ilha</strong>. Sombra e
            anel são relativos ao que está atrás, e o que está atrás é a página. Se a sombra
            nascer dentro do card, ela usa o tema errado e a silhueta some no fundo.
          </p>
        </div>

        <h3 class="reveal sub">As cinco camadas</h3>
        <ul class="superficies reveal">
          {superficies.map((s) => (
            <li class="superficie" style={`background:${s.hex}`}>
              <span class={`superficie__nivel mono ${s.nivel === '4' ? 'invertido' : ''}`}>{s.nivel}</span>
              <div class={s.nivel === '4' ? 'invertido' : ''}>
                <p class="superficie__nome">{s.nome}</p>
                <p class="mono superficie__token">{s.token}</p>
                <p class="superficie__uso">{s.uso}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="secao" id="componentes">
      <div class="limite">
        <h2 class="reveal">Componentes</h2>
        <p class="secao__intro reveal">
          Uma ação primária por tela, e ela é preta. Todo o resto é fantasma, contornado ou tonal.
          Botão colorido não existe neste sistema: a cor está reservada pro que sinaliza, não pro
          que clica.
        </p>

        <div class="grade-comp reveal">
          <article class="bloco">
            <p class="mono rotulo">Ação</p>
            <div class="bloco__demo">
              <button type="button" class="btn btn--cheio">Baixar o material</button>
              <button type="button" class="btn btn--fantasma">Ver o que tem dentro</button>
              <button type="button" class="btn btn--compacto">Entrar</button>
            </div>
            <p class="bloco__nota">
              Cheio para a única conversão da tela. Fantasma ao lado dele. Compacto só na barra do
              topo. Todos com 44 pixels de altura mínima, que é o alvo de toque no celular.
            </p>
          </article>

          <article class="bloco">
            <p class="mono rotulo">Selo e marcação</p>
            <div class="bloco__demo">
              <span class="pilula">Novo: guia de agentes</span>
              <span class="tag mono">operação</span>
              <span class="estado"><span class="estado__ponto" aria-hidden="true"></span>No ar</span>
            </div>
            <p class="bloco__nota">
              A pílula marca lançamento e só isso. A menta aparece aqui, no ponto de estado, que é o
              tamanho certo pra ela: pequena e funcional.
            </p>
          </article>

          <article class="bloco bloco--largo">
            <p class="mono rotulo">Bloco de terminal</p>
            <div class="terminal">
              <div class="terminal__topo" aria-hidden="true">
                <span class="terminal__ponto" style="background:#ff5f57"></span>
                <span class="terminal__ponto" style="background:#ffbd2e"></span>
                <span class="terminal__ponto" style="background:#28c840"></span>
              </div>
              <pre class="terminal__corpo"><code><span class="terminal__aviso">$</span> npm run dev

  vkoshub   <span class="terminal__vivo">pronto</span> em 412 ms
  local     http://localhost:4321
  rotas     1 gerada, <span class="terminal__vivo">0 erro</span></code></pre>
            </div>
            <p class="bloco__nota">
              A única superfície escura do sistema. Aqui a menta pode ser texto, porque contra o
              carvão ela dá 10.83:1. Os três pontos são decoração de mockup, não token de cor.
            </p>
          </article>

          <article class="bloco">
            <p class="mono rotulo">Abas</p>
            <div class="abas" role="group" aria-label="Exemplo de abas">
              <button type="button" class="aba aba--ativa mono">Guia</button>
              <button type="button" class="aba mono">Projeto</button>
              <button type="button" class="aba mono">Modelo</button>
            </div>
            <p class="bloco__nota">
              Pílula em mono. Ativa é preta com texto claro, inativa é transparente com texto de
              apoio. Sem borda na inativa: o contraste do texto já separa.
            </p>
          </article>

          <article class="bloco">
            <p class="mono rotulo">Lista de checagem</p>
            <ul class="checagem">
              <li>Material aberto, sem cadastro</li>
              <li>Arquivo pronto pra usar hoje</li>
              <li>Atualizado quando a ferramenta muda</li>
            </ul>
            <p class="bloco__nota">
              O traço de checagem é da cor da tinta, não da menta. Cor em toda linha de lista vira
              ruído e a lista perde a hierarquia.
            </p>
          </article>

          <article class="bloco">
            <p class="mono rotulo">Card de material</p>
            <a class="card-material" href="#componentes">
              <span class="tag mono">Guia</span>
              <span class="card-material__titulo">Como montar seu primeiro agente</span>
              <span class="card-material__meta mono">12 páginas · leitura de 20 min</span>
            </a>
            <p class="bloco__nota">
              Card inteiro é um link, não um div com clique. O hover sobe 2 pixels e o anel aparece.
              É convite ao clique, não pirueta.
            </p>
          </article>

          <article class="bloco bloco--largo">
            <p class="mono rotulo">Campo de formulário</p>
            <div class="campos">
              <div class="campo">
                <label for="demo-nome">Seu nome</label>
                <input id="demo-nome" name="demo-nome" type="text" autocomplete="name" placeholder="Como você assina" />
                <p class="campo__ajuda">Rótulo sempre presente. Placeholder não é rótulo: ele some quando a pessoa digita.</p>
              </div>
              <div class="campo">
                <label for="demo-email">Seu email</label>
                <input id="demo-email" name="demo-email" type="email" autocomplete="email" class="campo--erro" value="jesse@" />
                <p class="campo__erro" role="alert">Falta o domínio do email, algo como nome@empresa.com.</p>
              </div>
            </div>
            <p class="consentimento">
              Ao enviar, você concorda que a gente entre em contato sobre o seu pedido.
            </p>
            <p class="bloco__nota">
              Estes campos são amostra, não formulário: não existe botão de envio aqui de propósito,
              porque formulário sem destino é o defeito mais caro que uma página pode ter. A linha
              de consentimento acima é obrigatória ao lado de qualquer botão de envio de verdade.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="secao secao--tingida" id="movimento">
      <div class="limite">
        <h2 class="reveal">Movimento</h2>
        <p class="secao__intro reveal">
          Uma curva só, de saída exponencial. Nada de salto, nada de elástico. Todo movimento tem
          motivo dizível em uma frase, e quem pede menos movimento no sistema operacional recebe a
          página parada.
        </p>

        <ul class="motions reveal">
          {motions.map((m) => (
            <li class="motion">
              <button type="button" class="ficha mono" data-copiar={m.token} aria-label={`Copiar ${m.token}`}>
                {m.token}
              </button>
              <p class="mono motion__valor">{m.valor}</p>
              <p class="motion__uso">{m.uso}</p>
              <span class="motion__pista" aria-hidden="true">
                <span class="motion__bola" style={`transition-duration:${m.valor}`}></span>
              </span>
            </li>
          ))}
        </ul>
        <p class="mono dica reveal">Passe o mouse na pista para ver a duração. A curva é a mesma nas três.</p>

        <div class="aviso reveal">
          <p class="mono rotulo">A textura de fundo</p>
          <p>
            A grade pontilhada é uma camada fixa atrás do site inteiro e ela fica parada. O
            conteúdo sobe por cima: é o efeito de janela, onde o fundo é o mundo lá fora e a
            página é o que passa na frente. Fundo que se mexe junto com a rolagem rouba o olho
            do texto, e aqui o texto é o produto.
          </p>
          <p>
            Sem transform e sem script, ela não custa nada por quadro de rolagem. A profundidade
            vem de ela ser quase transparente e nunca chegar perto do conteúdo, não de
            movimento.
          </p>
        </div>

        <div class="aviso reveal">
          <p class="mono rotulo">A regra do reveal</p>
          <p>
            A página nasce inteira. O JavaScript só adiciona uma classe que autoriza o efeito de
            entrada. Se o script falhar, se a rede cair ou se a pessoa desligar o JavaScript, o
            conteúdo continua lá. Seção que começa invisível esperando um script é uma tela em
            branco esperando pra acontecer.
          </p>
        </div>
      </div>
    </section>

    <section class="secao" id="voz">
      <div class="limite">
        <h2 class="reveal">Voz</h2>
        <p class="secao__intro reveal">
          O visual e o texto são a mesma decisão. De nada adianta a página ficar contida se a frase
          dentro dela for inflada. Isto vem do Cérebro e vale pra todo texto do Hub.
        </p>

        <div class="voz-grade reveal">
          <article class="bloco">
            <p class="mono rotulo">Faça</p>
            <ul class="checagem">
              <li>Frase curta como arma, com uma longa de vez em quando pra dar respiro</li>
              <li>Antítese pra marcar posição: não é isso, é aquilo</li>
              <li>Concreto com nome: o arquivo, o número, a ferramenta</li>
              <li>Autoridade pelo tamanho e pela contenção, nunca pelo peso</li>
              <li>Uma ação primária por tela, repetida com o mesmo rótulo</li>
            </ul>
          </article>
          <article class="bloco">
            <p class="mono rotulo">Não faça</p>
            <ul class="checagem checagem--nao">
              <li>Travessão como aparte, que é o vício de IA número um aqui</li>
              <li>Pontuação picada, cortando o que deveria fluir numa tirada só</li>
              <li>Jargão: alavancar, sinergia, tracionar</li>
              <li>Promessa aspiracional: viralizar, enriquecer, liberdade</li>
              <li>Número inventado no lugar de prova de verdade</li>
            </ul>
          </article>
        </div>

        <div class="aviso reveal">
          <p class="mono rotulo">Por que a página é cor de papel</p>
          <p>
            Fundo creme costuma ser reflexo de quem quer parecer acolhedor sem trabalhar pra isso.
            Aqui ele é decisão: o off-white existe pra tirar o estridente do branco puro numa tela
            que a pessoa vai encarar por muito tempo lendo material. Está declarado no Cérebro, e é
            isso que separa a escolha do reflexo.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Rodape />

  <p class="aviso-copia mono" role="status" aria-live="polite" data-aviso></p>
</Base>

