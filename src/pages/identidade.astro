    padding: var(--e-24);
    background: var(--pagina);
    border-radius: var(--raio-card);
  }

  .motion__valor {
    font-size: var(--t-legenda);
    color: var(--apoio);
  }

  .motion__uso {
    font-size: var(--t-corpo-sm);
    color: var(--apoio);
  }

  .motion__pista {
    display: block;
    height: 44px;
    background: var(--superficie);
    border-radius: var(--raio-pilula);
    position: relative;
    overflow: hidden;
  }

  .motion__bola {
    position: absolute;
    top: 50%;
    left: 6px;
    width: 32px;
    height: 32px;
    margin-top: -16px;
    border-radius: var(--raio-pilula);
    background: var(--tinta);
    transition-property: transform;
    transition-timing-function: var(--curva);
  }

  .motion__pista:hover .motion__bola {
    transform: translateX(calc(100cqw - 44px));
  }

  .motion__pista {
    container-type: inline-size;
  }

  @media (min-width: 780px) {
    .motion {
      grid-template-columns: 160px 100px minmax(0, 1fr) 200px;
      align-items: center;
      gap: var(--e-24);
    }
    .motion .ficha {
      justify-self: start;
    }
  }

  /* ---------- voz ---------- */
  .voz-grade {
    display: grid;
    gap: var(--e-24);
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  /* ---------- aviso de copia ---------- */
  .aviso-copia {
    position: fixed;
    left: 50%;
    bottom: var(--e-24);
    transform: translate(-50%, 12px);
    z-index: var(--z-toast);
    margin: 0;
    padding: var(--e-12) var(--e-20);
    background: var(--tinta);
    color: var(--sobre-tinta);
    border-radius: var(--raio-pilula);
    font-size: var(--t-corpo-sm);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--micro) var(--curva), transform var(--micro) var(--curva);
  }

  .aviso-copia.visivel {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<script>
  // Copiar o valor do token. Ação de verdade, por isso os specimens são <button>.
  const aviso = document.querySelector<HTMLElement>('[data-aviso]');
  let timer: ReturnType<typeof setTimeout> | undefined;

  function anunciar(texto: string) {
    if (!aviso) return;
    aviso.textContent = texto; // textContent, nunca innerHTML
    aviso.classList.add('visivel');
    clearTimeout(timer);
    timer = setTimeout(() => aviso.classList.remove('visivel'), 1800);
  }

  document.querySelectorAll<HTMLElement>('[data-copiar]').forEach((el) => {
    el.addEventListener('click', async () => {
      const valor = el.dataset.copiar;
      if (!valor) return;
      try {
        await navigator.clipboard.writeText(valor);
        anunciar(`Copiado: ${valor}`);
      } catch {
        anunciar(`Não deu pra copiar. O valor é ${valor}`);
      }
    });
  });
</script>
