    color: var(--sobre-painel);
    font-size: var(--t-corpo-sm);
    line-height: 1.7;
    overflow-x: auto;
  }

  /* A menta sinaliza o que importa. O resto do terminal é neutro. */
  .terminal__vivo {
    color: var(--menta);
  }

  .terminal__aviso {
    color: var(--linha-forte);
  }

  .abas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
