    color: var(--tinta);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-campo);
    font-family: var(--fonte-ui);
    font-size: var(--t-corpo);
  }

  .campo input::placeholder {
    color: var(--apoio);
  }

  .campo input.campo--erro {
    border-color: var(--sinal-erro);
