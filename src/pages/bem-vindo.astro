  }
  .topo { border-bottom: 0; border-radius: 0 0 22px 22px; backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%); }
  .troca { padding: 5px; backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%); }
  .troca button[aria-selected='true'] { background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(225, 255, 240, 0.82)); box-shadow: inset 0 1px 0 #fff, 0 6px 18px -8px color-mix(in srgb, var(--menta) 80%, transparent); color: #04140d; }
