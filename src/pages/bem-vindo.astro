  .passo__n { display: inline-block; color: var(--menta); font-size: var(--t-corpo-sm); border: 1px solid var(--menta-linha); border-radius: var(--raio-pilula); padding: 3px 10px; margin-bottom: var(--e-12); }
  .passo h3 { font-size: var(--t-titulo-sm); margin: 0 0 var(--e-12); letter-spacing: -0.015em; font-weight: 600; }
  .passo__txt p, .passo__txt li { color: var(--tinta-suave); line-height: var(--altura-corpo); }
  .passo__txt p { margin: 0 0 var(--e-12); }
  .passo__txt strong { color: var(--tinta); font-weight: 600; }
  .passo__txt a, .final a, .final__ver a { color: var(--menta-fundo); text-underline-offset: 3px; }
  .mini { margin: 0 0 var(--e-12); padding-left: 1.3em; display: grid; gap: 6px; }
  .mini li::marker { color: var(--menta); font-weight: 600; }
  .nota { font-size: var(--t-corpo-sm); color: var(--apoio) !important; border-left: 2px solid var(--menta-linha); padding-left: 12px; }
  kbd { font-family: var(--fonte-mono); font-size: 0.85em; border: 1px solid var(--linha-forte); border-bottom-width: 2px; border-radius: 5px; padding: 1px 6px; color: var(--tinta); }

  .frase { display: flex; gap: 8px; align-items: stretch; background: var(--carvao); border: 1px solid var(--menta-linha); border-radius: var(--raio-media); padding: 12px; margin: 0 0 var(--e-16); }
  .frase code { flex: 1; font-family: var(--fonte-mono); font-size: 0.82rem; color: var(--tinta); line-height: 1.5; word-break: break-all; align-self: center; }
  .frase__copiar { flex: none; min-height: 44px; min-width: 88px; border: 0; border-radius: var(--raio-campo); background: var(--tinta); color: var(--sobre-tinta); font: inherit; font-weight: 600; cursor: pointer; }
  .frase__copiar.copiado { background: var(--menta-solida); }

  .final { list-style: none; padding: 0; margin: 0 0 var(--e-24); counter-reset: f; display: grid; gap: var(--e-16); }
  .final li { counter-increment: f; position: relative; background: var(--superficie); border-radius: var(--raio-card); box-shadow: var(--sombra-card); padding: 22px 24px 22px 68px; }
  .final li::before { content: counter(f); position: absolute; left: 22px; top: 20px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--menta-veu); color: var(--menta); border: 1px solid var(--menta-linha); font-weight: 600; font-size: 0.9rem; }
  .final h3 { margin: 0 0 6px; font-size: var(--t-corpo-lg); font-weight: 600; }
  .final p { margin: 0; color: var(--tinta-suave); line-height: var(--altura-corpo); }
  .final code, .passo__txt code { font-family: var(--fonte-mono); font-size: 0.85em; background: var(--lavagem); border-radius: 4px; padding: 1px 6px; color: var(--tinta); }
  .final__ver { color: var(--tinta-suave); }

  .faq { display: grid; gap: 10px; }
  .faq details { background: var(--superficie); border-radius: var(--raio-card-sm); box-shadow: var(--anel); }
  .faq summary { cursor: pointer; padding: 16px 20px; min-height: 44px; font-weight: 500; list-style-position: inside; }
  .faq details p { margin: 0; padding: 0 20px 18px; color: var(--tinta-suave); line-height: var(--altura-corpo); }
  .rodape { border-top: 1px solid var(--linha); padding: var(--e-24) 0; color: var(--apoio); font-size: var(--t-corpo-sm); }
  .rodape__linha { display: flex; justify-content: space-between; gap: 16px; }
  .rodape a { color: var(--apoio); }
  .aviso-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* ---------- a tela animada ---------- */
  .cena { margin: 0; }
  .cena__tela { position: relative; aspect-ratio: 960 / 600; border-radius: 14px; overflow: hidden; background: #2b2d31; box-shadow: var(--sombra-card-alta); }
  .palco { position: absolute; left: 0; top: 0; width: 960px; height: 600px; transform-origin: 0 0; transition: transform 0.8s cubic-bezier(0.45, 0, 0.2, 1); font-family: 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif; color: #f2f2f2; background: linear-gradient(135deg, #1d3b5c, #2c5d7c 45%, #6b8fa8); overflow: hidden; }
  [data-cena^='m'] .palco { font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif; background: linear-gradient(160deg, #4b3d78, #b0607e 55%, #e3a06f); }
  .cena__legenda { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 10px; font-size: var(--t-corpo-sm); color: var(--apoio); }
  .cena__pausa { min-height: 36px; padding: 0 14px; border-radius: var(--raio-pilula); background: transparent; color: var(--tinta-suave); border: 1px solid var(--linha-forte); font: inherit; font-size: var(--t-legenda); cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .cena__pausa { display: none; } }

  .cursor { position: absolute; left: 0; top: 0; z-index: 50; transform: translate(820px, 520px); transition: transform 0.7s cubic-bezier(0.45, 0, 0.2, 1); filter: drop-shadow(0 2px 3px rgba(0,0,0,.45)); }
  .cursor.aperta path { transform: scale(0.86); transform-origin: 4px 3px; }
  .clique { position: absolute; z-index: 49; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: 50%; border: 2px solid rgba(255,255,255,.9); opacity: 0; pointer-events: none; }
  .clique.vai { animation: clique 0.5s ease-out; }
  @keyframes clique { from { opacity: 1; transform: scale(0.3); } to { opacity: 0; transform: scale(1.3); } }
  .sem-anim *, .sem-anim { transition: none !important; animation: none !important; }
  .sem-anim .cursor, .sem-anim .clique { display: none; }

  .surge { opacity: 0; visibility: hidden; transform: translateY(8px) scale(0.985); transition: opacity 0.28s ease, transform 0.28s ease, visibility 0s 0.28s; }
  .surge.on { opacity: 1; visibility: visible; transform: none; transition: opacity 0.28s ease, transform 0.28s ease, visibility 0s; }
  .surge-linha { display: none !important; }
  .surge-linha.on { display: grid !important; }
  .alvo { position: absolute; border-radius: 8px; box-shadow: 0 0 0 0 rgba(110,230,176,0); transition: box-shadow 0.3s; }
  .alvo.marcado { box-shadow: 0 0 0 3px #6ee6b0, 0 0 22px 4px rgba(110,230,176,.45); }
  .marcado { box-shadow: 0 0 0 2px #6ee6b0 !important; }

  /* janelas */
  .jan { position: absolute; inset: 14px; border-radius: 9px; overflow: hidden; background: #1f1f1f; box-shadow: 0 0 0 1px rgba(255,255,255,.12), 0 18px 50px rgba(0,0,0,.5); display: flex; flex-direction: column; }
  .jan--win { border-radius: 8px; }
  .jan__barra { flex: none; height: 38px; display: flex; align-items: center; gap: 12px; padding: 0 0 0 14px; background: #202124; font-size: 12px; color: #c8c8c8; }
  .jan--mac .jan__barra { background: #2a2a2c; padding-right: 14px; }
  .jan__luzes { display: inline-flex; gap: 8px; }
  .jan__luzes i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .jan__luzes i:nth-child(2) { background: #febc2e; }
  .jan__luzes i:nth-child(3) { background: #28c840; }
  .jan__url { flex: 1; display: flex; align-items: center; gap: 8px; height: 26px; padding: 0 14px; border-radius: 13px; background: #303134; color: #e8e8e8; font-size: 12.5px; max-width: 560px; }
  .jan--mac .jan__url { margin: 0 auto; justify-content: center; }
  .jan__titulo { flex: 1; font-size: 12px; color: #cfcfcf; }
  .jan--mac .jan__titulo { text-align: center; margin-right: 52px; }
  .jan__ctl { display: inline-flex; margin-left: auto; height: 100%; }
  .jan__ctl i { width: 46px; display: grid; place-items: center; font-style: normal; font-size: 12px; color: #ddd; }
  .jan__corpo { position: relative; flex: 1; overflow: hidden; background: #141413; }
  .jan--cheia .jan__corpo { background: #262624; }
  .jan--sem-barra .jan__barra { display: none; }
  .rolo { position: absolute; left: 0; top: 0; width: 100%; transition: transform 0.9s cubic-bezier(0.45, 0, 0.2, 1); }
  .jan--nav img { display: block; width: 932px; height: auto; }
  .jan--nav .alvo { transform-origin: 0 0; }

  /* app do Claude */
  .app { position: absolute; inset: 0; display: flex; background: #262624; color: #ece9e2; font-size: 13px; }
  .app__lado { width: 236px; flex: none; background: #1f1e1d; border-right: 1px solid #34332f; display: flex; flex-direction: column; padding: 10px 10px 10px; }
  .app__topo { display: flex; align-items: center; gap: 10px; height: 30px; margin-bottom: 14px; }
  .app__icones { display: inline-flex; gap: 10px; color: #8d8a83; font-size: 12px; }
  .app__icones i { font-style: normal; }
  .ic-painel { width: 13px; height: 11px; border: 1.4px solid #8d8a83; border-radius: 2px; display: inline-block; }
  .app__troca { margin-left: auto; display: inline-flex; padding: 2px; border-radius: 9px; background: #2c2b28; }
  .app__troca b { width: 30px; height: 24px; display: grid; place-items: center; border-radius: 7px; color: #a19e96; }
  .app .t-chat { background: #3a3935; color: #f1eee8; }
  .app.modo-code .t-chat { background: transparent; color: #a19e96; }
  .app.modo-code .t-code { background: #3a3935; color: #f1eee8; }
  .app__menu { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
