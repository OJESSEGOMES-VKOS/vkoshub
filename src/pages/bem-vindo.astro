  .app__menu .apagado { color: #8d8a83; }
  .ic-mais { width: 18px; height: 18px; border-radius: 50%; background: #34332f; display: grid; place-items: center; font-size: 13px; }
  .ic-q { width: 14px; height: 12px; border: 1.4px solid #a19e96; border-radius: 3px; margin: 0 2px; }
  .app__rotulo { margin: 18px 8px 6px; font-size: 11.5px; color: #8d8a83; }
  .app__recentes .atual { background: #2f2e2b; color: #d6d3cc; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
  .ponto { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #8d8a83; margin-right: 6px; vertical-align: middle; }
  .app__usuario { margin-top: auto; display: flex; align-items: center; gap: 8px; padding: 8px 6px 2px; border-top: 1px solid #34332f; color: #e3e0d9; }
  .avatar { width: 24px; height: 24px; border-radius: 50%; background: #5a7d6b; display: grid; place-items: center; font-size: 11px; font-weight: 600; }
  .app__main { flex: 1; position: relative; display: flex; }
  .app__chat, .app__code { position: absolute; inset: 0; display: flex; flex-direction: column; padding: 18px 40px 22px; }
  .app__chat { align-items: center; justify-content: center; gap: 22px; }
  .app__code { display: none; }
  .app.modo-code .app__chat { display: none; }
  .app.modo-code .app__code { display: flex; }
  .app__ola { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 30px; color: #ece9e2; }
  .estrela { color: #d97757; margin-right: 6px; }
  .caixa { position: relative; width: 100%; border-radius: 16px; background: #30302d; box-shadow: 0 0 0 1px #45443f; padding: 14px 14px 10px; min-height: 92px; display: flex; flex-direction: column; }
  .caixa--chat { max-width: 560px; min-height: 100px; }
  .caixa__ph { color: #8d8a83; font-size: 13.5px; }
  .caixa__txt { color: #ece9e2; font-size: 13.5px; line-height: 1.45; min-height: 0; word-break: break-all; }
  .caixa__txt:empty { display: none; }
  .caixa__linha { margin-top: auto; display: flex; align-items: center; gap: 8px; padding-top: 10px; }
  .ctl { font-size: 12px; color: #c3c0b8; display: inline-flex; align-items: center; gap: 5px; }
  .ctl i { font-style: normal; color: #8d8a83; }
  .ctl--pill { padding: 4px 9px; border-radius: 8px; background: #3a3935; transition: box-shadow 0.2s; }
  .ctl--fraco { color: #8d8a83; }
  .ctl--dir { margin-left: auto; }
  .ctl--enviar { width: 28px; height: 28px; border-radius: 8px; background: #d97757; color: #fff; justify-content: center; font-size: 14px; }
  .app__conversa { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; padding-bottom: 14px; overflow: hidden; }
  .msg-user { align-self: flex-end; max-width: 78%; background: #13314d; color: #7cb8f5; border-radius: 12px; padding: 10px 14px; font-size: 13px; line-height: 1.45; word-break: break-all; }
  .msg-claude { max-width: 88%; font-size: 13.5px; line-height: 1.55; color: #ece9e2; }
  .msg-ferr { font-size: 12px; color: #a19e96; }
  .msg-ferr span { margin-left: 8px; color: #7ed9b2; }
  .menu { position: absolute; left: 108px; bottom: 2px; z-index: 3; width: 190px; padding: 5px; border-radius: 10px; background: #34332f; box-shadow: 0 0 0 1px #4a4944, 0 10px 30px rgba(0,0,0,.5); display: grid; gap: 2px; }
  .menu__item { padding: 7px 10px; border-radius: 6px; font-size: 13px; }
  .menu__item:first-child { background: #44433e; }
  .menu__item.apagado { color: #8d8a83; }
  .perm { border-radius: 12px; background: #2f2e2b; box-shadow: 0 0 0 1px #4a4944; padding: 12px 14px; font-size: 12.5px; max-width: 92%; }
  .perm code { display: block; font-family: Consolas, 'SF Mono', Menlo, monospace; font-size: 12px; background: #1d1c1a; border-radius: 6px; padding: 8px 10px; color: #e7c79a; word-break: break-all; }
  .perm__t { margin: 0 0 8px; color: #c3c0b8; font-weight: 600; }
  .perm__btns { display: flex; justify-content: flex-end; gap: 8px; margin-top: 10px; }
  .perm__btns span { padding: 6px 14px; border-radius: 8px; background: #3a3935; color: #e3e0d9; }
  .perm__btns .ok { background: #ece9e2; color: #1f1e1d; font-weight: 600; }
  .perm.aprovado { opacity: 0.55; }
  .etapas { list-style: none; margin: 0 0 10px; padding: 0; display: grid; gap: 9px; font-size: 13.5px; }
  .etapas b { display: inline-grid; place-items: center; width: 18px; color: #7ed9b2; margin-right: 6px; }
  .etapas .barra { display: inline-block; vertical-align: middle; margin-left: 10px; width: 180px; }

  /* instalador e login (Windows) */
  .barra { display: block; height: 5px; border-radius: 3px; background: rgba(255,255,255,.14); overflow: hidden; }
  .barra i { display: block; height: 100%; width: 0; background: #d97757; border-radius: 3px; transition: width 2.4s linear; }
  .logo-claude { color: #d97757; font-size: 22px; line-height: 1; }
  .logo-claude.grande { font-size: 40px; }
  .instalador { position: absolute; z-index: 6; left: 50%; top: 50%; width: 330px; margin: -80px 0 0 -165px; padding: 26px 28px; border-radius: 10px; background: #f6f5f2; color: #2a2a28; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
  .instalador p { margin: 12px 0 16px; font-size: 14px; }
  .instalador .barra { background: #e2dfd8; }
