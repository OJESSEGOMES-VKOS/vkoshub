  .uac__app { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; font-size: 15px; }
  .py-ic { width: 28px; height: 28px; border-radius: 6px; background: linear-gradient(135deg, #3776ab 50%, #ffd43b 50%); }
  .uac__d { margin: 0 0 10px; color: #cfcfcf; line-height: 1.5; }
  .uac__mais { margin: 0 0 18px; color: #60cdff; }
  .uac__btns { display: flex; gap: 10px; }
  .uac__btns span { flex: 1; height: 32px; display: grid; place-items: center; border-radius: 4px; background: #2d2d2d; box-shadow: inset 0 0 0 1px #3f3f3f; }
