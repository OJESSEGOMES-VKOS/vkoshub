  .login__t { font-family: Georgia, serif; font-size: 26px; margin: 4px 0 8px; color: #ece9e2; }
  .login__btn { width: 300px; height: 40px; border-radius: 10px; background: #30302d; box-shadow: 0 0 0 1px #4a4944; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 13.5px; }
  .login__btn.claro { background: #ece9e2; color: #1f1e1d; font-weight: 600; box-shadow: none; }
  .g { color: #4285f4; font-family: Arial, sans-serif; }
  .login__ou { font-size: 11px; color: #8d8a83; }
  .login__campo { width: 300px; height: 40px; border-radius: 10px; background: #1f1e1d; box-shadow: 0 0 0 1px #4a4944; display: flex; align-items: center; padding: 0 14px; color: #8d8a83; font-size: 13.5px; }

  /* downloads */
  .flyout { position: absolute; z-index: 5; right: 18px; top: 6px; width: 330px; padding: 12px; border-radius: 10px; background: #2b2b2b; box-shadow: 0 0 0 1px #444, 0 16px 40px rgba(0,0,0,.55); font-size: 13px; }
  .flyout__t { margin: 0 0 10px; font-weight: 600; }
  .flyout__item { display: flex; gap: 12px; align-items: center; padding: 8px; border-radius: 8px; background: #353535; }
  .flyout__item b { display: block; font-weight: 600; }
  .flyout__item a { color: #6cb6ff; text-decoration: underline; font-size: 12.5px; }
  .flyout__item small { color: #aaa; }
  .flyout--mac { width: 290px; right: 40px; }
  .arq-ic { width: 26px; height: 32px; border-radius: 3px; background: linear-gradient(#e9e9e9, #cfcfcf); position: relative; flex: none; }
  .arq-ic::after { content: ''; position: absolute; left: 6px; right: 6px; top: 10px; height: 12px; border-radius: 2px; background: #d97757; }
  .arq-ic.dmg::after { background: #8c8c8c; }

  /* diálogo de pasta do Windows */
  .dlg { position: absolute; z-index: 8; }
  .dlg--win { left: 90px; top: 50px; width: 780px; height: 490px; border-radius: 8px; background: #202020; box-shadow: 0 0 0 1px #3a3a3a, 0 30px 80px rgba(0,0,0,.6); display: flex; flex-direction: column; font-size: 12.5px; color: #f0f0f0; }
  .dlg__barra { height: 34px; display: flex; align-items: center; padding-left: 14px; font-size: 12px; }
  .dlg__barra .jan__ctl { margin-left: auto; }
  .dlg__end { display: flex; align-items: center; gap: 10px; padding: 6px 12px; }
  .seta { color: #9a9a9a; font-size: 13px; }
  .dlg__trilho { flex: 1; height: 28px; display: flex; align-items: center; padding: 0 10px; border-radius: 4px; background: #2d2d2d; }
  .dlg__busca { width: 190px; height: 28px; display: flex; align-items: center; padding: 0 10px; border-radius: 4px; background: #2d2d2d; color: #9a9a9a; }
  .dlg__ferr { display: flex; gap: 22px; padding: 8px 16px; border-bottom: 1px solid #333; }
  .dlg__ferr span { padding: 3px 6px; border-radius: 4px; }
  .dlg__meio { flex: 1; display: flex; min-height: 0; }
  .dlg__nav { list-style: none; margin: 0; padding: 8px 6px; width: 190px; border-right: 1px solid #333; display: grid; align-content: start; gap: 1px; }
  .dlg__nav li { padding: 5px 12px; border-radius: 4px; }
  .dlg__nav .sep { margin-top: 8px; }
  .dlg__nav .sel { background: #3a3a3a; }
  .dlg__lista { flex: 1; padding: 6px 10px; }
  .dlg__lista .cab, .dlg__lista .item { display: grid; grid-template-columns: 1.4fr 1fr 0.9fr; gap: 10px; margin: 0; padding: 5px 8px; border-radius: 4px; }
  .dlg__lista .cab { color: #a8a8a8; border-bottom: 1px solid #333; border-radius: 0; margin-bottom: 4px; }
  .dlg__lista .item span:first-child { display: flex; align-items: center; gap: 8px; }
  .dlg__lista .item span + span { color: #a8a8a8; }
