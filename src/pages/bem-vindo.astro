  .frase { border: 0; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), inset 0 0 0 1px var(--menta-linha); }
  .final__ver { text-align: center; }
  .rodape { border-top: 0; }

  /* WhatsApp flutuante: cápsula de vidro com o ícone verde; no celular vira só o círculo */
  .zap { position: fixed; z-index: 60; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); display: inline-flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 20px 0 15px; border-radius: 999px; color: var(--tinta); text-decoration: none; font-weight: 600; font-size: var(--t-corpo-sm); backdrop-filter: blur(18px) saturate(170%); -webkit-backdrop-filter: blur(18px) saturate(170%); transition: transform 0.2s ease; }
  .zap svg { flex: none; color: #25d366; filter: drop-shadow(0 0 10px rgba(37, 211, 102, 0.45)); }
  .zap:hover { transform: translateY(-2px); }
  .zap:focus-visible { outline: 2px solid var(--menta); outline-offset: 3px; }
  @media (max-width: 640px) { .zap { width: 56px; padding: 0; justify-content: center; } .zap__txt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) { .zap { transition: none; } }
  .bloco--ajuda { padding-bottom: calc(var(--gap-secao) + 40px); }

  /* passo 08: o vídeo pronto sobe por cima da conversa, em pé, como no celular */
  .pronto { position: absolute; z-index: 12; right: 46px; top: 50%; margin-top: -232px; display: grid; justify-items: center; gap: 8px; }
  .pronto video { display: block; width: 234px; height: 416px; object-fit: cover; border-radius: 22px; background: #000; box-shadow: 0 0 0 5px #111, 0 0 0 6px #444, 0 30px 70px rgba(0,0,0,.7); }
  .pronto__nome { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: rgba(0,0,0,.6); color: #e8e8e8; font-family: Consolas, Menlo, monospace; }
  /* na conversa, mensagem que ainda não chegou não ocupa lugar (senão empurra as de cima pra fora) */
  .app__conversa .surge:not(.on) { display: none; }
  .app__conversa .surge.on { animation: chega 0.3s ease; }
  @keyframes chega { from { opacity: 0; transform: translateY(8px); } }
  .barra--linha { display: inline-block; width: 160px; vertical-align: middle; }
  .barra--linha i { background: #7ed9b2; }
</style>

<script>
  type Passo = [string, ...any[]];
  const FRASE = 'Instale o EditOS seguindo https://github.com/OJESSEGOMES-VKOS/EditOS/blob/main/PREPARAR.md';
  const BREW = '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"';

  const planos: Passo[] = [['espera', 700], ['rola', 'rolo', 120], ['espera', 500], ['vai', 'pro'], ['clica', 'pro'], ['classe', 'pro', 'marcado'], ['espera', 1800]];
  const codeTab: Passo[] = [['espera', 600], ['vai', 'btn-code'], ['clica', 'btn-code'], ['classe', 'app', 'modo-code'], ['espera', 700], ['vai', 'pasta'], ['espera', 1600]];
  const frase = (app: string): Passo[] => [
    ['espera', 500], ['vai', 'caixa'], ['clica', 'caixa'], ['classe', 'ph', 'some'], ['oculta', 'ph'], ['digita', 'digitado', FRASE, 34],
    ['vai', 'enviar'], ['clica', 'enviar'], ['texto', 'digitado', ''], ['mostra-el', 'ph'], ['mostra', 'eu'], ['espera', 900],
    ['mostra', 'r1'], ['espera', 900], ['mostra', 'r2'], ['espera', 700], ['mostra', 'r3'], ['espera', 1800],
  ];
  const espera: Passo[] = [
    ['espera', 500], ['mostra', 'e1'], ['espera', 700], ['mostra', 'e2'], ['espera', 700], ['mostra', 'e3'], ['largura', 'barra7', 2600],
    ['texto', 'e3b', '✓'], ['mostra', 'e4'], ['espera', 600], ['mostra', 'fim'], ['espera', 2200],
  ];

  // A pessoa escreve na caixa, envia e a mensagem vira balão.
  const diz = (texto: string, balao: string): Passo[] => [
    ['vai', 'caixa'], ['clica', 'caixa'], ['oculta', 'ph'], ['digita', 'digitado', texto, 22], ['vai', 'enviar'], ['clica', 'enviar'],
    ['texto', 'digitado', ''], ['mostra-el', 'ph'], ['mostra', balao],
  ];
  const primeiro: Passo[] = [
    ['espera', 1000], ...diz('Jessé', 'u1'), ['espera', 700], ['mostra', 'c2'], ['espera', 1100],
    ...diz('@ojessegomes', 'u2'), ['espera', 700], ['mostra', 'c3'], ['espera', 1400],
    ...diz('Edite o meu vídeo gravacao.mp4 no rosto-telas', 'u3'), ['espera', 600], ['mostra', 't1'], ['espera', 900],
    ['mostra', 't2'], ['espera', 800], ['mostra', 't3'], ['largura', 'barra8', 2400], ['mostra', 'c4'], ['espera', 700],
    ['mostra', 'pronto'], ['toca', 'video'], ['espera', 6000],
  ];

  const ROTEIROS: Record<string, Passo[]> = {
    w8: primeiro,
    m8: primeiro,
    w1: planos,
    m1: planos,
    w2: [
      ['espera', 600], ['vai', 'baixar'], ['clica', 'baixar'], ['classe', 'baixar', 'marcado'], ['espera', 500], ['mostra', 'flyout'], ['espera', 700],
      ['vai', 'abrir'], ['clica', 'abrir'], ['some', 'flyout'], ['mostra', 'instalador'], ['largura', 'barra', 2400], ['espera', 400],
      ['some', 'instalador'], ['mostra', 'login'], ['espera', 700], ['vai', 'google'], ['clica', 'google'], ['espera', 1600],
    ],
    m2: [
      ['espera', 600], ['vai', 'baixar'], ['clica', 'baixar'], ['classe', 'baixar', 'marcado'], ['espera', 500], ['mostra', 'flyout'], ['espera', 700],
      ['vai', 'abrir'], ['clica', 'abrir'], ['clica', 'abrir'], ['some', 'flyout'], ['mostra', 'dmg'], ['espera', 800],
      ['arrasta', 'icone', 'aplicativos'], ['espera', 500], ['some', 'dmg'], ['mostra', 'gate'], ['espera', 900],
      ['vai', 'abrir-app'], ['clica', 'abrir-app'], ['espera', 1400],
    ],
    w3: codeTab,
    m3: codeTab,
    w4: [
      ['espera', 500], ['vai', 'pasta'], ['clica', 'pasta'], ['mostra', 'menu'], ['espera', 500], ['vai', 'open'], ['clica', 'open'],
      ['some', 'menu'], ['mostra', 'dlg'], ['espera', 800], ['vai', 'novapasta'], ['clica', 'novapasta'], ['mostra', 'linha-nova'],
      ['espera', 600], ['digita', 'nome-nova', 'estudio-claude', 12], ['classe', 'nome-nova', 'fixo'], ['texto', 'campo-pasta', 'estudio-claude'],
      ['espera', 500], ['vai', 'selecionar'], ['clica', 'selecionar'], ['some', 'dlg'], ['texto', 'pasta-nome', 'estudio-claude'],
      ['classe', 'pasta', 'marcado'], ['espera', 1800],
    ],
    m4: [
      ['espera', 500], ['vai', 'pasta'], ['clica', 'pasta'], ['mostra', 'menu'], ['espera', 500], ['vai', 'open'], ['clica', 'open'],
      ['some', 'menu'], ['mostra', 'dlg'], ['espera', 800], ['vai', 'novapasta'], ['clica', 'novapasta'], ['mostra', 'folha'],
      ['espera', 400], ['digita', 'campo-nome', 'estudio-claude', 12], ['vai', 'criar'], ['clica', 'criar'], ['some', 'folha'],
      ['mostra', 'linha-nova'], ['espera', 600], ['vai', 'selecionar'], ['clica', 'selecionar'], ['some', 'dlg'],
      ['texto', 'pasta-nome', 'estudio-claude'], ['classe', 'pasta', 'marcado'], ['espera', 1800],
    ],
    w5: frase('app5'),
    m5: frase('app5'),
    w6: [
      ['espera', 500], ['mostra', 'perm'], ['espera', 900], ['vai', 'allow'], ['clica', 'allow'], ['classe', 'perm', 'aprovado'],
      ['espera', 400], ['mostra', 'uac'], ['espera', 900], ['vai', 'sim'], ['clica', 'sim'], ['some', 'uac'], ['espera', 500],
      ['mostra', 'feito'], ['espera', 1800],
    ],
    m6: [
      ['espera', 700], ['mostra', 'term'], ['espera', 400], ['digita', 'tcmd', BREW, 60], ['espera', 300],
      ['acrescenta', 'tsaida', '\n==> Checking for `sudo` access (which may request your password)...\nPassword:'], ['mostra', 'dica'],
      ['espera', 2400], ['some', 'dica'],
      ['acrescenta', 'tsaida', '\n==> This script will install:\n/opt/homebrew/bin/brew\n\nPress RETURN/ENTER to continue or any other key to abort:'],
      ['espera', 1200], ['acrescenta', 'tsaida', '\n==> Downloading and installing Homebrew...'], ['espera', 1300],
      ['acrescenta', 'tsaida', '\n==> Installation successful!\n'], ['espera', 900], ['some', 'term'], ['espera', 400],
      ['mostra', 'perm'], ['espera', 700], ['vai', 'allow'], ['clica', 'allow'], ['classe', 'perm', 'aprovado'], ['espera', 1800],
    ],
    w7: espera,
    m7: espera,
  };

  const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;

  class Tocador {
    fig: HTMLElement; tela: HTMLElement; palco: HTMLElement; orig: string; roteiro: Passo[];
    k = 1; pausado = false; visivel = false; rodando = false; instantaneo = reduzir;
    constructor(fig: HTMLElement) {
      this.fig = fig;
      this.tela = fig.querySelector('.cena__tela')!;
      this.palco = fig.querySelector('.palco')!;
      this.orig = this.palco.innerHTML;
      this.roteiro = ROTEIROS[fig.dataset.cena!] ?? [];
      new ResizeObserver(() => this.ajusta()).observe(this.tela);
      this.ajusta();
      const botao = fig.querySelector<HTMLButtonElement>('[data-pausa]');
      botao?.addEventListener('click', () => {
        this.pausado = !this.pausado;
        botao.setAttribute('aria-pressed', String(this.pausado));
        botao.textContent = this.pausado ? 'Continuar' : 'Pausar';
      });
      new IntersectionObserver(([e]) => {
        this.visivel = e.isIntersecting;
        if (this.visivel && !this.rodando) this.roda();
      }, { threshold: 0.3 }).observe(this.tela);
    }
    // Câmera: em tela estreita (celular) a cena ganha zoom e acompanha a ação,
    // senão a tela inteira de 960px vira miniatura ilegível.
    s = 1; cx = 480; cy = 300;
    ajusta() {
      this.k = this.tela.clientWidth / 960 || 1;
      this.s = this.k * (this.tela.clientWidth < 480 && !this.instantaneo ? 1.75 : 1);
      this.camera();
    }
    camera() {
      const W = this.tela.clientWidth, H = this.tela.clientHeight, s = this.s;
      const tx = Math.min(0, Math.max(W - 960 * s, W / 2 - this.cx * s));
      const ty = Math.min(0, Math.max(H - 600 * s, H / 2 - this.cy * s));
      this.palco.style.transform = `translate(${tx}px, ${ty}px) scale(${s})`;
    }
    foca(el: HTMLElement | null) {
      if (!el || this.s === this.k) return;
      const { x, y } = this.centro(el); this.cx = x; this.cy = y; this.camera();
    }
    el(k: string) { return this.palco.querySelector<HTMLElement>(`[data-k="${k}"]`); }
    async espera(ms: number) {
      if (this.instantaneo) return;
      let t = 0;
      while (t < ms) {
        await new Promise((r) => setTimeout(r, 50));
        if (!this.pausado && this.visivel) t += 50;
      }
    }
    centro(el: HTMLElement) {
      const p = this.palco.getBoundingClientRect(), r = el.getBoundingClientRect();
      return { x: (r.left - p.left + r.width / 2) / this.s, y: (r.top - p.top + r.height / 2) / this.s };
    }
    async passo([acao, a, b, c]: Passo) {
      const el = typeof a === 'string' ? this.el(a) : null;
      const cursor = this.el('cursor')!;
      switch (acao) {
        case 'espera': return this.espera(a);
        case 'vai': { if (!el) return; const { x, y } = this.centro(el); cursor.style.transform = `translate(${x - 4}px, ${y - 3}px)`; this.foca(el); return this.espera(760); }
        case 'clica': {
          cursor.classList.add('aperta');
          const anel = this.el('clique')!; const { x, y } = el ? this.centro(el) : { x: 0, y: 0 };
          anel.style.left = `${x}px`; anel.style.top = `${y}px`; anel.classList.remove('vai'); void anel.offsetWidth; anel.classList.add('vai');
          await this.espera(160); cursor.classList.remove('aperta'); return this.espera(240);
        }
        case 'mostra': el?.classList.add('on'); this.foca(el); return this.espera(60);
        case 'some': el?.classList.remove('on'); return this.espera(60);
        case 'oculta': if (el) el.style.display = 'none'; return;
        case 'toca': if (el instanceof HTMLVideoElement && !this.instantaneo) el.play().catch(() => {}); return;
        case 'mostra-el': if (el) el.style.display = ''; return;
        case 'classe': el?.classList.add(b); return;
        case 'texto': if (el) el.textContent = b; return;
        case 'acrescenta': if (el) el.textContent += b; return this.espera(250);
        case 'rola': if (el) el.style.transform = `translateY(${-b}px)`; return this.espera(950);
        case 'largura': if (el) { el.style.transitionDuration = `${b}ms`; el.style.width = '100%'; } return this.espera(b);
        case 'digita': {
          if (!el) return;
          if (this.instantaneo) { el.textContent = b; return; }
          el.textContent = '';
          const passoMs = 1000 / (c || 16);
          let acumulado = 0;
          for (const letra of b as string) {
            el.textContent += letra; acumulado += passoMs;
            if (acumulado >= 50) { await this.espera(acumulado); acumulado = 0; }
          }
          return this.espera(300);
        }
        case 'arrasta': {
          const alvo = this.el(b); if (!el || !alvo) return;
          const de = this.centro(el), para = this.centro(alvo);
          cursor.style.transform = `translate(${de.x - 4}px, ${de.y - 3}px)`; await this.espera(760);
          cursor.classList.add('aperta');
          el.style.transform = `translate(${para.x - de.x}px, ${para.y - de.y}px) scale(0.8)`;
          cursor.style.transform = `translate(${para.x - 4}px, ${para.y - 3}px)`;
          await this.espera(950); cursor.classList.remove('aperta'); el.style.opacity = '0';
          return this.espera(200);
        }
      }
    }
    async roda() {
      this.rodando = true;
      if (this.instantaneo) {
        this.palco.classList.add('sem-anim');
        for (const p of this.roteiro) await this.passo(p);
        return;
      }
      for (;;) {
        this.palco.innerHTML = this.orig;
        this.cx = 480; this.cy = 300; this.camera();
        await this.espera(50);
        for (const p of this.roteiro) await this.passo(p);
        await this.espera(1400);
      }
    }
  }

  document.querySelectorAll<HTMLElement>('[data-cena]').forEach((f) => new Tocador(f));

  // Windows / Mac: abre no sistema de quem visita; o #mac ou #windows no link manda.
  const abas = [...document.querySelectorAll<HTMLButtonElement>('[data-troca] [role="tab"]')];
  const escolhe = (aba: HTMLButtonElement, foco = false) => {
    abas.forEach((b) => {
      const sel = b === aba;
      b.setAttribute('aria-selected', String(sel));
      b.tabIndex = sel ? 0 : -1;
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !sel;
    });
    if (foco) aba.focus();
  };
  abas.forEach((b, i) => {
    b.addEventListener('click', () => escolhe(b));
    b.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') escolhe(abas[(i + 1) % abas.length], true);
    });
  });
  const ehMac = location.hash === '#mac' || (location.hash !== '#windows' && /Mac/.test(navigator.userAgent) && !/iPhone|iPad/.test(navigator.userAgent));
  if (ehMac) escolhe(abas[1]);

  // Copiar a frase.
  const aviso = document.querySelector<HTMLElement>('[data-aviso]');
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copiar!);
        b.textContent = 'Copiado'; b.classList.add('copiado');
        if (aviso) aviso.textContent = 'Frase copiada. Agora cole no Claude.';
        setTimeout(() => { b.textContent = 'Copiar'; b.classList.remove('copiado'); }, 2200);
      } catch {
        const sel = getSelection(); const r = document.createRange();
        r.selectNodeContents(b.previousElementSibling!); sel?.removeAllRanges(); sel?.addRange(r);
        if (aviso) aviso.textContent = 'Frase selecionada. Aperte Ctrl+C ou Cmd+C pra copiar.';
      }
    });
  });
</script>
