  .pasta-ic { width: 18px; height: 14px; border-radius: 2px; background: linear-gradient(#f8d26a, #e8b43a); position: relative; display: inline-block; flex: none; }
  .editavel { font-weight: 400; background: #0b5cad; padding: 0 3px; outline: 1px solid #fff; }
  .editavel.fixo { background: transparent; outline: 0; }
  .dlg__pe { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-top: 1px solid #333; }
  .dlg__campo-r { color: #ccc; }
  .dlg__campo { flex: 1; height: 28px; display: flex; align-items: center; padding: 0 10px; border-radius: 4px; background: #2d2d2d; border-bottom: 1px solid #888; }
  .btn-win { min-width: 96px; height: 30px; display: grid; place-items: center; padding: 0 14px; border-radius: 4px; background: #2d2d2d; box-shadow: inset 0 0 0 1px #3f3f3f; }
  .btn-win.azul { background: #4cc2ff; color: #000; box-shadow: none; }

  /* UAC */
  .uac-fundo { position: absolute; inset: 0; z-index: 9; background: rgba(0,0,0,.55); display: grid; place-items: center; }
  .uac { width: 450px; background: #202020; border-radius: 8px; box-shadow: 0 0 0 1px #3c3c3c, 0 30px 80px rgba(0,0,0,.6); padding: 20px 22px 18px; font-size: 13px; }
