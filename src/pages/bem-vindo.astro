  /* ===== Vidro (liquid glass), no mesmo sistema da Biblioteca de Estilos =====
     Desempenho: as manchas de luz ficam paradas (blur grande animado trava) e o
     backdrop-filter só entra em 3 peças pequenas (topo, seletor, WhatsApp). Os
     cartões são vidro "pintado": degradê translúcido + reflexo, sem desfocar o
     que está atrás, então rolar a página com as telas animando não pesa. */
  body { background: transparent; }
  .vidro-fundo { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: #050807; }
  .vidro-fundo i { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.55; }
  .vidro-fundo i:nth-child(1) { width: 52vw; height: 52vw; top: -18vw; left: -12vw; background: radial-gradient(circle, color-mix(in srgb, var(--menta) 70%, transparent), transparent 70%); }
  .vidro-fundo i:nth-child(2) { width: 44vw; height: 44vw; top: 30vh; right: -16vw; background: radial-gradient(circle, #0f6b4f, transparent 70%); }
  .vidro-fundo i:nth-child(3) { width: 38vw; height: 38vw; bottom: -14vw; left: 24vw; background: radial-gradient(circle, color-mix(in srgb, var(--menta) 35%, #0a2a22), transparent 70%); opacity: 0.4; }

  .vidro, .topo, .troca, .cartao, .passo, .final li, .faq details, .frase, .selo-ok, .zap {
