---
// A vitrine: uma amostra dos modelos e dos estilos de cena do Hub, só com o nome.
// Usa os vídeos leves do guia (public/guia/, gerados por scripts/guia.sh) e os
// nomes de src/data/guia.js. Sem som, e cada vídeo só carrega e toca quando
// aparece na tela.
import { porId, cenas } from '../data/guia.js';

const modelos = ['autoridade', 'trailer', 'texto-e-objeto', 'especialista', 'pagina-de-livro', 'minidocumentario'].map(
  (id) => porId[id],
);
const porCena = Object.fromEntries(cenas.map((c) => [c.id, c]));
const estilos = ['cena41', 'cena42', 'cena46', 'cena15', 'cena11'].map((id) => porCena[id]);
---

<section class="secao vitrine" id="vitrine" aria-labelledby="vitrine-titulo">
  <div class="limite">
    <header class="vitrine__cabeca reveal">
      <p class="olho">Modelos e estilos</p>
      <h2 id="vitrine-titulo" class="vitrine__titulo">
        Um pouco mais do que <span class="destaque">sai daqui.</span>
      </h2>
    </header>

    <div class="faixa reveal">
      <p class="faixa__rotulo mono">Modelos de edição <span class="faixa__mais">(+19)</span></p>
      <ul class="grade grade--modelos" role="list">
        {modelos.map((m) => (
          <li class="card">
            <div class="card__tela">
              <video
                data-vitrine
                data-src={`/guia/modelos/${m.id}.mp4`}
                poster={`/guia/modelos/${m.id}.jpg`}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              ></video>
            </div>
            <p class="card__nome">{m.nome}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="faixa reveal">
      <p class="faixa__rotulo mono">Estilos de cena <span class="faixa__mais">(+46)</span></p>
      <ul class="grade grade--estilos" role="list">
        {estilos.map((c) => (
          <li class="card">
            <div class="card__tela card__tela--cena">
              <video
                data-vitrine
                data-src={`/guia/cenas/${c.id}.mp4`}
                poster={`/guia/cenas/${c.id}.jpg`}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              ></video>
            </div>
            <p class="card__nome">{c.nome}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .vitrine__cabeca {
    display: grid;
    justify-items: center;
    gap: var(--e-16);
    margin-bottom: clamp(28px, 4vw, 48px);
    text-align: center;
  }

  .vitrine__titulo {
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .faixa {
    display: grid;
    gap: var(--e-12);
    max-width: 1100px;
    margin: 0 auto;
  }

  .faixa + .faixa {
    margin-top: clamp(28px, 4vw, 44px);
  }

  .faixa__rotulo {
    margin: 0;
    color: var(--apoio);
    font-size: var(--t-legenda);
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Uma linha por faixa no computador; no celular, corre de lado. */
  .grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(10px, 1.4vw, 16px);
  }

  .grade--modelos {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .grade--estilos {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  /* Cada card é uma placa de vidro (o mesmo do guia), com o vídeo encaixado dentro. */
  .card {
    display: grid;
    gap: var(--e-8);
    min-width: 0;
    padding: 6px 6px 10px;
    border-radius: 22px;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02) 45%),
      rgba(14, 20, 18, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 20px 50px -24px rgba(0, 0, 0, 0.7);
  }

  .card__tela {
    aspect-ratio: 9 / 16;
    border-radius: 16px;
    overflow: hidden;
    background: var(--carvao);
  }

  .card__tela--cena {
    aspect-ratio: 4 / 5;
  }

  .card__tela video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__nome {
    margin: 0;
    font-size: var(--t-corpo-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: center;
  }

  /* No celular tudo desce em grade de 3, sem rolar de lado. Os 5 estilos ficam
     3 em cima e 2 centralizados embaixo. */
  @media (max-width: 760px) {
    .grade--modelos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .grade--estilos {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .grade--estilos .card {
      width: calc((100% - 2 * clamp(10px, 1.4vw, 16px)) / 3);
    }

    .card__nome {
      font-size: var(--t-legenda);
    }
  }
</style>

<script>
  // Cada vídeo carrega na primeira vez que aparece, toca enquanto está na tela
  // e para quando sai. Pra quem pede menos movimento, fica só a capa.
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const olho = new IntersectionObserver(
    (entradas) =>
      entradas.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (reduz) return;
          if (!v.src) v.src = v.dataset.src!;
          void v.play().catch(() => {});
        } else {
          v.pause();
        }
      }),
    { threshold: 0.25 },
  );
  document.querySelectorAll<HTMLVideoElement>('[data-vitrine]').forEach((v) => olho.observe(v));
</script>
