---
// O fluxo de verdade, simulado: a pessoa anexa a gravação (ou só descreve o
// vídeo) e pede no prompt, já dizendo o modelo; o Claude entrega. O passo 2
// toca o vídeo de verdade do modelo: a mesma fala de 30 s, editada por cada
// modelo (public/vitrine, gerado por scripts/vitrine.sh).
import { porId } from '../data/modelos.js';
const modelos = ['profissional01', 'superpodcast01', 'sofistmotion01'].map(
  (id) => porId[id],
);
const primeiro = modelos[0];

// Estilos de cena que entram no meio do vídeo (versão 9:16 em public/guia/cenas-916/).
const estilos = [
  { id: 'cena42', nome: 'Rabisco de nanquim' },
  { id: 'cena41', nome: 'Mapa em relevo' },
];

// Pedidos de exemplo: o ajuste é livre, estes só mostram o tom.
const pedidos = [
  'corta os silêncios',
  'deixa a legenda amarela',
  'põe o meu logo no canto',
  'corta o começo',
  'deixa o ritmo mais calmo',
];
---

<section class="secao fluxo" id="modelos" aria-labelledby="fluxo-titulo">
  <div class="limite">
    <header class="fluxo__cabeca reveal">
      <p class="olho">Modelos de edição</p>
      <h2 id="fluxo-titulo" class="fluxo__titulo">
        Você viu apenas <span class="destaque">alguns dos modelos</span> criados.
      </h2>
      <p class="fluxo__sub">
        O Hub ganha modelos novos o tempo todo.
      </p>
    </header>

    <div class="fluxo__palco reveal" data-fluxo data-pedidos={JSON.stringify(pedidos)}>
      {/* 1. O pedido: anexa a gravação (ou descreve) e diz o modelo no prompt */}
      <div class="passo">
        <p class="passo__n mono"><span>1</span>Você pede pro Claude</p>
        <div class="prompt">
          <span class="prompt__anexo mono">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6a2 2 0 0 1 2-2h8l6 6v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z M14 4v6h6" /><path d="m10 11 5 3-5 3Z" /></svg>
            gravacao-bruta.mp4
          </span>
          <p class="prompt__texto">
            <span data-prompt-texto>Edita esse vídeo no modelo <strong>{primeiro.nome}</strong> e {pedidos[0]}</span><span class="prompt__cursor" aria-hidden="true"></span>
          </p>
          <span class="prompt__barra" aria-hidden="true">
            <span class="prompt__mais">
              <svg viewBox="0 0 16 16" focusable="false"><path d="M8 3v10M3 8h10" /></svg>
            </span>
            <span class="prompt__marca mono">Claude</span>
            <span class="prompt__enviar">
              <svg viewBox="0 0 16 16" focusable="false"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
            </span>
          </span>
        </div>

        <ul class="escolha" role="list" aria-label="Exemplos de pedido">
          {modelos.map((m, i) => (
            <li>
              <button
                type="button"
                class="escolha__item"
                data-item
                data-umami-event="exemplo-prompt"
                data-umami-event-item={m.nome}
                data-nome={m.nome}
                data-src={`/vitrine/${m.id}.mp4`}
                data-poster={`/vitrine/${m.id}.webp`}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span>{m.nome}</span><span class="escolha__tipo mono">modelo</span>
              </button>
            </li>
          ))}
          {estilos.map((c) => (
            <li>
              <button
                type="button"
                class="escolha__item"
                data-item
                data-estilo
                data-umami-event="exemplo-prompt"
                data-umami-event-item={c.nome}
                data-nome={c.nome}
                data-src={`/guia/cenas-916/${c.id}.mp4`}
                data-poster={`/guia/cenas-916/${c.id}.webp`}
                aria-pressed="false"
              >
                <span>{c.nome}</span><span class="escolha__tipo escolha__tipo--estilo mono">estilo</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <span class="seta" aria-hidden="true"></span>

      {/* 2. O resultado: o vídeo de verdade, editado no modelo pedido */}
      <div class="passo">
        <p class="passo__n mono"><span>2</span>O Claude entrega o vídeo</p>
        <div class="saida">
          <div class="quadro quadro--saida">
            <video
              data-saida-video
              poster={`/vitrine/${primeiro.id}.webp`}
              muted
              loop
              playsinline
              preload="none"
              aria-label={`Vídeo editado no modelo ${primeiro.nome}`}
            >
              <source src={`/vitrine/${primeiro.id}.mp4`} type="video/mp4" />
            </video>
          </div>
          <p class="saida__nota mono" aria-live="polite">
            <span data-saida-nome>modelo {primeiro.nome}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fluxo {
    padding-top: clamp(8px, 2vw, 24px);
  }

  .fluxo__cabeca {
    display: grid;
    justify-items: center;
    gap: var(--e-16);
    max-width: 1120px;
    margin: 0 auto clamp(32px, 4vw, 48px);
    text-align: center;
  }

  .fluxo__titulo {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .destaque {
    color: var(--menta);
  }

  .fluxo__sub {
    max-width: 56ch;
    color: var(--tinta-suave);
    font-size: var(--t-corpo-lg);
    text-wrap: pretty;
  }

  /* ---------- o palco: o pedido, a seta e o vídeo pronto ---------- */
  .fluxo__palco {
    display: grid;
    gap: var(--e-16);
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(16px, 2.5vw, 28px);
    border-radius: var(--raio-card);
    background:
      radial-gradient(60% 80% at 50% 0%, var(--menta-veu), transparent 70%),
      var(--superficie);
    box-shadow: var(--anel);
  }

  @media (min-width: 960px) {
    .fluxo__palco {
      grid-template-columns: minmax(0, 1.15fr) 32px minmax(0, 1fr);
      align-items: center;
    }
  }

  .passo {
    display: grid;
    align-content: start;
    gap: var(--e-12);
    min-width: 0;
  }

  .passo__n {
    display: flex;
    align-items: center;
    gap: var(--e-8);
    margin: 0;
    font-size: var(--t-legenda);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .passo__n span {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--menta-veu);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--menta);
  }

  /* A seta: um fio menta com ponta. Deitada no computador, em pé no celular. */
  .seta {
    position: relative;
    justify-self: center;
    align-self: center;
    width: 1px;
    height: 24px;
    background: linear-gradient(to bottom, transparent, var(--menta));
  }

  .seta::after {
    content: '';
    position: absolute;
    left: -4px;
    bottom: -2px;
    border: 4.5px solid transparent;
    border-top-color: var(--menta);
    border-bottom-width: 0;
  }

  @media (min-width: 960px) {
    .seta {
      width: 100%;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--menta));
    }

    .seta::after {
      left: auto;
      right: -2px;
      bottom: -4px;
      border: 4.5px solid transparent;
      border-left-color: var(--menta);
      border-right-width: 0;
    }
  }

  /* ---------- 1. o prompt: a caixa onde a pessoa fala com o Claude ---------- */
  .prompt {
    display: grid;
    gap: var(--e-12);
    padding: var(--e-16);
    border-radius: 18px;
    background: var(--carvao);
    box-shadow:
      inset 0 0 0 1px var(--linha-forte),
      0 18px 40px -24px #000;
  }

  .prompt__anexo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--e-8);
    padding: 8px 12px 8px 10px;
    border-radius: 10px;
    background: var(--superficie);
    box-shadow: inset 0 0 0 1px var(--linha);
    font-size: var(--t-corpo-sm);
    color: var(--tinta);
  }

  .prompt__anexo svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--menta);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .prompt__texto {
    margin: 0;
    min-height: 3em;
    font-size: var(--t-corpo-lg);
    line-height: 1.45;
    color: var(--tinta);
    overflow-wrap: anywhere;
  }

  /* :global porque o negrito é recriado pelo script, sem a marca do Astro. */
  .prompt__texto :global(strong) {
    color: var(--menta);
    font-weight: var(--peso-medio);
  }

  .prompt__cursor {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 3px;
    vertical-align: -0.18em;
    background: var(--menta);
  }

  /* A barra de baixo, como no Claude: anexar à esquerda, enviar à direita. */
  .prompt__barra {
    display: flex;
    align-items: center;
    gap: var(--e-8);
  }

  .prompt__mais,
  .prompt__enviar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
  }

  .prompt__mais {
    box-shadow: inset 0 0 0 1px var(--linha-forte);
    color: var(--tinta-suave);
  }

  .prompt__enviar {
    background: #d97757;
    color: #1a0f0a;
  }

  .prompt__mais svg,
  .prompt__enviar svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .prompt__marca {
    margin-left: auto;
    font-size: var(--t-legenda);
    color: var(--apoio);
  }

  @media (prefers-reduced-motion: no-preference) {
    .prompt__cursor {
      animation: pisca-cursor 1s steps(2) infinite;
    }

    [data-prompt-texto] {
      transition: opacity 0.25s var(--curva);
    }

    .is-trocando {
      opacity: 0;
    }
  }

  @keyframes pisca-cursor {
    50% {
      opacity: 0;
    }
  }

  /* ---------- os modelos: etiquetas que trocam o vídeo ---------- */
  /* Uma lista em coluna: o nome à esquerda e o tipo (modelo ou estilo) à direita. */
  .escolha {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .escolha__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-12);
    width: 100%;
    min-height: 44px;
    padding: 8px 10px 8px 16px;
    border: 0;
    border-radius: 14px;
    text-align: left;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--linha);
    color: var(--tinta-suave);
    font: inherit;
    font-size: var(--t-corpo-sm);
    cursor: pointer;
    transition:
      background var(--micro) var(--curva),
      box-shadow var(--micro) var(--curva),
      color var(--micro) var(--curva);
  }

  .escolha__item:hover {
    color: var(--tinta);
    box-shadow: inset 0 0 0 1px var(--linha-forte);
  }

  .escolha__item:focus-visible {
    outline: 3px solid var(--menta-fundo);
    outline-offset: 2px;
  }

  .escolha__item[aria-pressed='true'] {
    background: var(--menta-tinge);
    box-shadow: inset 0 0 0 1px var(--menta-linha);
    color: var(--tinta);
    font-weight: var(--peso-medio);
  }

  .escolha__tipo {
    flex: none;
    padding: 3px 9px;
    border-radius: var(--raio-pilula);
    background: var(--menta-veu);
    color: var(--menta);
    font-size: var(--t-legenda);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .escolha__tipo--estilo {
    background: color-mix(in srgb, #d97757 16%, transparent);
    color: #e8957a;
  }

  /* ---------- 2. a saída: o vídeo do modelo pedido, tocando ---------- */
  .saida {
    display: grid;
    align-content: start;
    gap: var(--e-8);
  }

  .quadro {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    justify-self: center;
    height: 420px;
    border-radius: 12px;
    background: var(--carvao);
    box-shadow:
      0 0 0 1px var(--menta-linha),
      0 24px 50px -24px color-mix(in srgb, var(--menta) 45%, transparent);
  }

  .quadro video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 959px) {
    .quadro {
      height: min(420px, 110vw);
    }
  }

  .saida__nota {
    margin: 0;
    text-align: center;
    font-size: var(--t-legenda);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--menta);
  }
</style>

<script>
  // Troca sozinha a cada 6 s (modelos e estilos), enquanto a seção está na tela.
  // Para de vez quando a pessoa clica, e nem começa pra quem pede menos movimento.
  // O prompt muda junto: modelo + um pedido, ou o último modelo + o estilo numa cena.
  const raiz = document.querySelector<HTMLElement>('[data-fluxo]');
  if (raiz) {
    const botoes = [...raiz.querySelectorAll<HTMLButtonElement>('[data-item]')];
    const video = raiz.querySelector<HTMLVideoElement>('[data-saida-video]')!;
    const nome = raiz.querySelector<HTMLElement>('[data-saida-nome]')!;
    const texto = raiz.querySelector<HTMLElement>('[data-prompt-texto]')!;
    const fonte = video.querySelector('source')!;
    const pedidos = JSON.parse(raiz.dataset.pedidos || '[]');
    let atual = 0;
    let modelo = botoes[0].dataset.nome!;
    let parado = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visivel = false;

    // Monta a frase sem innerHTML: texto + nome em negrito.
    const escreve = (antes: string, destaque: string, depois: string) => {
      const forte = document.createElement('strong');
      forte.textContent = destaque;
      texto.replaceChildren(antes, forte, depois);
    };

    const mostrar = (i: number) => {
      atual = i;
      const b = botoes[i];
      const estilo = b.hasAttribute('data-estilo');
      const rotulo = b.dataset.nome!;
      if (!estilo) modelo = rotulo;
      botoes.forEach((x, k) => x.setAttribute('aria-pressed', String(k === i)));
      fonte.src = b.dataset.src!;
      video.poster = b.dataset.poster!;
      video.setAttribute('aria-label', `${estilo ? 'Cena no estilo' : 'Vídeo editado no modelo'} ${rotulo}`);
      nome.textContent = `${estilo ? 'estilo' : 'modelo'} ${rotulo}`;
      video.load();
      if (visivel) void video.play().catch(() => {});
      texto.classList.add('is-trocando');
      setTimeout(() => {
        if (estilo) escreve(`Edita no modelo ${modelo} e, na frase 2, usa o estilo `, rotulo, '');
        else escreve('Edita esse vídeo no modelo ', rotulo, ` e ${pedidos[i % pedidos.length]}`);
        texto.classList.remove('is-trocando');
      }, 250);
    };

    botoes.forEach((b, i) =>
      b.addEventListener('click', () => {
        parado = true;
        mostrar(i);
      }),
    );

    new IntersectionObserver(([e]) => {
      visivel = e.isIntersecting;
      if (visivel && !matchMedia('(prefers-reduced-motion: reduce)').matches) void video.play().catch(() => {});
      else video.pause();
    }).observe(raiz);

    setInterval(() => {
      if (parado || !visivel || document.hidden) return;
      mostrar((atual + 1) % botoes.length);
    }, 6000);
  }
</script>