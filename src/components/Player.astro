---
// O player do VKOSHUB em modo "gif": mudo, em loop, sem botão de play nem
// barra. Começa sozinho quando entra na tela e pausa quando sai, pra não
// gastar processador nem internet com vídeo que ninguém está vendo.
// Cada vídeo tem duas versões: AV1 (mais leve) e H.264 (pra navegador antigo).
// O navegador fica com a primeira que souber tocar.
// Quem pede menos movimento vê o poster parado e toca no botão se quiser.
// Sem JavaScript, o vídeo cai nos controles do navegador.
interface Props {
  src: string;
  poster?: string;
  rotulo?: string;
  /* Quando o pai não dá altura ao vídeo (ex.: "9 / 16"). */
  razao?: string;
}
const { src, poster, rotulo, razao } = Astro.props;
const av1 = src.replace(/\.mp4$/, '.av1.mp4');
---

<div class="player" data-player style={razao ? `aspect-ratio:${razao}` : undefined}>
  <video poster={poster} playsinline muted loop preload="none" aria-label={rotulo} controls>
    <source src={av1} type='video/mp4; codecs="av01.0.05M.08"' />
    <source src={src} type="video/mp4" />
  </video>

  <button class="player__botao" type="button" aria-label="Pausar o vídeo" hidden>
    <svg class="player__pausa" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
    <svg class="player__toca" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
  </button>
</div>

<style>
  .player {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--carvao);
    overflow: hidden;
  }

  .player video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--carvao);
  }

  /* O botão discreto no canto: aparece no hover, no foco do teclado e
     sempre que o vídeo está parado. É o jeito de pausar o loop. */
  .player__botao {
    position: absolute;
    right: var(--e-8);
    bottom: var(--e-8);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--raio-pilula);
    background: rgba(10, 10, 10, 0.62);
    color: var(--tinta);
    cursor: pointer;
    opacity: 0;
    backdrop-filter: blur(6px);
    transition:
      opacity var(--micro) var(--curva),
      background var(--micro) var(--curva);
  }

  .player:hover .player__botao,
  .player__botao:focus-visible,
  .player.is-parado .player__botao {
    opacity: 1;
  }

  .player__botao:hover {
    background: var(--menta-solida);
    color: var(--sobre-menta);
  }

  .player__botao:focus-visible {
    outline: 3px solid var(--menta-fundo);
    outline-offset: 2px;
  }

  .player__botao svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .player__toca,
  .player.is-parado .player__pausa {
    display: none;
  }

  .player.is-parado .player__toca {
    display: block;
  }

  /* Parado pela pessoa: o botão de play cresce no centro, pra ficar claro. */
  .player.is-parado .player__botao {
    right: 50%;
    bottom: 50%;
    translate: 50% 50%;
    width: 56px;
    height: 56px;
    background: var(--menta-solida);
    color: var(--sobre-menta);
  }

  .player.is-parado .player__botao svg {
    width: 24px;
    height: 24px;
    margin-left: 2px;
  }
</style>

<script>
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Toca quem está na tela, pausa quem saiu. A margem começa a carregar um
  // pouco antes do vídeo aparecer, pra ele já estar rodando quando chegar.
  const olheiro = new IntersectionObserver(
    (entradas) => {
      entradas.forEach(({ target, isIntersecting }) => {
        const raiz = target as HTMLElement;
        const video = raiz.querySelector('video') as HTMLVideoElement;
        if (isIntersecting && !raiz.classList.contains('is-parado')) {
          video.preload = 'auto';
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    },
    { rootMargin: '200px 0px' },
  );

  document.querySelectorAll<HTMLElement>('[data-player]').forEach((raiz) => {
    const video = raiz.querySelector('video') as HTMLVideoElement;
    const botao = raiz.querySelector('.player__botao') as HTMLButtonElement;

    // Com JavaScript, o modo gif assume e os controles do navegador saem.
    video.removeAttribute('controls');
    video.muted = true;
    botao.hidden = false;

    const parar = (sim: boolean) => {
      raiz.classList.toggle('is-parado', sim);
      botao.setAttribute('aria-label', sim ? 'Tocar o vídeo' : 'Pausar o vídeo');
      if (sim) {
        video.pause();
      } else {
        video.preload = 'auto';
        void video.play().catch(() => {});
      }
    };

    const alternar = () => parar(!raiz.classList.contains('is-parado'));
    botao.addEventListener('click', alternar);
    video.addEventListener('click', alternar);

    if (reduz) parar(true);
    olheiro.observe(raiz);
  });
</script>
