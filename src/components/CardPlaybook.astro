---
import CerebroIA from './CerebroIA.astro';

interface Props {
  slug: string;
  titulo: string;
  resumo: string;
  categoria: string;
  novo?: boolean;
  capa?: string;
  capaAlt?: string;
  /* Arte desenhada no lugar da foto. Hoje só 'cerebro', a mesma peça que
     abre a página do VKOS: o card e a página mostram a mesma imagem. */
  arte?: 'cerebro';
  /* 'desenvolvimento' = ainda não tem página. Veja playbooks.js. */
  estado?: string;
  /* Frase curta de status ao lado da categoria. Veja playbooks.js. */
  selo?: string;
}

const {
  slug,
  titulo,
  resumo,
  categoria,
  novo = false,
  capa,
  capaAlt = '',
  arte,
  estado,
  selo,
} = Astro.props;

/* Projeto em desenvolvimento não abre nada, então o card não é link: vira
   um bloco comum. Link que não leva a lugar nenhum, ou que abre uma página
   vazia, gasta o clique da pessoa à toa. */
const emObra = estado === 'desenvolvimento';
const Etiqueta = emObra ? 'div' : 'a';
---

{/* data-tema="claro" faz o card ser uma ilha clara dentro da página escura.
    Não é gambiarra nem paleta duplicada: os temas são blocos de token e o
    seletor vale em qualquer elemento, então tudo aqui dentro (texto, tag,
    borda, capa) herda o tema claro inteiro e continua conferido. */}
<Etiqueta
  class:list={['card', emObra && 'card--obra']}
  data-tema="claro"
  href={emObra ? undefined : `/ojessegomes/${slug}`}
>
  {
    arte === 'cerebro' ? (
      <span class="card__capa card__capa--arte" aria-hidden="true">
        <CerebroIA uid={`card-${slug}`} fundo={false} circuito={false} contraste />
        <span class="card__selo mono">
          <span class="card__ponto" />
          VKOSHUB
        </span>
      </span>
    ) : capa ? (
      <img
        class="card__capa"
        src={capa}
        alt={capaAlt}
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
      />
    ) : (
      /* Capa provisória. Não é foto nem ilustração fingindo ser conteúdo:
         é uma peça do próprio sistema segurando o espaço 16:9 até a arte
         real chegar. Basta pôr `capa` no playbooks.js pra ela sumir. */
      <span class="card__capa card__capa--vazia" aria-hidden="true">
        <span class="card__textura"></span>
        <span class="card__selo mono">
          <span class="card__ponto"></span>
          VKOSHUB
        </span>
      </span>
    )
  }

  <span class="card__corpo">
    <span class="card__topo">
      <span class="tag mono">{categoria}</span>
      {novo && <span class="pilula">Novo</span>}
      {selo && (
        <span class:list={['pilula', 'mono', emObra ? 'pilula--obra' : 'pilula--vivo']}>
          {selo}
        </span>
      )}
    </span>

    <span class="card__titulo">
      {titulo}
      {/* A seta é a promessa de que o card abre algo. Em obra ela não vem. */}
      {!emObra && (
        <svg class="card__seta" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M7 17 17 7M9 7h8v8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )}
    </span>
    <span class="card__resumo">{resumo}</span>
  </span>
</Etiqueta>

<style>
  /* Sobre a grade pontilhada o card precisa flutuar, não afundar.
     Por isso ele é mais claro que a página e ganha uma sombra só,
     larga e rasa. Sombra empilhada aqui vira plástico. */
  /* A elevação NÃO mora aqui. Ela é relativa ao que está atrás do card,
     e o que está atrás é a página, não o tema de dentro dele. Quem aplica
     a sombra é o item da grade, que vive no tema da página. */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--papel);
    border-radius: var(--raio-card);
    text-decoration: none;
    color: var(--tinta);
    overflow: hidden;
  }

  /* Em obra o card fica um degrau mais quieto que os outros: ele está na
     lista pra avisar que existe, não pra puxar o clique. */
  .card--obra {
    background: var(--superficie);
  }

  /* A mídia vai rente às bordas do card, sem moldura interna.
     O aspect-ratio reserva o espaço, então a página não pula. */
  .card__capa {
    display: block;
    width: 100%;
    /* height:auto é obrigatório. O <img> traz width e height como atributo
       (que evitam o pulo do layout), e com as duas dimensões fixas o
       aspect-ratio é ignorado, porque ele só calcula a que falta. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--carvao);
  }

  .card__capa--vazia,
  .card__capa--arte {
    position: relative;
    overflow: hidden;
  }

  .card__textura {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--ponto-capa) 1.2px, transparent 1.2px);
    background-size: 13px 13px;
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 40%, #000, transparent);
    mask-image: radial-gradient(ellipse 80% 80% at 50% 40%, #000, transparent);
  }

  .card__selo {
    position: absolute;
    left: var(--e-20);
    bottom: var(--e-16);
    display: inline-flex;
    align-items: center;
    gap: var(--e-8);
    font-size: var(--t-legenda);
    color: var(--sobre-painel);
  }

  .card__ponto {
    width: 7px;
    height: 7px;
    border-radius: var(--raio-pilula);
    background: var(--menta);
  }

  .card__corpo {
    display: flex;
    flex-direction: column;
    gap: var(--e-12);
    flex: 1;
    padding: var(--e-24) var(--e-32) var(--e-32);
  }

  .card__topo {
    display: flex;
    align-items: center;
    gap: var(--e-8);
    flex-wrap: wrap;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    color: var(--apoio);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-pilula);
    padding: 2px var(--e-8);
    font-size: var(--t-legenda);
  }

  .pilula {
    display: inline-flex;
    align-items: center;
    background: var(--lavagem);
    color: var(--tinta);
    border-radius: var(--raio-pilula);
    padding: 2px var(--e-12);
    font-size: var(--t-legenda);
    font-weight: var(--peso-medio);
  }

  .pilula--obra,
  .pilula--vivo {
    background: transparent;
    font-size: var(--t-legenda);
    font-weight: var(--peso-normal);
  }

  /* Em obra o selo é cinza: ele informa, não celebra. */
  .pilula--obra {
    border: 1px solid var(--linha-forte);
    color: var(--apoio);
  }

  /* Projeto vivo leva a menta. No card claro quem escreve é a --menta-fundo,
     porque a menta pura sobre claro dá 1.45:1 e não passa como texto. */
  .pilula--vivo {
    border: 1px solid color-mix(in srgb, var(--menta-fundo) 45%, transparent);
    color: var(--menta-fundo);
  }

  .card__titulo {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--e-12);
    font-family: var(--fonte-display);
    font-size: var(--t-titulo-sm);
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
    margin-top: var(--e-4);
  }

  /* A seta é o único sinal de que o card abre algo. Nasce apagada e
     recuada, e o hover do card inteiro (não só dela) a traz à tona:
     assim a pista aparece antes do cursor chegar perto do ícone. */
  .card__seta {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--apoio);
    opacity: 0.5;
    transform: translate(-2px, 2px);
    transition:
      opacity var(--micro) var(--curva),
      transform var(--micro) var(--curva),
      color var(--micro) var(--curva);
  }

  .card:hover .card__seta,
  .card:focus-visible .card__seta {
    opacity: 1;
    color: var(--tinta);
    transform: translate(0, 0);
  }

  .card__resumo {
    font-size: var(--t-corpo-sm);
    color: var(--apoio);
    line-height: var(--altura-corpo);
    text-wrap: pretty;
  }

  .mono {
    font-family: var(--fonte-mono);
    letter-spacing: -0.01em;
  }
</style>
