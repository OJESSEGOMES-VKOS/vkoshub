---
// A barra do Hub: uma pílula flutuante, solta do topo. Marca à esquerda,
// as duas páginas no meio e a entrada à direita.
import { checkoutAnual } from '../data/checkout.js';

const aqui = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', rotulo: 'VKOSHUB' },
  { href: '/maquina-de-conteudo', rotulo: 'Máquina de Conteúdo' },
];
---

<header class="barra" data-barra>
  <div class="barra__interno">
    <p class="marca">
      <a class="marca__link" href="/" aria-label="VKOSHUB, início">
        <img class="marca__logo" src="/logo.png" alt="" width="40" height="40" />
        <span class="marca__nome">VKOS<span class="marca__hub">HUB</span></span>
      </a>
    </p>

    <nav class="nav" aria-label="Páginas">
      <ul class="nav__lista" role="list">
        {links.map((l) => (
          <li>
            <a class="nav__link" href={l.href} aria-current={aqui === l.href ? 'page' : undefined}>
              {l.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="entrar" href={checkoutAnual}>
      <span class="entrar__longo">Entrar no VKOSHUB</span><span class="entrar__curto">Entrar</span>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    padding: 12px clamp(12px, 3vw, 24px) 0;
    pointer-events: none;
  }

  .barra__interno {
    pointer-events: auto;
    max-width: var(--largura-max);
    margin-inline: auto;
    padding: 6px 6px 6px clamp(14px, 2vw, 22px);
    min-height: var(--altura-barra);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-16);
    border-radius: var(--raio-pilula);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tinta) 4%, transparent), transparent),
      color-mix(in srgb, var(--pagina) 80%, transparent);
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--menta) 16%, transparent),
      0 16px 40px -24px rgba(0, 0, 0, 0.9);
    transition: box-shadow var(--micro) var(--curva);
  }

  .barra.rolada .barra__interno {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--menta) 26%, transparent),
      0 18px 44px -18px rgba(0, 0, 0, 0.95);
  }

  .marca {
    margin: 0;
    min-width: 0;
  }

  .marca__link {
    display: inline-flex;
    align-items: center;
    gap: var(--e-12);
    min-height: 44px;
    text-decoration: none;
  }

  .marca__logo {
    display: block;
    width: 34px;
    height: 34px;
  }

  .marca__nome {
    font-family: var(--fonte-display);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--tinta);
  }

  .marca__hub {
    color: var(--menta);
  }

  .nav__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--e-4, 4px);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--raio-pilula);
    color: var(--tinta-suave);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--micro) var(--curva),
      background var(--micro) var(--curva);
  }

  .nav__link:hover {
    color: var(--tinta);
  }

  .nav__link[aria-current='page'] {
    color: var(--tinta);
    background: color-mix(in srgb, var(--tinta) 7%, transparent);
  }

  .entrar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--raio-pilula);
    background: var(--menta);
    color: #06140e;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--menta) 70%, transparent);
    transition:
      transform var(--micro) var(--curva),
      box-shadow var(--micro) var(--curva);
  }

  .entrar:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 28px -10px color-mix(in srgb, var(--menta) 80%, transparent);
  }

  .entrar svg {
    width: 16px;
    height: 16px;
  }

  .entrar__curto {
    display: none;
  }

  /* No celular: só o símbolo da marca, links menores e o botão curto. */
  @media (max-width: 760px) {
    .barra__interno {
      gap: var(--e-8);
      padding-left: 10px;
    }

    .marca__nome {
      display: none;
    }

    .nav__link {
      padding: 0 10px;
      font-size: 0.8125rem;
    }

    .entrar {
      padding: 0 16px;
      min-height: 44px;
    }

    .entrar__longo {
      display: none;
    }

    .entrar__curto {
      display: inline;
    }
  }

  @media (max-width: 380px) {
    .nav__link {
      padding: 0 8px;
      font-size: 0.75rem;
    }

    .entrar svg {
      display: none;
    }
  }
</style>
