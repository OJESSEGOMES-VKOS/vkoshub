---
// A barra do Hub: uma pílula flutuante, solta do topo. Marca à esquerda;
// à direita, o link das Free Skills e a entrada.
import { checkoutAnual } from '../data/checkout.js';

interface Props {
  /* Só a página inicial leva o botão pro checkout. Nas outras ele volta pra home. */
  checkout?: boolean;
}
const { checkout = false } = Astro.props;
const href = checkout ? checkoutAnual : '/';
const evento = checkout ? 'checkout' : 'entrar-home';

// Onde a pessoa está: o link dessa página fica aceso.
const rota = Astro.url.pathname;
const onde = rota === '/' ? 'editos' : rota.startsWith('/free-skills') ? 'free skills' : null;
---

<header class="barra" data-barra>
  <div class="barra__interno">
    <p class="marca">
      <a class="marca__link" href="/" aria-label="VKOSHUB, início">
        <img class="marca__logo" src="/logo.png" alt="" width="40" height="40" />
        <span class="marca__nome">VKOS<span class="marca__hub">HUB</span></span>
        {onde === 'editos' && <span class="marca__onde">/ EditOS</span>}
      </a>
    </p>

    <nav class="links" aria-label="Principal">
      <a class="skills skills--editos" href="/" aria-current={onde === 'editos' ? 'page' : undefined} data-umami-event="ver-editos" data-umami-event-local="topo">EditOS</a>
      <a class="skills" href="/free-skills" aria-current={onde === 'free skills' ? 'page' : undefined} data-umami-event="free-skills" data-umami-event-local="topo">Free skills</a>
    </nav>

    <a class="entrar" href={href} data-umami-event={evento} data-umami-event-local="topo">
      <span class="entrar__longo">{checkout ? 'Entrar no VKOSHUB' : 'Conhecer o VKOSHUB'}</span><span class="entrar__curto">{checkout ? 'Entrar' : 'Conhecer'}</span>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    padding: 12px clamp(12px, 3vw, 24px) 0;
    pointer-events: none;
  }

  .barra__interno {
    pointer-events: auto;
    max-width: var(--largura-max);
    margin-inline: auto;
    padding: 6px 6px 6px clamp(14px, 2vw, 22px);
    min-height: var(--altura-barra);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-16);
    border-radius: var(--raio-pilula);
    /* Vidro (liquid glass): translúcido, desfoque com saturação e fio de luz em cima. */
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.025));
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 20px 50px -24px rgba(0, 0, 0, 0.7);
    transition: box-shadow var(--micro) var(--curva);
  }

  .barra.rolada .barra__interno {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.26),
      inset 0 0 0 1px rgba(255, 255, 255, 0.11),
      0 22px 54px -20px rgba(0, 0, 0, 0.85);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .barra__interno {
      background: rgba(22, 28, 26, 0.92);
    }
  }

  .marca {
    margin: 0;
    min-width: 0;
  }

  .marca__link {
    display: inline-flex;
    align-items: center;
    gap: var(--e-12);
    min-height: 44px;
    text-decoration: none;
  }

  .marca__logo {
    display: block;
    width: 34px;
    height: 34px;
  }

  .marca__nome {
    font-family: var(--fonte-display);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--tinta);
  }

  .marca__hub {
    color: var(--menta);
  }

  /* O link das Free Skills: empurra a si e a entrada pra direita. */
  .skills {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 18px;
    border-radius: var(--raio-pilula);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    color: var(--tinta);
    font-family: var(--fonte-corpo, inherit);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: none;
    white-space: nowrap;
    transition: background var(--micro) var(--curva), color var(--micro) var(--curva);
  }

  /* "/ EditOS" depois da marca, na página do EditOS (a principal). */
  .marca__onde {
    margin-left: -4px;
    color: var(--tinta-suave);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .marca__onde {
      margin-left: 0;
    }
  }

  @media (max-width: 400px) {
    .marca__onde {
      font-size: 0.875rem;
    }
  }

  /* Os links no meio exato da barra. No celular voltam pro lado do botão. */
  .barra__interno {
    position: relative;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--e-8);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .skills[aria-current='page'] {
    color: var(--menta);
  }

  /* O EditOS some no celular, onde a barra aperta. */
  .skills--editos::before {
    display: none;
  }

  @media (max-width: 760px) {
    .links {
      position: static;
      transform: none;
      margin-left: auto;
    }

    .skills--editos {
      display: none;
    }
  }

  .skills::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--menta);
  }

  .skills:hover {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.07));
    color: var(--menta);
  }

  .skills:focus-visible {
    outline: 2px solid var(--menta);
    outline-offset: 2px;
  }

  .entrar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--raio-pilula);
    background: var(--menta);
    color: #06140e;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--menta) 70%, transparent);
    transition:
      transform var(--micro) var(--curva),
      box-shadow var(--micro) var(--curva);
  }

  .entrar:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 28px -10px color-mix(in srgb, var(--menta) 80%, transparent);
  }

  .entrar svg {
    width: 16px;
    height: 16px;
  }

  .entrar__curto {
    display: none;
  }

  /* No celular: a marca completa e o botão curto. */
  @media (max-width: 760px) {
    .barra__interno {
      gap: var(--e-8);
      padding-left: 10px;
    }

    .entrar {
      padding: 0 16px;
      min-height: 44px;
    }

    .skills {
      padding: 0 14px;
      min-height: 44px;
    }

    .entrar__longo {
      display: none;
    }

    .entrar__curto {
      display: inline;
    }
  }

  @media (max-width: 480px) {
    .marca__nome {
      font-size: 1.125rem;
    }

    .marca__logo {
      width: 30px;
      height: 30px;
    }

    .entrar svg {
      display: none;
    }

    .marca__link {
      gap: var(--e-8);
    }

    .skills {
      padding: 0 12px;
      font-size: 0.875rem;
    }
  }

  /* Telas bem estreitas: "Conhecer" é mais largo que "Entrar", então a barra aperta. */
  @media (max-width: 400px) {
    .barra__interno {
      gap: 4px;
      padding-left: 8px;
    }

    .marca__link {
      gap: 6px;
    }

    .marca__logo {
      width: 26px;
      height: 26px;
    }

    .marca__nome {
      font-size: 1rem;
    }

    .skills {
      gap: 5px;
      padding: 0 9px;
      font-size: 0.8125rem;
    }

    .skills::before {
      width: 5px;
      height: 5px;
    }

    .entrar {
      padding: 0 12px;
      font-size: 0.875rem;
    }
  }
</style>
