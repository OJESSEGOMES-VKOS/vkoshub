---
// A barra do Hub. Só a marca: a página leva sozinha até o preço.
---

<header class="barra" data-barra>
  <div class="barra__interno">
    <p class="marca">
      <a class="marca__link" href="/">
        <img class="marca__logo" src="/logo.png" alt="" width="40" height="40" />
        <span class="marca__nome">VKOS<span class="marca__hub">HUB</span></span>
      </a>
    </p>
  </div>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: color-mix(in srgb, var(--pagina) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--micro) var(--curva),
      box-shadow var(--micro) var(--curva);
  }

  .barra.rolada {
    border-bottom-color: var(--linha);
    box-shadow: var(--elevacao-barra);
  }

  .barra__interno {
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: clamp(16px, 5vw, 40px);
    min-height: var(--altura-barra);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-16);
  }

  .marca {
    margin: 0;
    min-width: 0;
  }

  .marca__link {
    display: inline-flex;
    align-items: center;
    gap: var(--e-12);
    min-height: 56px;
    text-decoration: none;
  }

  .marca__logo {
    display: block;
    width: 40px;
    height: 40px;
  }

  /* O nome: grande, pesado e apertado. "HUB" acende em menta. */
  .marca__nome {
    font-family: var(--fonte-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--tinta);
  }

  .marca__hub {
    color: var(--menta);
  }
</style>
