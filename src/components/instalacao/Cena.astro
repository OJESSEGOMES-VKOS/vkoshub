---
// Uma "tela animada": a recriação fiel de um passo da instalação, em loop, como
// um GIF, só que nítida em qualquer tela e leve. O roteiro de cada cena mora no
// script da página (ROTEIROS[id]). Quem prefere menos movimento vê a cena parada
// no quadro final. Para quando sai da tela e tem botão de pausar (WCAG 2.2.2).
interface Props {
  id: string;
  legenda: string;
}
const { id, legenda } = Astro.props;
---

<figure class="cena" data-cena={id}>
  <div class="cena__tela">
    <div class="palco" aria-hidden="true">
      <slot />
      <svg class="cursor" data-k="cursor" viewBox="0 0 24 24" width="22" height="22">
        <path d="M4 2.5v17.2l4.6-4.3 2.9 6.6 2.9-1.3-2.9-6.5h6.3z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round" />
      </svg>
      <span class="clique" data-k="clique"></span>
    </div>
  </div>
  <figcaption class="cena__legenda">
    <span>{legenda}</span>
    <button type="button" class="cena__pausa" data-pausa aria-pressed="false">Pausar</button>
  </figcaption>
</figure>
