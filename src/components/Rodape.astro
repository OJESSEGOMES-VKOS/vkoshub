---
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="rodape__interno">
    <p class="rodape__marca">
      <span class="rodape__ponto" aria-hidden="true"></span>
      VKOSHUB, um produto
      <a href="https://www.instagram.com/ojessegomes/" target="_blank" rel="noopener noreferrer">@OJESSEGOMES</a>
    </p>
    <nav class="rodape__links" aria-label="Rodapé">
      <a href="mailto:contact@vkoshub.com">contact@vkoshub.com</a>
      <a href="/privacidade">Privacidade</a>
      <span>© {ano} VKOSHUB</span>
    </nav>
  </div>
</footer>

<style>
  .rodape {
    background: var(--carvao);
    color: var(--sobre-painel);
    padding-block: var(--e-32);
    border-top: 1px solid var(--linha);
  }

  .rodape__interno {
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: clamp(16px, 5vw, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-8) var(--e-32);
    justify-content: space-between;
    align-items: center;
  }

  .rodape__marca {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--e-8);
    font-size: var(--t-corpo-sm);
    color: var(--apoio-painel);
  }

  .rodape__ponto {
    width: 7px;
    height: 7px;
    border-radius: var(--raio-pilula);
    background: var(--menta-solida);
  }

  .rodape__links {
    display: flex;
    align-items: center;
    gap: var(--e-16);
    font-size: var(--t-corpo-sm);
    color: var(--apoio-painel);
  }

  .rodape a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--sobre-painel);
    text-decoration-color: var(--menta);
    text-underline-offset: 5px;
  }

  .rodape a:focus-visible {
    outline-color: var(--menta);
  }
</style>
